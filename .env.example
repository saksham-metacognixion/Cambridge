# Copy to .env (Astro build) and .dev.vars (Cloudflare Pages Functions, `wrangler pages dev`).
# In production set these in the Cloudflare Pages project settings. Never commit real values.

# --- Build time (public, ends up in the HTML) ---
# Cloudflare Turnstile site key. Leave empty to build without the widget.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Server side (Pages Functions only) ---
TURNSTILE_SECRET_KEY=
# Email adapter until Pramod decides: resend | postmark | sendgrid | none (none = local dev, sends nothing)
EMAIL_PROVIDER=none
EMAIL_API_KEY=
MAIL_FROM="Cambridge Hospital Website <no-reply@example.com>"
# Inbox per form and region (JSON on one line). Forms: book-appointment, send-enquiry, refer-patient, feedback
FORM_RECIPIENTS={"send-enquiry":{"global":"inbox@example.com","ae":"inbox-ae@example.com","sa":"inbox-sa@example.com"}}
# Optional: extra origins allowed to post (comma-separated). Defaults to the site's own origin.
ALLOWED_ORIGINS=
