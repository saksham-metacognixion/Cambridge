# Copy to .env (Astro build) and .dev.vars (Cloudflare Pages Functions, `wrangler pages dev`).
# In production set these in the Cloudflare Pages project settings. Never commit real values.

# --- Build time (public, ends up in the HTML) ---
# Cloudflare Turnstile site key. Leave empty to build without the widget.
# Local testing: Cloudflare's always-pass test pair is 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=
# Staging only: "true" shows a small "Content pending" note on condition detail pages generated from the card text
# (no full content from Pramod yet). Leave unset in production; it is also ignored whenever INDEXABLE is true.
PUBLIC_SHOW_PENDING_NOTE=

# --- Server side (Pages Functions only) ---
TURNSTILE_SECRET_KEY=
# Email adapter until Pramod decides: resend | postmark | sendgrid | none (none = local dev, sends nothing)
EMAIL_PROVIDER=none
EMAIL_API_KEY=
MAIL_FROM="Cambridge Hospital Website <no-reply@example.com>"
# Inbox per form type, one variable each. Value: "a@x, b@x" (all regions) or JSON {"global":"…","ae":"…","sa":"…"} on one line.
#   BOOK_APPOINTMENT = Book an Appointment pop-up | SEND_ENQUIRY = Contact page + Send an Inquiry pop-up
#   FEEDBACK = Your Opinion Matters pop-up + page | REFER_PATIENT = Refer a Patient page (three tabs: For Healthcare
#   Professionals 'refer-patient', For You, Family or friends 'refer-patient-other', For Corporate or Organisations 'refer-patient-corporate')
FORM_TO_BOOK_APPOINTMENT=appointments@example.com
FORM_TO_SEND_ENQUIRY={"global":"inbox@example.com","ae":"inbox-ae@example.com","sa":"inbox-sa@example.com"}
FORM_TO_FEEDBACK=feedback@example.com
FORM_TO_REFER_PATIENT=referrals@example.com
# International Patients inquiry form (5th form, not in the scope's list): its own variable name, same value format.
INTERNATIONAL_INBOX=international@example.com
# Optional: extra origins allowed to post (comma-separated). Defaults to the site's own origin.
ALLOWED_ORIGINS=
