# Settings of the dashboard's admin service on the Azure VM. deploy/vm/setup.sh copies this to /etc/cambridge-admin.env
# (root only); fill it in there, then `sudo systemctl restart cambridge-admin`. Meaning of each variable: .env.example.
# systemd reads this file: one VAR=value per line, no quotes needed (the hash's "$" signs are safe here).

# The one superadmin. Hash from: node tools/admin/hash-password.mjs 'the password'  (the password itself is never stored).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Where "View on site" links point.
ADMIN_SITE_URL=https://cambridgehospital.com
# Build-time keys, the same values as the GitHub Actions variables (deploy/vm/README.md), so a dashboard publish builds
# the same site as a GitHub deploy.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_GOOGLE_MAPS_KEY=
# Optional: nightly backup (deploy/vm/backup.sh) also uploads to this Azure Blob container when azcopy is installed.
# A container SAS URL with write permission, e.g. https://<account>.blob.core.windows.net/<container>?<sas>
AZURE_BACKUP_SAS_URL=
