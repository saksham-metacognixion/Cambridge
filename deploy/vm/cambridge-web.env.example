# Run-time settings of the site on the Azure VM. deploy/vm/setup.sh copies this to /etc/cambridge-web.env (root only);
# fill it in there, then `sudo systemctl restart cambridge-web`. Meaning of each variable: .env.example.
# systemd reads this file: one VAR=value per line; a JSON inbox map stays on one line (single quotes around it are fine).
# The PUBLIC_* keys are not here: they are build time (GitHub Actions variables, deploy/vm/README.md).

EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
TURNSTILE_SECRET_KEY=

FORM_TO_BOOK_APPOINTMENT=
FORM_TO_SEND_ENQUIRY=
FORM_TO_FEEDBACK=
FORM_TO_REFER_PATIENT=
FORM_TO_NEWSLETTER=
INTERNATIONAL_INBOX=
# Example of a per-region inbox map:
# FORM_TO_SEND_ENQUIRY='{"global":"inbox@example.com","ae":"inbox-ae@example.com","sa":"inbox-sa@example.com"}'
