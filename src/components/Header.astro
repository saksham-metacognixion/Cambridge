---
import logo from '../assets/header/logo.svg';
import line1 from '../assets/header/line1.svg';
import line2 from '../assets/header/line2.svg';
import vector from '../assets/header/vector.svg';

const topLinks = [
  { label: 'Your Opinion Matters', href: '#your-opinion', l: 408, w: 96 },
  { label: 'Media Hub', href: '#', l: 532, w: 49 },
  { label: 'Careers', href: '#', l: 607, w: 36 },
  { label: 'Knowledge Center', href: '#', l: 669, w: 85 },
  { label: 'FAQs', href: '#', l: 780, w: 27 },
];
const mainLinks = [
  { label: 'About Cambridge', w: 84 },
  { label: 'Our Care', w: 41 },
  { label: 'Patient Hub', w: 54 },
  { label: 'Our Hospitals', w: 62 },
  { label: 'Contact Us', w: 51 },
];
const vlines = [ [916, 69], [828, 25], [916, 25], [515, 25] ];
---

<header class="hd relative z-50 bg-white shadow-bar font-gotham">
  <input type="checkbox" id="nav-toggle" class="sr-only" aria-label="Toggle navigation menu" />
  <div class="stage" style="--h: 119">
    <a href="#" class="logo a" style="--l:41;--t:47;--w:252;--ph:45" aria-label="Cambridge Hospital home">
      <img src={logo.src} width="252" height="45" alt="Cambridge Hospital" class="block h-auto w-full" />
    </a>

    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>

    <nav class="menu" aria-label="Main">
      <img class="a deco" style="--l:394;--t:32;--w:10;--ph:10" src={vector.src} width="10" height="10" alt="" />
      <ul class="toplinks">
        {topLinks.map((x) => (
          <li class="a" style={`--l:${x.l};--t:33;--w:${x.w};--ph:15`}>
            <a href={x.href} class="block whitespace-nowrap text-f9 font-normal not-italic text-cyan">{x.label}</a>
          </li>
        ))}
      </ul>

      <div class="chip a" style="--l:846;--t:26;--w:47;--ph:25"></div>
      <div class="pill a" style="--l:849;--t:30;--w:22;--ph:18"></div>
      <ul class="lang">
        <li class="a" style="--l:854;--t:35;--w:15;--ph:15"><a href="#" lang="en" class="block text-f9 font-normal not-italic text-white">EN</a></li>
        <li class="a" style="--l:874;--t:35;--w:17;--ph:15"><a href="#" lang="ar" class="block text-f9 font-medium not-italic text-navy">AR</a></li>
      </ul>

      <a href="#" class="global a block whitespace-nowrap text-f9 font-medium not-italic text-navy" style="--l:932;--t:33;--w:38;--ph:15">Global</a>
      <!-- TODO(figma): 112:13401 keyboard_arrow_down (18x18 @966,28) glyph missing (figma-cache/chevron-down.svg not exported). Empty slot on purpose. -->
      <span class="chev a deco" style="--l:966;--t:28;--w:18;--ph:18" aria-hidden="true"></span>

      <p class="visit a text-f9 not-italic text-navy" style="--l:932;--t:71;--w:111;--ph:32"><span class="font-normal">Visit</span><br /><span class="font-medium">Cambridge<br />Health Group</span></p>

      <ul class="mainnav a" style="--l:393;--t:81;--w:595;--ph:15">
        {mainLinks.map((x) => (
          <li style={`--w:${x.w}`}><a href="#" class="block whitespace-nowrap text-f9 font-medium not-italic text-navy">{x.label}</a></li>
        ))}
      </ul>

      <a href="#book-appointment" class="book a" style="--l:755;--t:69;--w:138;--ph:30" aria-label="Book an appointment"></a>
      <span class="booklabel a text-f9 font-medium not-italic text-off-white" style="--l:766;--t:80;--w:118;--ph:15" aria-hidden="true">BOOK AN APPOINTMENT</span>

      {vlines.map(([l, t]) => (
        <span class="vl a deco" style={`--l:${l};--t:${t};--w:0;--ph:30`}><img src={line1.src} width="30" height="1" alt="" /></span>
      ))}
      <img class="a deco" style="--l:393;--t:55;--w:595;--ph:1" src={line2.src} width="595" height="1" alt="" />
    </nav>
  </div>
</header>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .chip { background: #ededed; border-radius: calc(5 * var(--u)); }
  .pill { background: #00415a; border-radius: calc(5 * var(--u)); }
  .book { background: #00b8ff; border-radius: calc(7 * var(--u)); }
  .booklabel { pointer-events: none; }
  .vl > img { position: absolute; left: 0; top: calc(30 * var(--u)); width: calc(30 * var(--u)); height: calc(1 * var(--u)); transform-origin: 0 0; transform: rotate(-90deg); max-width: none; }
  .hd ul { margin: 0; padding: 0; list-style: none; }
  .mainnav { display: flex; gap: calc(11 * var(--u)); }
  .mainnav li { width: calc(var(--w) * var(--u)); height: calc(15 * var(--u)); }
  .burger { display: none; }

  @media (min-width: 1024px) {
    .a { position: absolute; left: calc(var(--l) * var(--u)); top: calc(var(--t) * var(--u)); width: calc(var(--w) * var(--u)); height: calc(var(--ph) * var(--u)); }
    .menu, .toplinks, .lang { display: contents; }
    .visit, .global, .booklabel { margin: 0; }
    .book { display: block; }
    .logo img { height: 100%; }
  }

  @media (max-width: 1023.98px) {
    .stage { display: flex; align-items: center; justify-content: space-between; gap: calc(12 * var(--u)); padding: calc(15 * var(--u)) 16px; box-sizing: border-box; }
    .logo { display: block; width: calc(252 * var(--u)); max-width: calc(100% - 60px); flex: 0 1 auto; }
    .burger { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; align-items: center; cursor: pointer; flex: none; }
    .burger span { display: block; width: 26px; height: 3px; border-radius: 2px; background: #004059; transition: transform .2s, opacity .2s; }
    #nav-toggle:checked ~ .stage .burger span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    #nav-toggle:checked ~ .stage .burger span:nth-child(2) { opacity: 0; }
    #nav-toggle:checked ~ .stage .burger span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
    #nav-toggle:focus-visible ~ .stage .burger { outline: 2px solid #00b8ff; outline-offset: 2px; }

    .menu { display: none; position: absolute; left: 0; right: 0; top: 100%; background: #fff; box-shadow: 0 calc(4 * var(--u)) calc(4 * var(--u)) rgba(0,0,0,.06); padding: calc(16 * var(--u)) 16px calc(24 * var(--u)); flex-direction: column; align-items: flex-start; gap: calc(14 * var(--u)); box-sizing: border-box; max-height: calc(100vh - 80px); overflow-y: auto; }
    #nav-toggle:checked ~ .stage .menu { display: flex; }
    .deco, .chip, .pill, .chev, .booklabel { display: none; }
    .toplinks, .mainnav { display: flex; flex-direction: column; gap: calc(12 * var(--u)); }
    .mainnav li { width: auto; height: auto; }
    .lang { display: flex; gap: calc(12 * var(--u)); }
    .lang li:first-child a { background: #00415a; border-radius: calc(5 * var(--u)); padding: calc(2 * var(--u)) calc(6 * var(--u)); }
    .lang li:last-child a { background: #ededed; border-radius: calc(5 * var(--u)); padding: calc(2 * var(--u)) calc(6 * var(--u)); }
    .book { position: static; display: flex; align-items: center; justify-content: center; width: calc(138 * var(--u)); height: calc(30 * var(--u)); }
    .book::after { content: "BOOK AN APPOINTMENT"; font-size: calc(9 * var(--u)); font-weight: 500; color: #fffdfd; white-space: nowrap; }
    .book { width: calc(158 * var(--u)); }
    .visit { margin: 0; }
  }
</style>
