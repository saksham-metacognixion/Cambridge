---
import line1 from '../assets/header/line1.svg';
import line2 from '../assets/header/line2.svg';
import vector from '../assets/header/vector.svg';
import { parsePath, getEdition, urlFor, type RegionId } from '../lib/editions';
import { pagePath } from '../lib/paths';
import { content } from '../lib/content';
import { img } from '../lib/images';
import { weAreListeningHref, headerSubmenu, type MainLinkSource, type NavItem } from '../lib/nav';
import { switchHref } from '../lib/routes';

// Current edition and page path, so the language switch lands on the same page in the other language (or the nearest
// page that exists there, src/lib/routes.ts switchHref: never a 404).
const { edition, path } = parsePath(Astro.url.pathname);
const homeHref = urlFor(edition);
const c = content('layout/header', edition.locale);
const logo = img(c.logo.image, edition.region);

// Design (positions/widths) zipped by index with the links from layout/header JSON.
// Figma top-row boxes. The first box = "We are listening" (scope 2.5, not in the Figma header): only used while that link is on
// (src/data/nav.json weAreListeningTarget; off since bug 045), placed between the logo (ends 293) and the Opinion icon (394).
const listeningBox = { l: 305, w: 72 };
// Arabic (GE SS Two, BG2, 8 Oct 2026): the labels are wider than the English boxes (Careers ran into Articles, FAQs past the
// separator at 828), so the last four sit evenly between 532 and 820 at their measured GE SS Two widths (59 / 58 / 65 / 63).
const topLinkBoxes = edition.locale === 'ar'
  ? [ { l: 408, w: 96 }, { l: 532, w: 59 }, { l: 606, w: 58 }, { l: 678, w: 65 }, { l: 757, w: 63 } ]
  : [ { l: 408, w: 96 }, { l: 532, w: 49 }, { l: 607, w: 36 }, { l: 669, w: 85 }, { l: 780, w: 27 } ];
// `path` = page inside the edition (+ optional `query`, e.g. Knowledge Center -> Media Hub health articles, docs/open-decisions.md LA1).
// `page` = key in PAGE_PATHS (preferred), `path` = literal path inside the edition.
const target = (x: { href: string; path?: string; page?: string; query?: string }) => (x.page !== undefined ? urlFor(edition, pagePath(x.page)) : x.path !== undefined ? urlFor(edition, x.path) : x.href) + (x.query ?? '');
const listeningHref = weAreListeningHref(edition);
type TopLink = { label: string; href: string; path?: string; page?: string; query?: string; nav?: string };
const topLinks = c.topLinks
  .filter((x: TopLink) => x.nav !== 'weAreListeningTarget' || listeningHref)
  .map((x: TopLink, i: number) => x.nav === 'weAreListeningTarget' ? { ...x, href: listeningHref!, ...listeningBox } : { ...x, href: target(x), ...topLinkBoxes[listeningHref ? i - 1 : i] });
// Figma widths of the main links, by page (they follow a link when the menu order changes: bug 046 put Our Hospitals before
// Patient Hub, the live site's order).
const mainLinkWidths: Record<string, number> = { about: 84, ourCare: 41, hospitals: 62, patientHub: 54, contact: 51 };
// Dropdowns (bug 046): items from src/lib/nav.ts headerSubmenu (fixed `children` page lists or a data `menu`: Our Care with its
// fly-outs, Our Hospitals), only pages built in this edition, two levels at most.
type MainLink = MainLinkSource & { label: string; href: string; path?: string; page?: string };
const mainLinks: (MainLink & { w: number; id: string; children: NavItem[] })[] = c.mainLinks.map((x: MainLink, i: number) => ({
  ...x,
  href: target(x),
  w: mainLinkWidths[x.page ?? ''] ?? 51,
  id: `nav-${x.page ?? i}`,
  children: headerSubmenu(x, edition, path),
}));
// Region switch: same page in the chosen region, same language (the language switch does the reverse); a page that does
// not exist there (hospital of another region) lands on its nearest existing parent.
// Every region is listed (Global, UAE, KSA); the current one comes from the URL's edition (parsePath), never from a
// fixed label, so a direct visit, a refresh or a deep link of /ae or /sa shows that region as the button label.
const regionOptions = c.region.options.map((o: { region: RegionId; label: string }) => {
  const target = getEdition(o.region, edition.locale);
  return { label: o.label, href: switchHref(target, path), lang: target.lang, current: o.region === edition.region };
});
const currentRegion = regionOptions.find((o: { current: boolean }) => o.current)!;
// Language switch: the active language = the page's own locale (desktop pill + mobile chip, colours, aria-current).
// Figma 112:13218 only shows EN active: pill 22 x 18 at 849, 5 before the EN label (854). AR active keeps that relation
// (874 - 5 = 869, inside the chip 846-893), which centres the pill on either label's glyphs, LTR and RTL.
const langBoxes = { en: { l: 854, w: 15 }, ar: { l: 874, w: 17 } };
const langs = (['en', 'ar'] as const).map((id) => ({
  id,
  label: c.lang[id],
  href: switchHref(getEdition(edition.region, id), path),
  hreflang: getEdition(edition.region, id).lang,
  active: id === edition.locale,
  ...langBoxes[id],
}));
const pillL = langBoxes[edition.locale].l - 5;
const vlines =[ [916, 69], [828, 25], [916, 25], [515, 25] ];
---

<header class="hd relative z-50 bg-white shadow-bar font-gotham">
  <input type="checkbox" id="nav-toggle" class="sr-only" aria-label={c.navToggleLabel} />
  <div class="stage" style="--h: 119">
    <a href={homeHref} class="logo a" style="--l:41;--t:47;--w:252;--ph:45" aria-label={c.logo.homeLabel}>
      <img src={logo.src} width="252" height="45" alt={c.logo.alt} class="block h-auto w-full" />
    </a>

    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>

    <nav class="menu" aria-label={c.menuLabel}>
      <img class="a deco" style="--l:394;--t:32;--w:10;--ph:10" src={vector.src} width="10" height="10" alt="" />
      <ul class="toplinks">
        {topLinks.map((x) => (
          <li class="a" style={`--l:${x.l};--t:33;--w:${x.w};--ph:15`}>
            <a href={x.href} class="hit block whitespace-nowrap text-f9 font-normal not-italic text-navy">{x.label}</a>
          </li>
        ))}
      </ul>

      <div class="chip a" style="--l:846;--t:26;--w:47;--ph:25"></div>
      <div class="pill a" style={`--l:${pillL};--t:30;--w:22;--ph:18`}></div>
      <ul class="lang">
        {langs.map((x) => (
          <li class="a" style={`--l:${x.l};--t:35;--w:${x.w};--ph:15`}><a href={x.href} hreflang={x.hreflang} lang={x.id} aria-current={x.active ? 'true' : undefined} class:list={['hit lang-hit block text-f9 not-italic', x.active ? 'font-normal text-white' : 'font-medium text-navy']}>{x.label}</a></li>
        ))}
      </ul>

      <div class="region a" data-region style="--l:932;--t:33;--w:52;--ph:15">
        <button type="button" class="hit region-btn font-medium not-italic text-f9 text-navy" aria-haspopup="true" aria-expanded="false" aria-controls="region-menu" aria-label={`${currentRegion.label}, ${c.region.menuLabel}`} data-region-btn>
          <span class="region-label">{currentRegion.label}</span>
          <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
        <div class="rmenu" id="region-menu" data-region-menu>
          <ul class="rlist">
            {regionOptions.map((o) => (
              <li><a href={o.href} hreflang={o.lang} class="hit ritem block whitespace-nowrap text-f9 font-medium not-italic text-navy" aria-current={o.current ? 'true' : undefined}>{o.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <!-- "Visit Cambridge Health Group": a link to the group's own website (layout/header JSON `visit.href`, the live site's
           Cambridge Health Group link), new tab (bug 010). Same look as the Figma text block; hover / focus like the other header links. -->
      <a href={c.visit.href} target="_blank" rel="noopener noreferrer" class="visit hit a block text-f9 not-italic text-navy" style="--l:932;--t:71;--w:111;--ph:32"><span class="font-normal">{c.visit.intro}</span>{' '}<br /><span class="font-medium">{c.visit.lines[0]}{' '}<br />{c.visit.lines[1]}</span></a>

      <ul class="mainnav a" style="--t:81;--w:595;--ph:15">
        {mainLinks.map((x) => x.children.length ? (
          <li class="has-sub" style={`--w:${x.w}`} data-submenu>
            <div class="sub-head">
              <a id={x.id} href={x.href} class="hit block whitespace-nowrap text-f9 font-medium not-italic text-navy">{x.label}</a>
              <button type="button" class="hit sub-btn text-navy" aria-expanded="false" aria-controls={`${x.id}-menu`} aria-labelledby={x.id} data-submenu-btn>
                <svg class="sub-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </button>
            </div>
            <div class="sub" id={`${x.id}-menu`} data-submenu-menu>
              <ul class="sub-list">
                {x.children.map((k, j) => k.children.length ? (
                  <li class="has-fly" data-flyout>
                    <div class="fly-head">
                      <a id={`${x.id}-${j}`} href={k.href} class="hit sub-item block whitespace-nowrap text-f9 font-medium not-italic text-navy" aria-current={k.current ? 'page' : undefined}>{k.label}</a>
                      <button type="button" class="hit fly-btn text-navy" aria-expanded="false" aria-controls={`${x.id}-${j}-menu`} aria-labelledby={`${x.id}-${j}`} data-flyout-btn>
                        <svg class="fly-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                      </button>
                    </div>
                    <div class="fly" id={`${x.id}-${j}-menu`} data-flyout-menu>
                      <ul class="fly-list">
                        {k.children.map((g) => (
                          <li><a href={g.href} class="hit sub-item fly-item block whitespace-nowrap text-f9 font-medium not-italic text-navy" aria-current={g.current ? 'page' : undefined}>{g.label}</a></li>
                        ))}
                      </ul>
                    </div>
                  </li>
                ) : (
                  <li><a href={k.href} class="hit sub-item block whitespace-nowrap text-f9 font-medium not-italic text-navy" aria-current={k.current ? 'page' : undefined}>{k.label}</a></li>
                ))}
              </ul>
            </div>
          </li>
        ) : (
          <li style={`--w:${x.w}`}><a href={x.href} class="hit block whitespace-nowrap text-f9 font-medium not-italic text-navy">{x.label}</a></li>
        ))}
      </ul>

      <!-- Label inside the button, flex-centred both ways (bug 022: the old separate absolutely placed label, text-align start,
           sat at the right in RTL). The visible label is the accessible name in each language. Size, label and corners: the
           shared .ui-btn (bug 044/050; Figma 138 x 30 with a 9px label). The 14-15px label needs ~180 Figma px, more than Figma's
           755..916 slot holds next to the nav, so the button ends 11 before the separator line (x 905) and grows toward the nav,
           which starts earlier (Figma 393; 331 since bug 046, see .mainnav) to make room; vertical
           centre = the Figma box's (84). -->
      <a href={c.book.href} class="hit book a ui-btn btn-fill text-navy" style="--l:755;--t:69;--w:138;--ph:30"><span>{c.book.label}</span></a>

      {vlines.map(([l, t]) => (
        <span class="vl a deco" style={`--l:${l};--t:${t};--w:0;--ph:30`}><img src={line1.src} width="30" height="1" alt="" /></span>
      ))}
      <img class="a deco rule" style="--t:55;--ph:1" src={line2.src} width="595" height="1" alt="" />
    </nav>
  </div>
</header>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Corners (bug 049): language chip + its active pill = small chips (--radius-btn), dropdown panels = --radius-card. */
  .chip { background: var(--color-mist); border-radius: var(--radius-btn); }
  .pill { background: #004059; border-radius: var(--radius-btn); }
  .book { background: #00b8ff; }
  .vl > img { position: absolute; inset-inline-start: 0; top: calc(30 * var(--u)); width: calc(30 * var(--u)); height: calc(1 * var(--u)); transform-origin: 0 0; transform: rotate(-90deg); max-width: none; }
  /* RTL: the line hangs from its right end, so rotate the other way around the top-right corner (exact mirror). */
  :global([dir='rtl']) .vl > img { transform-origin: 100% 0; transform: rotate(90deg); }
  .hd ul { margin: 0; padding: 0; list-style: none; }
  /* The list's Figma box (595 wide, Figma x 393) runs under the "Visit Cambridge Health Group" block (x 932..1043) and would
     take the clicks meant for it (bug 010): the box lets pointer events through, only its links take them.
     Start x: Figma 393; 345 for English since bug 044 (the long Book label); 331 in both languages since bug 046 (four dropdown
     chevrons, 11 Figma px each, and the wider GE SS Two Arabic labels ran into the Book button: -8px at 1200 English, -16px
     Arabic). 331 keeps >= 8px before Book from 1200px up and 38 Figma px after the logo (ends 293). */
  .mainnav { display: flex; gap: calc(11 * var(--u)); pointer-events: none; --l: 331; }
  /* The rule between the two rows starts with the main nav and keeps its Figma end (988). */
  .rule { --l: 331; --w: 657; }
  .mainnav a { pointer-events: auto; }
  /* Figma width as a minimum: a longer label (Arabic "حول مستشفى كامبريدج") takes its own width instead of running into the next link. */
  .mainnav li { flex: none; min-width: calc(var(--w) * var(--u)); height: calc(15 * var(--u)); }
  /* Main-menu dropdowns (bug 046). Desktop: a chevron after the label (like the region switch) opens a white panel under the link
     (hover, click, keyboard: scripts/nav-submenu.ts); the parent label stays a link to its own page. The li grows by the
     chevron (11 Figma px), so the next links shift right; the row still ends before the Book button (bug 044: its start depends on the label, ~713 at 1200). */
  .has-sub { position: relative; }
  .sub-head { display: flex; align-items: center; }
  .sub-btn { pointer-events: auto; display: flex; align-items: center; justify-content: center; flex: none; padding: 0; border: 0; background: none; cursor: pointer; color: inherit; --hit-w: 24px; --hit-h: 30px; }
  /* Motion (animation audit 8 Oct 2026, live Blocksy theme): every link colour eases with the theme's .12s curve (--ui-ease);
     dropdown panels fade and rise from 10px over .2s ease (data-dropdown type-1); chevrons keep their .2s turn. */
  .sub-item, .ritem, .mainnav a, .toplinks a { transition: color var(--ui-ease), text-decoration-color var(--ui-ease); }
  /* Top-level links: the live header recolours a hovered menu item (nav li:hover > .ct-menu-link); brand AA = Deep Teal + cyan underline. */
  @media (hover: hover) { .toplinks a:hover, .mainnav li > a:hover, .mainnav .sub-head > a:hover { color: var(--color-navy); text-decoration: underline 2px var(--color-cyan); text-underline-offset: 0.25em; } }
  .sub-chev { width: calc(9 * var(--u)); height: calc(9 * var(--u)); transition: transform .2s; }
  .has-sub[data-open] .sub-chev { transform: rotate(180deg); }
  .sub-btn:focus-visible, .sub-item:focus-visible { outline: 2px solid #00b8ff; outline-offset: 2px; border-radius: calc(3 * var(--u)); }
  .sub-item:hover, .sub-item[aria-current='page'] { color: var(--color-navy); text-decoration: underline 2px var(--color-cyan); text-underline-offset: 0.25em; } /* brand AA: Deep Teal + cyan underline, never cyan text */
  /* Second level (Our Care: Inpatient / Outpatient sections). The row = the service link + a chevron button that opens a
     fly-out beside the panel on desktop (chevron points to the inline end, so it mirrors in Arabic), or an indented list
     below the row on mobile (chevron points down). Never a third level (src/lib/nav.ts). */
  .fly-head { display: flex; align-items: center; }
  .fly-btn { pointer-events: auto; display: flex; align-items: center; justify-content: center; flex: none; padding: 0; border: 0; background: none; cursor: pointer; color: inherit; }
  .fly-chev { transition: transform .2s; }
  .fly-btn:focus-visible { outline: 2px solid #00b8ff; outline-offset: 2px; border-radius: calc(3 * var(--u)); }
  .has-fly[data-open] > .fly-head > .sub-item { color: var(--color-navy); text-decoration: underline 2px var(--color-cyan); text-underline-offset: 0.25em; }
  .burger { display: none; }
  .lang-hit { --hit-w: calc(100% + 5 * var(--u)); }
  .region { z-index: 60; }
  .region-btn { display: flex; align-items: center; width: 100%; height: 100%; padding: 0; border: 0; background: none; font-family: inherit; cursor: pointer; white-space: nowrap; } /* size, weight and colour come from the element's own classes (text-f9 font-medium text-navy) */
  .region-btn:focus-visible, .ritem:focus-visible { outline: 2px solid #00b8ff; outline-offset: 2px; border-radius: calc(3 * var(--u)); }
  .chev { flex: none; width: calc(18 * var(--u)); height: calc(18 * var(--u)); margin-inline-start: calc(5 * var(--u)); transition: transform .2s; }
  .region[data-open] .chev { transform: rotate(180deg); }
  /* The open menu drops over the "Visit Cambridge Health Group" block (932..1043 x 71..103), so it is as wide as that
     column (111) and, with three rows, reaches below it (56..114): the white list hides the text under it completely
     instead of cutting through it. Stacking: .region (z 60) is above its sibling .visit inside the header, and the
     header (z-50) is above the page. */
  .rmenu { visibility: hidden; opacity: 0; transform: translate3d(0, 10px, 0); transition: opacity .2s ease, visibility .2s ease, transform .2s ease; position: absolute; inset-inline-start: 0; top: 100%; padding-top: calc(8 * var(--u)); min-width: calc(111 * var(--u)); }
  .region[data-open] .rmenu { visibility: visible; opacity: 1; transform: translate3d(0, 0, 0); }
  /* .hd .rlist, not .rlist: `.hd ul { padding: 0 }` above is more specific and used to strip the list's padding. */
  .hd .rlist { background: #fff; border-radius: var(--radius-card); box-shadow: 0 calc(2 * var(--u)) calc(8 * var(--u)) rgba(0,0,0,.15); padding: calc(6 * var(--u)) calc(10 * var(--u)); display: flex; flex-direction: column; gap: calc(10 * var(--u)); }
  .ritem { --hit-h: calc(100% + 10 * var(--u)); }
  .ritem:hover, .ritem[aria-current='true'] { color: var(--color-navy); text-decoration: underline 2px var(--color-cyan); text-underline-offset: 0.25em; } /* current region: the header's highlight colour */
  .visit { cursor: pointer; transition: color var(--ui-ease); }
  .visit:hover { color: var(--color-navy); text-decoration: underline 2px var(--color-cyan); text-underline-offset: 0.25em; } /* like the region menu's items */
  .visit:focus-visible { outline: 2px solid #00b8ff; outline-offset: 2px; border-radius: calc(3 * var(--u)); }
  .deco { pointer-events: none; } /* decorative lines must not swallow clicks meant for the links next to them */

  @media (min-width: 1200px) {
    .a { position: absolute; inset-inline-start: calc(var(--l) * var(--u)); top: calc(var(--t) * var(--u)); width: calc(var(--w) * var(--u)); height: calc(var(--ph) * var(--u)); }
    .menu, .toplinks, .lang { display: contents; }
    .visit, .global { margin: 0; }
    .logo img { height: 100%; }
    /* Book: as tall / wide as the .ui-btn needs (bug 044/050), end edge on Figma x 905 (11 before the separator at 916, the nav's
       link gap), at least the Figma slot 755..905 wide (a short label, Arabic, keeps the Figma start), centred on the Figma box's
       centre line (69 + 15). */
    .book { width: auto; min-width: calc(150 * var(--u)); height: auto; inset-inline-start: auto; inset-inline-end: calc((1052 - 905) * var(--u)); top: calc(84 * var(--u) - var(--btn-h) / 2); }
    .has-sub { min-width: calc((var(--w) + 11) * var(--u)); }
    .sub-btn { margin-inline-start: calc(2 * var(--u)); width: calc(9 * var(--u)); height: calc(9 * var(--u)); }
    .sub { pointer-events: auto; visibility: hidden; opacity: 0; transform: translate3d(0, 10px, 0); transition: opacity .2s ease, visibility .2s ease, transform .2s ease; position: absolute; inset-inline-start: calc(-10 * var(--u)); top: 100%; padding-top: calc(10 * var(--u)); z-index: 60; }
    .has-sub[data-open] .sub { visibility: visible; opacity: 1; transform: translate3d(0, 0, 0); } /* visibility flips at once on open (a link can take focus), after the fade on close */
    .hd .sub-list { background: #fff; border-radius: var(--radius-card); box-shadow: 0 calc(2 * var(--u)) calc(8 * var(--u)) rgba(0,0,0,.15); padding: calc(10 * var(--u)) calc(12 * var(--u)); display: flex; flex-direction: column; gap: calc(10 * var(--u)); min-width: calc(140 * var(--u)); }
    .sub-item { --hit-h: calc(100% + 10 * var(--u)); }
    /* Fly-out: starts at the panel's inline edge (the row ends 12 inside it, the list padding), its first item level with the
       service row. The wrapper's padding is a transparent bridge, so the pointer can cross from the row into the fly-out.
       Only shown while its dropdown is open too (a fly-out left open never shows on its own). */
    .has-fly { position: relative; }
    .fly-head { gap: calc(10 * var(--u)); }
    .fly-btn { margin-inline-start: auto; width: calc(9 * var(--u)); height: calc(9 * var(--u)); --hit-w: 24px; --hit-h: calc(100% + 10 * var(--u)); }
    .fly-chev { width: calc(9 * var(--u)); height: calc(9 * var(--u)); transform: rotate(-90deg); }
    :global([dir='rtl']) .fly-chev { transform: rotate(90deg); }
    .fly { visibility: hidden; opacity: 0; transform: translate3d(0, 10px, 0); transition: opacity .2s ease, visibility .2s ease, transform .2s ease; position: absolute; inset-inline-start: 100%; top: calc(-10 * var(--u)); padding-inline-start: calc(16 * var(--u)); z-index: 1; }
    .has-sub[data-open] .has-fly[data-open] > .fly { visibility: visible; opacity: 1; transform: translate3d(0, 0, 0); }
    .hd .fly-list { background: #fff; border-radius: var(--radius-card); box-shadow: 0 calc(2 * var(--u)) calc(8 * var(--u)) rgba(0,0,0,.15); padding: calc(10 * var(--u)) calc(12 * var(--u)); display: flex; flex-direction: column; gap: calc(10 * var(--u)); min-width: calc(140 * var(--u)); }
  }

  @media (max-width: 1199.98px) {
    .stage { height: auto; overflow-x: visible; }
    .menu a { --hit-h: calc(100% + 12 * var(--u)); }
    .stage { display: flex; align-items: center; justify-content: space-between; gap: calc(12 * var(--u)); padding: calc(15 * var(--u)) 16px; box-sizing: border-box; }
    .logo { display: block; width: calc(252 * var(--u)); max-width: calc(100% - 60px); flex: 0 1 auto; }
    .burger { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; align-items: center; cursor: pointer; flex: none; }
    .burger span { display: block; width: 26px; height: 3px; border-radius: 2px; background: #004059; transition: transform .12s cubic-bezier(0.455, 0.03, 0.515, 0.955), opacity .12s cubic-bezier(0.455, 0.03, 0.515, 0.955); } /* live header trigger: all .12s theme curve */
    #nav-toggle:checked ~ .stage .burger span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    #nav-toggle:checked ~ .stage .burger span:nth-child(2) { opacity: 0; }
