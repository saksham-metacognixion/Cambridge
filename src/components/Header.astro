---
import line1 from '../assets/header/line1.svg';
import line2 from '../assets/header/line2.svg';
import vector from '../assets/header/vector.svg';
import { parsePath, getEdition, urlFor } from '../lib/editions';
import { content } from '../lib/content';
import { img } from '../lib/images';

// Current edition and page path, so the language switch lands on the same page in the other language.
const { edition, path } = parsePath(Astro.url.pathname);
const enHref = urlFor(getEdition(edition.region, 'en'), path);
const arHref = urlFor(getEdition(edition.region, 'ar'), path);
const homeHref = urlFor(edition);
const c = content('layout/header', edition.locale);
const logo = img(c.logo.image, edition.region);

// Design (positions/widths) zipped by index with the links from layout/header JSON.
const topLinkBoxes = [ { l: 408, w: 96 }, { l: 532, w: 49 }, { l: 607, w: 36 }, { l: 669, w: 85 }, { l: 780, w: 27 } ];
const topLinks = c.topLinks.map((x: { label: string; href: string; path?: string }, i: number) => ({ ...x, href: x.path === undefined ? x.href : urlFor(edition, x.path), ...topLinkBoxes[i] }));
const mainLinkWidths = [84, 41, 54, 62, 51];
const mainLinks = c.mainLinks.map((x: { label: string; href: string; path?: string }, i: number) => ({ ...x, href: x.path === undefined ? x.href : urlFor(edition, x.path), w: mainLinkWidths[i] }));
// Region switch: same page in the chosen region, same language (the language switch does the reverse).
const regionOptions = c.region.options.map((o: { region: 'ae' | 'sa'; label: string }) => ({
  label: o.label,
  href: urlFor(getEdition(o.region, edition.locale), path),
  lang: getEdition(o.region, edition.locale).lang,
}));
const vlines = [ [916, 69], [828, 25], [916, 25], [515, 25] ];
---

<header class="hd relative z-50 bg-white shadow-bar font-gotham">
  <input type="checkbox" id="nav-toggle" class="sr-only" aria-label={c.navToggleLabel} />
  <div class="stage" style="--h: 119">
    <a href={homeHref} class="logo a" style="--l:41;--t:47;--w:252;--ph:45" aria-label={c.logo.homeLabel}>
      <img src={logo.src} width="252" height="45" alt={c.logo.alt} class="block h-auto w-full" />
    </a>

    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>

    <nav class="menu" aria-label={c.menuLabel}>
      <img class="a deco" style="--l:394;--t:32;--w:10;--ph:10" src={vector.src} width="10" height="10" alt="" />
      <ul class="toplinks">
        {topLinks.map((x) => (
          <li class="a" style={`--l:${x.l};--t:33;--w:${x.w};--ph:15`}>
            <a href={x.href} class="hit block whitespace-nowrap text-f9 font-normal not-italic text-cyan">{x.label}</a>
          </li>
        ))}
      </ul>

      <div class="chip a" style="--l:846;--t:26;--w:47;--ph:25"></div>
      <div class="pill a" style="--l:849;--t:30;--w:22;--ph:18"></div>
      <ul class="lang">
        <li class="a" style="--l:854;--t:35;--w:15;--ph:15"><a href={enHref} hreflang={getEdition(edition.region, 'en').lang} lang="en" class="hit lang-hit block text-f9 font-normal not-italic text-white">{c.lang.en}</a></li>
        <li class="a" style="--l:874;--t:35;--w:17;--ph:15"><a href={arHref} hreflang={getEdition(edition.region, 'ar').lang} lang="ar" class="hit lang-hit block text-f9 font-medium not-italic text-navy">{c.lang.ar}</a></li>
      </ul>

      <div class="region a" data-region style="--l:932;--t:33;--w:52;--ph:15">
        <button type="button" class="hit region-btn font-medium not-italic text-f9 text-navy" aria-haspopup="true" aria-expanded="false" aria-controls="region-menu" aria-label={`${c.region.label}, ${c.region.menuLabel}`} data-region-btn>
          <span class="region-label">{c.region.label}</span>
          <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
        <div class="rmenu" id="region-menu" data-region-menu>
          <ul class="rlist">
            {regionOptions.map((o) => (
              <li><a href={o.href} hreflang={o.lang} class="hit ritem block whitespace-nowrap text-f9 font-medium not-italic text-navy">{o.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <p class="visit a text-f9 not-italic text-navy" style="--l:932;--t:71;--w:111;--ph:32"><span class="font-normal">{c.visit.intro}</span><br /><span class="font-medium">{c.visit.lines[0]}<br />{c.visit.lines[1]}</span></p>

      <ul class="mainnav a" style="--l:393;--t:81;--w:595;--ph:15">
        {mainLinks.map((x) => (
          <li style={`--w:${x.w}`}><a href={x.href} class="hit block whitespace-nowrap text-f9 font-medium not-italic text-navy">{x.label}</a></li>
        ))}
      </ul>

      <a href={c.book.href} class="hit book a" style="--l:755;--t:69;--w:138;--ph:30" aria-label={c.book.ariaLabel}></a>
      <span class="booklabel a text-f9 font-medium not-italic text-off-white" style="--l:766;--t:80;--w:118;--ph:15" aria-hidden="true">{c.book.label}</span>

      {vlines.map(([l, t]) => (
        <span class="vl a deco" style={`--l:${l};--t:${t};--w:0;--ph:30`}><img src={line1.src} width="30" height="1" alt="" /></span>
      ))}
      <img class="a deco" style="--l:393;--t:55;--w:595;--ph:1" src={line2.src} width="595" height="1" alt="" />
    </nav>
  </div>
</header>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .chip { background: #ededed; border-radius: calc(5 * var(--u)); }
  .pill { background: #00415a; border-radius: calc(5 * var(--u)); }
  .book { background: #00b8ff; border-radius: calc(7 * var(--u)); }
  .booklabel { pointer-events: none; }
  .vl > img { position: absolute; inset-inline-start: 0; top: calc(30 * var(--u)); width: calc(30 * var(--u)); height: calc(1 * var(--u)); transform-origin: 0 0; transform: rotate(-90deg); max-width: none; }
  /* RTL: the line hangs from its right end, so rotate the other way around the top-right corner (exact mirror). */
  :global([dir='rtl']) .vl > img { transform-origin: 100% 0; transform: rotate(90deg); }
  .hd ul { margin: 0; padding: 0; list-style: none; }
  .mainnav { display: flex; gap: calc(11 * var(--u)); }
  .mainnav li { width: calc(var(--w) * var(--u)); height: calc(15 * var(--u)); }
  .burger { display: none; }
  .lang-hit { --hit-w: calc(100% + 5 * var(--u)); }
  .region { z-index: 60; }
  .region-btn { display: flex; align-items: center; width: 100%; height: 100%; padding: 0; border: 0; background: none; font-family: inherit; cursor: pointer; white-space: nowrap; } /* size, weight and colour come from the element's own classes (text-f9 font-medium text-navy) */
  .region-btn:focus-visible, .ritem:focus-visible { outline: 2px solid #00b8ff; outline-offset: 2px; border-radius: calc(3 * var(--u)); }
  .chev { flex: none; width: calc(18 * var(--u)); height: calc(18 * var(--u)); margin-inline-start: calc(5 * var(--u)); transition: transform .2s; }
  .region[data-open] .chev { transform: rotate(180deg); }
  .rmenu { visibility: hidden; opacity: 0; transition: opacity .15s, visibility .15s; position: absolute; inset-inline-start: 0; top: 100%; padding-top: calc(8 * var(--u)); min-width: calc(64 * var(--u)); }
  .region[data-open] .rmenu { visibility: visible; opacity: 1; }
  .rlist { background: #fff; border-radius: calc(5 * var(--u)); box-shadow: 0 calc(2 * var(--u)) calc(8 * var(--u)) rgba(0,0,0,.15); padding: calc(6 * var(--u)) calc(10 * var(--u)); display: flex; flex-direction: column; gap: calc(10 * var(--u)); }
  .ritem { --hit-h: calc(100% + 10 * var(--u)); }
  .ritem:hover { color: #00b8ff; }
  .deco { pointer-events: none; } /* decorative lines must not swallow clicks meant for the links next to them */

  @media (min-width: 1200px) {
    .a { position: absolute; inset-inline-start: calc(var(--l) * var(--u)); top: calc(var(--t) * var(--u)); width: calc(var(--w) * var(--u)); height: calc(var(--ph) * var(--u)); }
    .menu, .toplinks, .lang { display: contents; }
    .visit, .global, .booklabel { margin: 0; }
    .book { display: block; }
    .logo img { height: 100%; }
  }

  @media (max-width: 1199.98px) {
    .stage { height: auto; overflow-x: visible; }
    .menu a { --hit-h: calc(100% + 12 * var(--u)); }
    .stage { display: flex; align-items: center; justify-content: space-between; gap: calc(12 * var(--u)); padding: calc(15 * var(--u)) 16px; box-sizing: border-box; }
    .logo { display: block; width: calc(252 * var(--u)); max-width: calc(100% - 60px); flex: 0 1 auto; }
    .burger { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; align-items: center; cursor: pointer; flex: none; }
    .burger span { display: block; width: 26px; height: 3px; border-radius: 2px; background: #004059; transition: transform .2s, opacity .2s; }
    #nav-toggle:checked ~ .stage .burger span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    #nav-toggle:checked ~ .stage .burger span:nth-child(2) { opacity: 0; }
    #nav-toggle:checked ~ .stage .burger span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
    #nav-toggle:focus-visible ~ .stage .burger { outline: 2px solid #00b8ff; outline-offset: 2px; }

    .menu { display: none; position: absolute; inset-inline-start: 0; inset-inline-end: 0; top: 100%; background: #fff; box-shadow: 0 calc(4 * var(--u)) calc(4 * var(--u)) rgba(0,0,0,.06); padding: calc(16 * var(--u)) 16px calc(24 * var(--u)); flex-direction: column; align-items: flex-start; gap: calc(14 * var(--u)); box-sizing: border-box; max-height: calc(100vh - 80px); overflow-y: auto; }
    #nav-toggle:checked ~ .stage .menu { display: flex; }
    .deco, .chip, .pill, .booklabel { display: none; }
    .region { width: auto; height: auto; }
    .region-btn { width: auto; min-height: 44px; gap: calc(4 * var(--u)); }
    .rmenu { position: static; display: none; padding-top: 0; visibility: visible; opacity: 1; }
    .region[data-open] .rmenu { display: block; }
    .rlist { box-shadow: none; background: transparent; padding: 0 0 0 calc(10 * var(--u)); gap: 0; }
    .ritem { display: flex; align-items: center; min-height: 44px; }
    .toplinks, .mainnav { display: flex; flex-direction: column; gap: calc(12 * var(--u)); }
    .mainnav li { width: auto; height: auto; }
    .lang { display: flex; gap: calc(12 * var(--u)); }
    .lang li:first-child a { background: #00415a; border-radius: calc(5 * var(--u)); padding: calc(2 * var(--u)) calc(6 * var(--u)); }
    .lang li:last-child a { background: #ededed; border-radius: calc(5 * var(--u)); padding: calc(2 * var(--u)) calc(6 * var(--u)); }
    .book { position: static; display: flex; align-items: center; justify-content: center; width: calc(138 * var(--u)); height: calc(30 * var(--u)); }
    .book::after { content: "BOOK AN APPOINTMENT"; font-size: calc(9 * var(--u)); font-weight: 500; color: #fffdfd; white-space: nowrap; }
    .book { width: calc(158 * var(--u)); }
    .visit { margin: 0; }
  }
</style>

<script>
  import '../scripts/region-menu';
</script>
