---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import { img } from '../../lib/images';
import Band from '../careers/Band.astro';
import play from '../../assets/about/play.svg';
import about from '../../data/about.json';
import { commonText } from '../../lib/forms';
import type { Edition } from '../../lib/editions';

/*
 * "Cambridge Hospital / A Leader in Post-Acute and Rehabilitation Care" (Figma 45:4982, nodes 42:3734/3735/3739/3815), page y 636-900.
 * Video poster 429 x 264 at x93 (PNG 429x264: 1x only, soft at 1440, flagged B7/P6) with the 44 x 44 play icon at (195, 102) inside it.
 * Copy column x552 (video end 522 + 30), width 407, top = poster top. Title Gotham Medium 28 (line 32), subtitle Book 23 with
 * line 1 = 28 and line 2 = 24 (Figma line heights, ::first-line), lead Book 15 cyan (lines 22 / 18; empty in the client's text,
 * 5 Oct 2026: not rendered), body Book 12 / 14 #6b6b6b, paragraphs separated by one empty 14px line.
 * The player is NOT loaded here: src/scripts/video-facade.ts creates it on click in a lightbox whose frame takes the video's shape
 * (config src/data/about.json -> video { host, id, aspect }; the current Short is a square picture, aspect '1:1', bug 031).
 */
interface Props { edition: Edition; c: { ariaLabel: string; video: { poster: string; alt: string; playLabel: string }; title: string; subtitle: string; lead?: string; text: string[] } }
const { edition, c } = Astro.props;
const poster = img(c.video.poster, edition.region);
const hasVideo = Boolean(about.video.host && about.video.id);
const closeLabel = commonText(edition.locale).close as string;
---

<Band label={c.ariaLabel}>
  <div class="row">
    <div class="video" data-video-facade data-host={about.video.host} data-id={about.video.id} data-aspect={about.video.aspect}>
      <button type="button" class="poster" data-video-play data-close-label={closeLabel} aria-label={c.video.playLabel} aria-disabled={hasVideo ? undefined : 'true'}>
        <Picture src={poster} formats={['avif']} fallbackFormat="webp" width={px(429)} height={px(264)} widths={[px(429)]} sizes={`(min-width: 1440px) ${px(429)}px, 90vw`} loading="lazy" decoding="async" alt={c.video.alt} class="thumb" pictureAttributes={{ class: 'contents' }} />
        {hasVideo && <span class="play video-pulse" aria-hidden="true"></span>}
        <img loading="lazy" src={play.src} width="44" height="44" alt="" class="play" />
      </button>
    </div>
    <div class="copy">
      <h2 class="title">
        <span class="t1">{c.title}</span>
        <span class="t2">{c.subtitle}</span>
      </h2>
      <div class="body">
        {c.lead && <p class="lead">{c.lead}</p>}
        {c.text.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</Band>

<script>
  import '../../scripts/video-facade';
</script>

<style>
  .row { display: flex; flex-direction: column; gap: calc(24 * var(--u)); padding-block: 0; }
  .video { position: relative; flex: none; width: calc(429 * var(--u)); max-width: 100%; aspect-ratio: 429 / 264; background: #e7e7e7; border-radius: var(--radius-card); overflow: hidden; } /* bug 049 */
  /* Rounded corners (user request 6 Oct, as the live site's About video; not in Figma); since bug 049 the shared --radius-card. */
  .poster { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .poster[aria-disabled='true'] { cursor: default; }
  .poster :global(.thumb) { display: block; width: 100%; height: 100%; object-fit: cover; max-width: none; }
  .play { position: absolute; width: calc(44 * var(--u)); height: calc(44 * var(--u)); inset-inline-start: calc(195 / 429 * 100%); top: calc(102 / 264 * 100%); max-width: none; }
  .video :global(.player) { display: block; width: 100%; height: 100%; border: 0; background: #000; }
  .copy { min-width: 0; }
  .title { margin: 0; color: var(--color-navy); font-weight: 500; font-style: normal; }
  .t1 { display: block; font-size: calc(28 * var(--u)); line-height: calc(27 * var(--u)); }
  .t2 { display: block; font-weight: 400; font-size: calc(23 * var(--u)); line-height: calc(24 * var(--u)); }
  .t2::first-line { line-height: calc(28 * var(--u)); }
  .body { margin-top: calc(12 * var(--u)); color: var(--color-body); font-size: calc(12 * var(--u)); line-height: calc(14 * var(--u)); }
  .body p { margin: 0; overflow-wrap: anywhere; }
  .body p + p { margin-top: calc(14 * var(--u)); }
  .body .lead { color: var(--color-navy); font-size: calc(15 * var(--u)); line-height: calc(18 * var(--u)); }
  .body .lead::first-line { line-height: calc(22 * var(--u)); }
  @media (min-width: 1024px) {
    .row { flex-direction: row; align-items: flex-start; gap: 0; }
    .video { margin-inline-start: calc(93 * var(--u)); }
    .copy { flex: none; width: calc(407 * var(--u)); margin-inline-start: calc(30 * var(--u)); }
    .t1, .t2 { width: calc(387 * var(--u)); }
  }
</style>
