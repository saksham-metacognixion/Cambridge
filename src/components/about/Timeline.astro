---
import { Picture } from 'astro:assets';
import Band from '../careers/Band.astro';
import arrow from '../../assets/about/timeline-arrow.svg';
import line from '../../assets/about/timeline-line.svg';

/*
 * "Journey of Excellence" (Figma 307:494, second About version; switched OFF in src/data/about.json -> showTimeline until the
 * frame is confirmed as final, docs/open-decisions.md A1). Page y of that frame: heading 991 (box 387 x 33, Medium 28 / 28,
 * centred), cards 1065-1220. Cards 187 x 155, radius 14 (now --radius-card, bug 049), x 120 / 322 / 524 / 727 (gap 15.33); odd = white + 1px cyan border
 * (year / title cyan, text #6b6b6b), even = cyan fill (all white). Year Book 28 at card + (21, 16); title Book 14 / 16 (2 lines) at
 * +43; text Book 11 / 14 at +80, width 154 (white cards) / 146 (cyan cards). "Line 33" (503 x 1, #418ea2) runs at y1148
 * (card + 83) from x307 behind the cards, so only the gaps between the cards show it. Arrows (36.528 circle, #00b8ff) at x71 and
 * x930, y1122 (row top + 57); the left one is the right one rotated 180. Each arrow moves the row by one card; the row loops and
 * auto-advances every 6 s like the live site's Swiper (scripts/timeline.ts).
 * Content (5 Oct 2026): the client's About document supplies 18 entries whose titles and texts are longer than the four Figma
 * samples, so the card height is a MINIMUM (155) and a row's cards stretch to the tallest one; the title wraps freely. The text
 * ends 16 Figma px above the card's bottom edge, the same as the top inset (bug 028).
 * Below 1024px (no Figma frame, bug 028): the row shows `--n` whole cards between the arrows (1 on phones, 2 from 640px,
 * 3 from 900px), each card (100% - gaps) / --n wide so no partial card ever shows, the row snaps one card at a time and the
 * arrows are centred on the row. The connector line (drawn for the 187px desktop card) is hidden there.
 */
interface Item { year: string; title: string[]; text: string }
interface Props { c: { ariaLabel: string; heading: string; prevLabel: string; nextLabel: string; items: Item[] } }
const { c } = Astro.props;
---

<Band labelledby="about-timeline-heading">
  <div class="tl" data-timeline>
    <h2 id="about-timeline-heading" class="h">{c.heading}</h2>
    <div class="line-row">
      <button type="button" class="arrow prev hit" data-timeline-dir="-1" aria-label={c.prevLabel}><img src={arrow.src} width="36.5278" height="36.5278" alt="" /></button>
      <div class="row hscroll" data-timeline-row tabindex="0" role="group" aria-label={c.ariaLabel}>
        <img class="connector" src={line.src} width="503" height="1" alt="" aria-hidden="true" />
        {c.items.map((x, i) => (
          <article class:list={['card', i % 2 === 0 ? 'outline' : 'fill']} data-timeline-card>
            <p class="year">{x.year}</p>
            <h3 class="title">{x.title.map((l) => <span class="block">{l}</span>)}</h3>
            <p class="text">{x.text}</p>
          </article>
        ))}
      </div>
      <button type="button" class="arrow next hit" data-timeline-dir="1" aria-label={c.nextLabel}><img src={arrow.src} width="36.5278" height="36.5278" alt="" /></button>
    </div>
  </div>
</Band>

<script>
  import '../../scripts/timeline';
</script>

<style>
  .h { margin: 0 auto; width: calc(387 * var(--u)); max-width: 100%; min-height: calc(33 * var(--u)); text-align: center; font-weight: 500; font-size: calc(28 * var(--u)); line-height: calc(28 * var(--u)); color: var(--color-navy); }
  .line-row { margin-top: calc(41 * var(--u)); display: flex; align-items: flex-start; }
  .row { position: relative; display: flex; align-items: stretch; gap: calc(15.33 * var(--u)); min-width: 0; padding: 0; }
  .connector { position: absolute; inset-inline-start: calc(187 * var(--u)); top: calc(83 * var(--u)); width: calc(503 * var(--u)); height: calc(1 * var(--u)); max-width: none; pointer-events: none; }
  .card { position: relative; flex: none; box-sizing: border-box; width: calc(187 * var(--u)); min-height: calc(155 * var(--u)); border-radius: var(--radius-card); padding: calc(16 * var(--u)) calc(12 * var(--u)) calc(16 * var(--u)) calc(21 * var(--u)); font-weight: 400; scroll-snap-align: start; }
  .card.outline { background: #fff; border: calc(1 * var(--u)) solid var(--color-cyan); padding-block-start: calc(15 * var(--u)); padding-inline-start: calc(20 * var(--u)); color: var(--color-navy); }
  .card.fill { background: var(--color-cyan); color: var(--color-navy); }
  .year { margin: 0; font-size: calc(28 * var(--u)); line-height: calc(27 * var(--u)); }
  .title { margin: calc(0 * var(--u)) 0 0; font-weight: 400; font-size: calc(14 * var(--u)); line-height: calc(16 * var(--u)); }
  .year + .title { margin-top: calc(0 * var(--u)); }
  .text { margin: calc(5 * var(--u)) 0 0; font-size: calc(11 * var(--u)); line-height: calc(14 * var(--u)); }
  .outline .text { color: var(--color-body); width: calc(154 * var(--u)); }
  .fill .text { width: calc(146 * var(--u)); }
  .arrow { flex: none; padding: 0; border: 0; background: none; cursor: pointer; width: calc(36.528 * var(--u)); height: calc(36.528 * var(--u)); margin-top: calc(57 * var(--u)); line-height: 0; }
  .arrow img { display: block; width: 100%; height: 100%; }
  .prev img { transform: rotate(180deg); }
  :global([dir='rtl']) .prev img { transform: none; }
  :global([dir='rtl']) .next img { transform: rotate(180deg); }
  .arrow:focus-visible, .row:focus-visible { outline: 2px solid var(--color-cyan); outline-offset: 2px; border-radius: var(--radius-card); } /* bug 049 */
  @media (min-width: 1024px) {
    .row { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .row::-webkit-scrollbar { display: none; }
    .line-row { padding-inline-start: calc(71 * var(--u)); }
    .prev { margin-inline-end: calc(12.47 * var(--u)); }
    .next { margin-inline-start: calc(16 * var(--u)); }
    .row { width: calc(794 * var(--u)); }
    .tl { padding-inline-start: 0; }
  }
  @media (max-width: 1023.98px) {
    .line-row { --n: 1; gap: calc(6 * var(--u)); padding-block-end: 4px; align-items: center; }
    .row { --gap: calc(15.33 * var(--u)); flex: 1 1 auto; overflow-x: auto; scroll-snap-type: x mandatory; scroll-snap-stop: always; gap: var(--gap); }
    .card { width: calc((100% - (var(--n) - 1) * var(--gap)) / var(--n)); }
    .outline .text, .fill .text { width: auto; }
    .connector { display: none; }
    /* Smaller arrows (36 CSS px, the 44px hit layer stays) so the card keeps the band's width on phones. */
    .arrow { margin-top: 0; width: 36px; height: 36px; }
  }
  @media (min-width: 640px) and (max-width: 1023.98px) { .line-row { --n: 2; } }
  @media (min-width: 900px) and (max-width: 1023.98px) { .line-row { --n: 3; } }
</style>
