---
/*
 * One health calculator (bug 014; no Figma frame): the inner-page intro block (CenteredIntro, as on Refer a Patient /
 * Insurance / International) over the white page-form card (Refer a Patient 46:8029: 968 wide at x 42, padding 56 / 43 / 52 /
 * 44, radius 14.32, shadow) with the grey-box page fields (forms.css `pf-*`: Gotham Book 15 labels, 35-high boxes, radius
 * 10.754) in the two 410-wide columns of the Refer form, the label above its box because the live questions are long
 * ("Are you taking blood pressure medication?"), the Refer SUBMIT button (150 x 50, radius 15, Bold 15) and, after a
 * calculation, the result (section-heading style value, Bold 15 category, Book 12/14 note) with the inner-page outline
 * button that opens the Book an Appointment pop-up (the live calculators end with the same call to action).
 * Fields: src/data/calculators.json; text: src/data/content/calculators/<key>.<locale>.json; logic: src/scripts/calculator.ts.
 */
import { content } from '../../lib/content';
import { parsePath } from '../../lib/editions';
import type { Calculator } from '../../lib/calculators';
import CenteredIntro from '../shared/CenteredIntro.astro';
import OutlineButton from '../shared/OutlineButton.astro';
import chevSel from '../../assets/page-form/chevron-doctor.svg';
import '../forms/forms.css';

interface Props { calc: Calculator }
const { calc } = Astro.props;
const { edition } = parsePath(Astro.url.pathname);
const c = content(`calculators/${calc.key}`, edition.locale);
const common = content('calculators/common', edition.locale);
const id = (n: string) => `calc-${calc.key}-${n}`;
const config = JSON.stringify({ key: calc.key, invalid: common.errors.invalid, fields: c.form.fields, result: c.result });
---

<section class="calc" aria-labelledby="calc-heading" data-calc>
  <CenteredIntro id="calc-heading" heading={c.intro.heading} text={c.intro.text} cx={521} tx={520.5} />

  <div class="card pf-card">
    <form class="pf cf" novalidate data-calculator={config} aria-label={c.form.ariaLabel}>
      <div class="cf-grid">
        {calc.fields.map((f) => {
          const t = c.form.fields[f.name];
          return (
            <div class="pf-field" data-field={f.name}>
              <label for={id(f.name)} class="pf-label">{t.label}</label>
              {f.type === 'select' ? (
                <div class="pf-select">
                  <select id={id(f.name)} name={f.name} required aria-describedby={id('alert')} class="pf-box">
                    <option value="" selected>{t.placeholder}</option>
                    {(f.options ?? []).map((o) => <option value={o}>{t.options[o]}</option>)}
                  </select>
                  <img src={chevSel.src} alt="" width="7" height="4.207" class="pf-chev" />
                </div>
              ) : (
                <input id={id(f.name)} name={f.name} type="number" inputmode="decimal" required min={f.min} step={f.step} placeholder={t.placeholder} aria-describedby={id('alert')} class="pf-box" />
              )}
            </div>
          );
        })}
      </div>
      <p id={id('alert')} class="f-alert" role="alert" hidden></p>
      <button type="submit" class="f-submit btn-fill" style="--bw:150;--bh:50;--br:15;--bfs:15"><span>{c.form.submit}</span></button>
    </form>

    <div class="result" data-calc-result role="status" aria-live="polite" hidden>
      <p class="r-value" data-calc-value></p>
      <p class="r-category" data-calc-category></p>
      <p class="r-note" data-calc-note hidden></p>
      <OutlineButton href={common.cta.href} label={common.cta.label} class="r-cta" />
    </div>
  </div>
</section>

<script>
  import '../../scripts/calculator';
</script>

<style>
  .calc { max-width: calc(var(--target-w) * 1px); margin-inline: auto; font-family: var(--font-gotham); font-style: normal; color: var(--color-navy); }
  .card { margin: calc(34 * var(--u)) 16px 0; padding: 24px 16px; }
  .cf-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(19 * var(--u)) calc(60 * var(--u)); }
  .cf :global(.pf-field) { display: grid; grid-template-columns: minmax(0, 1fr); }
  .cf :global(.pf-label) { min-inline-size: 0; padding-block: 0 calc(6 * var(--u)); white-space: normal; }
  .cf :global(.pf-box), .cf :global(.pf-select) { inline-size: 100%; }
  .cf :global(select) { color: var(--color-body); }
  .cf :global(select:has(option:checked:not([value='']))) { color: var(--color-navy); }
  .cf :global(input[type='number']) { -moz-appearance: textfield; }
  .cf :global(input[type='number']::-webkit-inner-spin-button), .cf :global(input[type='number']::-webkit-outer-spin-button) { -webkit-appearance: none; margin: 0; }
  .cf :global(.f-alert) { margin-block-start: calc(16 * var(--u)); text-align: start; }
  /* the live labels are longer than the Refer SUBMIT ("Calculate Heart Health Age", Arabic): the button grows with its label, 150 at least */
  .cf :global(.f-submit) { margin-block-start: calc(37 * var(--u)); inline-size: auto; min-inline-size: calc(var(--bw) * var(--u)); padding-inline: calc(24 * var(--u)); }
  .result { margin-block-start: calc(32 * var(--u)); text-align: center; }
  .result[hidden] { display: none; }
  .r-value { margin: 0; font-weight: 500; font-size: calc(28 * var(--u)); line-height: calc(33 * var(--u)); color: var(--color-navy-alt); overflow-wrap: anywhere; }
  .r-category { margin: calc(6 * var(--u)) 0 0; font-weight: 700; font-size: calc(15 * var(--u)); line-height: calc(18 * var(--u)); }
  .r-note { margin: calc(8 * var(--u)) 0 0; font-weight: 400; font-size: calc(12 * var(--u)); line-height: calc(14 * var(--u)); color: var(--color-body); }
  .r-note[hidden] { display: none; }
  .result :global(.r-cta) { margin: calc(18 * var(--u)) auto 0; }
  @media (min-width: 1024px) {
    .card { width: calc(968 * var(--u)); margin-inline: calc(42 * var(--u)) 0; padding: calc(56 * var(--u)) calc(43 * var(--u)) calc(52 * var(--u)) calc(44 * var(--u)); }
    .cf-grid { grid-template-columns: calc(410 * var(--u)) calc(410 * var(--u)); }
  }
</style>
