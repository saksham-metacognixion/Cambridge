---
import OutlineButton from '../shared/OutlineButton.astro';
import NoOpeningsPanel from './NoOpenings.astro';
import type { NoOpenings } from '../../lib/careers';

/*
 * "Start Your Career Journey with Us!" band (Figma 112:7230, page y 2303-2518, #004059; the SVG is a plain rectangle).
 * The designer centres each line on a slightly different x, kept: heading 112:7231 centre 512 (w606, Medium 30 white, box 27,
 * +38 from the top), text 112:7232 centre 526.5 (w577, Book 12/14 white, 7 below the heading box), field 112:7242 centre 510.5
 * (311 x 35, #d9d9d9, 0.5 white outline, radius 10, 17 below the text; label Book 10/14 #004059 at +15 / +10; chevron
 * 7 x 4.207 at +287 / +17), button 112:7234 centre 512 (166 x 30, white, radius 7, 14 below the field; label Medium 13
 * #004059, centred in the button by flex: the Figma text box at +9 / +9 put the label low with the real Gotham metrics, bug 007).
 * Since bugs 044 / 049 / 050 (client request 7 Oct 2026): the button is the shared .ui-btn size (its centre kept at x512), the
 * field corners --radius-field. Band ends 19 below the button.
 * "View Open Roles" (bug 088, 13 Oct 2026): Figma draws it as a select field with a chevron, but there is no list of roles to
 * open (no vacancies, portal or form from the client: docs/open-decisions.md D3 / D4), so the dropdown look was a fake control.
 * It is now a plain outline button (the Careers "View Open Roles" button of Life at Cambridge, onDark as on the navy map band)
 * centred where the field's centre was (x 510.5, field middle), so "Apply Now" keeps its place. Destination = openRolesUrl.
 * noOpen (bug 088 reopened, careers.json noOpenings): both buttons open the no-openings panel below them instead; the band
 * (fixed Figma height on desktop) grows only while it is open.
 * Existing band component? None fits (CtaTab / Contact / ContactRecovery are different layouts), so this one is new.
 */
interface Props { c: { ariaLabel: string; heading: string; text: string; openRoles: { label: string }; apply: { label: string } }; openRolesHref: string; applyHref: string; noOpen?: NoOpenings | null }
const { c, openRolesHref, applyHref, noOpen = null } = Astro.props;
const ctl = noOpen ? 'no-openings-start' : undefined;
---

<section class="cta" aria-label={c.ariaLabel}>
  <div class="in">
    <h2 class="h">{c.heading}</h2>
    <p class="t">{c.text}</p>
    <OutlineButton href={openRolesHref} label={c.openRoles.label} onDark class="roles" data-no-openings={ctl} />
    <a href={applyHref} class="apply ui-btn hit btn-fill-white" data-no-openings={ctl}><span>{c.apply.label}</span></a>
    {noOpen && <NoOpeningsPanel id="no-openings-start" n={noOpen} onDark class="nop" />}
  </div>
</section>

<style>
  .cta { background: var(--color-navy); font-family: var(--font-gotham); font-style: normal; }
  .in { box-sizing: border-box; display: flex; flex-direction: column; align-items: center; max-width: calc(var(--max-w) * 1px); margin-inline: auto; padding: calc(38 * var(--u)) calc(24 * var(--u)) calc(19 * var(--u)); text-align: center; color: #fff; }
  .h { margin: 0; font-weight: 500; font-size: calc(30 * var(--u)); line-height: calc(34.6 * var(--u)); overflow-wrap: anywhere; }
  .t { margin: calc(14 * var(--u)) 0 0; max-width: calc(577 * var(--u)); font-size: calc(12 * var(--u)); line-height: calc(14 * var(--u)); overflow-wrap: anywhere; }
  /* --fd = half of (old 35-unit field - button): the button sits on the field's middle and Apply Now keeps its y. */
  .in { --fd: calc((35 * var(--u) - var(--btn-h)) / 2); }
  .in :global(.roles) { margin-top: calc(17 * var(--u) + var(--fd)); }
  .apply { margin-top: calc(14 * var(--u) + var(--fd)); background: #fff; color: var(--color-navy); } /* size from .ui-btn (bug 044/050) */
  @media (min-width: 1024px) {
    .in { display: block; padding-inline: 0; text-align: start; height: calc(215 * var(--u)); }
    .h { width: calc(606 * var(--u)); height: calc(27 * var(--u)); margin-inline-start: calc(209 * var(--u)); text-align: center; }
    .t { width: calc(577 * var(--u)); max-width: none; margin-top: calc(7 * var(--u)); margin-inline-start: calc(238 * var(--u)); text-align: center; }
    .in :global(.roles) { display: flex; width: fit-content; margin-inline-start: calc(510.5 * var(--u)); translate: -50% 0; } /* the old field's centre */
    :global([dir='rtl']) .in :global(.roles) { translate: 50% 0; }
    .apply { display: flex; width: fit-content; margin-inline-start: calc(512 * var(--u)); translate: -50% 0; } /* centre at Figma x512 (429 + 166 / 2) */
    :global([dir='rtl']) .apply { translate: 50% 0; }
    .in:has(:global(.nop:not([hidden]))) { height: auto; }
    .in :global(.nop) { width: calc(577 * var(--u)); margin-inline-start: calc(238 * var(--u)); text-align: center; }
  }
  @media (max-width: 1023.98px) {
    .in { padding-block: calc(40 * var(--u)); }
    .h { font-size: calc(26 * var(--u)); }
  }
</style>
