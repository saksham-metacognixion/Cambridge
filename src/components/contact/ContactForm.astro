---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import { content, t } from '../../lib/content';
import { img } from '../../lib/images';
import { parsePath, urlFor } from '../../lib/editions';
import { pagePath } from '../../lib/paths';
import { clientConfig, commonText } from '../../lib/forms';
import hospitalData from '../../data/hospitals.json';
import chevron from '../../assets/contact-page/select-chevron.svg';
import checkbox from '../../assets/contact-page/checkbox.svg';
import mailIcon from '../../assets/contact-page/icon-mail.svg';
import globeIcon from '../../assets/contact-page/icon-globe.svg';
import phoneIcon from '../../assets/contact-page/icon-phone.svg';
import cornerMask from '../../assets/contact-page/card-corner-mask.svg';
import cornerFill from '../../assets/contact-page/card-corner-fill.svg';

// Figma 86:773 + 86:808 + grey band 86:432: section starts at page y 556, h 667. Spec y values are page y minus 556.
const { edition } = parsePath(Astro.url.pathname);
const c = content('contact/page', edition.locale);
const f = c.form;
// Shared form behaviour (src/scripts/forms.ts): EN/AR validation, JSON submit, success message. Field rules = forms.json 'send-enquiry'.
const common = commonText(edition.locale);
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const err = 'f-err cf-err lg:absolute lg:start-205 lg:w-322';
const map = img(c.map.image, edition.region);
// Hospital options come from hospitals.json (one spelling everywhere): the region's own hospitals, all of them on Global.
const hospitals = hospitalData.hospitals
  .filter((h) => edition.region === 'global' || h.region === edition.region)
  .map((h) => ({ value: h.slug, label: t(h.brand, edition.locale, 'hospitals') + ' ' + t(h.city, edition.locale, 'hospitals') }));

const label = 'font-gotham font-normal text-[calc(15*var(--u))] leading-[calc(18.82*var(--u))] text-navy not-italic whitespace-nowrap max-lg:whitespace-normal';
const detail = 'font-gotham font-normal text-[calc(17.224*var(--u))] text-navy not-italic whitespace-nowrap no-underline';
---

<section id="contact-form" class="relative bg-veil" style="--h: 667" aria-labelledby="contact-title">
  <div class="stage max-lg:flex max-lg:flex-col max-lg:items-center max-lg:gap-[calc(32*var(--u))] max-lg:px-[calc(16*var(--u))] max-lg:py-[calc(40*var(--u))]">
    <h2 id="contact-title" class="m-0 font-gotham font-medium text-f28 leading-none text-navy-alt text-center not-italic whitespace-normal [word-break:break-word] lg:absolute lg:start-201 lg:top-42 lg:w-651 lg:h-33">{c.heading}</h2>

    <div class="card max-lg:w-full max-lg:max-w-[calc(859*var(--u))] max-lg:rounded-[calc(22.056*var(--u))] max-lg:bg-white max-lg:p-[calc(24*var(--u))] max-lg:flex max-lg:flex-col max-lg:gap-[calc(32*var(--u))] lg:contents">
      <div class="hidden lg:block absolute start-67 top-96 w-859 h-463 bg-white rounded-[calc(22.056*var(--u))]" aria-hidden="true"></div>

      <form action="/api/forms/send-enquiry" method="POST" novalidate data-form="send-enquiry" data-config={clientConfig('send-enquiry', edition.locale)} aria-label={f.ariaLabel} class="max-lg:flex max-lg:flex-col max-lg:gap-[calc(14*var(--u))] lg:contents">
        <input type="hidden" name="edition" value={edition.id} />

        <div class="row max-lg:flex max-lg:flex-col max-lg:gap-[calc(4*var(--u))] lg:contents" data-field="name">
          <label for="cf-name" class:list={[label, 'lg:absolute lg:start-117 lg:top-134 lg:w-88']}>{f.nameLabel}</label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" class="field lg:absolute lg:start-205 lg:top-126" aria-describedby="cf-name-error" />
          <p id="cf-name-error" class:list={[err, 'lg:top-[calc(162*var(--u))]']} hidden></p>
        </div>
        <div class="row max-lg:flex max-lg:flex-col max-lg:gap-[calc(4*var(--u))] lg:contents" data-field="email">
          <label for="cf-email" class:list={[label, 'lg:absolute lg:start-117 lg:top-189']}>{f.emailLabel}</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" class="field lg:absolute lg:start-205 lg:top-181" aria-describedby="cf-email-error" />
          <p id="cf-email-error" class:list={[err, 'lg:top-[calc(217*var(--u))]']} hidden></p>
        </div>
        <div class="row max-lg:flex max-lg:flex-col max-lg:gap-[calc(4*var(--u))] lg:contents" data-field="hospital">
          <label for="cf-hospital" class:list={[label, 'lg:absolute lg:start-117 lg:top-244']}>{f.hospitalLabel}</label>
          <!-- The box is the select's own frame (positioned on desktop like the other fields), so the chevron is anchored to the field's end edge. -->
          <div class="relative max-lg:w-full lg:absolute lg:start-205 lg:top-236">
            <select id="cf-hospital" name="hospital" required class="field select">
              <option value="" selected disabled>{f.hospitalPlaceholder}</option>
              {hospitals.map((h) => <option value={h.value}>{h.label}</option>)}
            </select>
            <img src={chevron.src} width="7" height="4.207" alt="" class="chev" />
          </div>
          <p id="cf-hospital-error" class:list={[err, 'lg:top-[calc(272*var(--u))]']} hidden></p>
        </div>
        <div class="row max-lg:flex max-lg:flex-col max-lg:gap-[calc(4*var(--u))] lg:contents" data-field="subject">
          <label for="cf-subject" class:list={[label, 'lg:absolute lg:start-117 lg:top-299']}>{f.subjectLabel}</label>
          <input id="cf-subject" name="subject" type="text" required class="field lg:absolute lg:start-205 lg:top-291" aria-describedby="cf-subject-error" />
          <p id="cf-subject-error" class:list={[err, 'lg:top-[calc(327*var(--u))]']} hidden></p>
        </div>
        <div class="row max-lg:flex max-lg:flex-col max-lg:gap-[calc(4*var(--u))] lg:contents" data-field="message">
          <textarea id="cf-message" name="message" required aria-label={f.messagePlaceholder} placeholder={f.messagePlaceholder} aria-describedby="cf-message-error" class="field area lg:absolute lg:start-117 lg:top-346"></textarea>
          <p id="cf-message-error" class="f-err cf-err lg:absolute lg:start-117 lg:top-[calc(434*var(--u))] lg:w-410" hidden></p>
        </div>

        <div data-field="consent" class="lg:contents">
        <label class="consent max-lg:flex max-lg:items-start max-lg:gap-[calc(10*var(--u))] lg:contents">
          <input type="checkbox" name="consent" required class="consent-input" aria-describedby="cf-consent-error" />
          <span class="box pointer-events-none max-lg:relative max-lg:shrink-0 max-lg:mt-[calc(-1.7*var(--u))] max-lg:ms-[calc(-1.7*var(--u))] lg:absolute lg:start-[calc(122.267*var(--u))] lg:top-[calc(454.267*var(--u))]" aria-hidden="true">
            <img src={checkbox.src} width="15.4667" height="15.4667" alt="" class="block max-w-none" style="width:calc(15.4667*var(--u));height:calc(15.4667*var(--u))" />
            <span class="dot"></span>
          </span>
          <span class="font-gotham font-light text-[calc(9.87*var(--u))] leading-10.5 text-navy not-italic lg:absolute lg:start-147 lg:top-452 lg:whitespace-nowrap">
            <span class="block">{f.consent.before}<a href={f.consent.link.page ? urlFor(edition, pagePath(f.consent.link.page)) : f.consent.link.href} class="hit font-normal underline decoration-from-font [text-underline-position:from-font] text-navy">{f.consent.link.label}</a>{f.consent.after}</span>
            <span class="block">{f.consent.line2}</span>
          </span>
        </label>
        <p id="cf-consent-error" class="f-err cf-err lg:absolute lg:start-147 lg:top-[calc(475*var(--u))] lg:w-410" hidden></p>
        </div>

        {siteKey && <div class="ts-slot lg:absolute lg:start-117 lg:top-[calc(536*var(--u))]" data-sitekey={siteKey} data-language={edition.locale} data-appearance="interaction-only"></div>}
        <p class="f-alert cf-err lg:absolute lg:start-[calc(234*var(--u))] lg:top-[calc(503*var(--u))] lg:w-[calc(293*var(--u))] lg:text-start" role="alert" hidden></p>
        <button type="submit" class="hit relative block border-0 p-0 m-0 bg-cyan not-italic cursor-pointer rounded-[calc(18.673*var(--u))] w-108 h-36 lg:absolute lg:start-117 lg:top-493">
          <span class="absolute block start-[calc(32.4*var(--u))] top-[calc(9.96*var(--u))] font-gotham font-bold text-[calc(10.8*var(--u))] text-white not-italic whitespace-nowrap">{f.submit}</span>
        </button>
      </form>
      <div class="f-success max-lg:py-0 lg:absolute lg:start-117 lg:top-[calc(240*var(--u))] lg:w-[calc(410*var(--u))]" data-success-for="send-enquiry" role="status" tabindex="-1" hidden>
        <p class="s-title">{common.success.title}</p>
        <p class="s-text">{common.success.text}</p>
      </div>

      <!-- Navy panel is drawn above the card (and past its right edge), then the map and the corner art, as in Figma. -->
      <div class="hidden lg:block absolute start-[calc(682.2*var(--u))] top-96 w-302 h-463 bg-navy rounded-e-[calc(19.409*var(--u))]" aria-hidden="true"></div>
      <div class="art hidden lg:block absolute start-742 top-108 w-242 h-435" aria-hidden="true">
        <div class="art-fill" style={`background-image:url('${cornerFill.src}');-webkit-mask-image:url('${cornerMask.src}');mask-image:url('${cornerMask.src}')`}></div>
      </div>
      <div class="map relative max-lg:w-full max-lg:max-w-[calc(307*var(--u))] max-lg:aspect-[307/375] lg:absolute lg:start-590 lg:top-140 lg:w-307 lg:h-375 rounded-[calc(28*var(--u))] overflow-hidden">
        <Picture
          src={map}
          formats={['avif']}
          fallbackFormat="webp"
          width={px(307)}
          height={px(375)}
          widths={[px(307), px(307) * 2]}
          sizes="(min-width: 1440px) 420px, (min-width: 1024px) 29vw, 100vw"
          loading="lazy"
          decoding="async"
          alt={c.map.alt}
          class="absolute inset-0 h-full w-full max-w-none object-cover"
          pictureAttributes={{ class: 'contents' }}
        />
      </div>
    </div>

    <!-- Contact details row (Figma 86:808). Text tops differ by a few px in Figma and are kept as they are. -->
    <ul class="details m-0 list-none p-0 max-lg:flex max-lg:flex-col max-lg:items-start max-lg:gap-[calc(14*var(--u))] lg:contents">
      <li class="max-lg:flex max-lg:items-center max-lg:gap-[calc(10*var(--u))] lg:contents">
        <img src={mailIcon.src} width="20.668" height="18.946" alt="" class="max-w-none lg:absolute lg:start-119 lg:top-[calc(597.4*var(--u))]" style="width:calc(20.668*var(--u));height:calc(18.946*var(--u))" />
        <a href={`mailto:${c.details.email}`} class:list={[detail, 'hit lg:absolute lg:start-[calc(148.11*var(--u))] lg:top-598']}>{c.details.email}</a>
      </li>
      <li class="max-lg:flex max-lg:items-center max-lg:gap-[calc(10*var(--u))] lg:contents">
        <img src={globeIcon.src} width="18.946" height="18.946" alt="" class="max-w-none lg:absolute lg:start-423 lg:top-598" style="width:calc(18.946*var(--u));height:calc(18.946*var(--u))" />
        <a href={c.details.webHref} dir="ltr" class:list={[detail, 'hit lg:absolute lg:start-451.25 lg:top-601']}>{c.details.web}</a>
      </li>
      <li class="max-lg:flex max-lg:items-center max-lg:gap-[calc(10*var(--u))] lg:contents">
        <img src={phoneIcon.src} width="18.946" height="18.946" alt="" class="max-w-none lg:absolute lg:start-773 lg:top-596" style="width:calc(18.946*var(--u));height:calc(18.946*var(--u))" />
        <a href={`tel:${c.details.phoneHref}`} dir="ltr" class:list={[detail, 'hit lg:absolute lg:start-[calc(800.56*var(--u))] lg:top-[calc(596.69*var(--u))] lg:w-[calc(132.621*var(--u))] lg:h-[calc(22.391*var(--u))]']}>{c.details.phone}</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .field {
    box-sizing: border-box; display: block; margin: 0; border: 0; outline: 0; appearance: none; -webkit-appearance: none;
    background: #ececec; border-radius: calc(10.754 * var(--u));
    width: 100%; height: calc(35 * var(--u)); padding: 0 calc(11 * var(--u));
    font-family: var(--font-gotham); font-weight: 400; font-size: calc(12 * var(--u)); line-height: calc(14 * var(--u));
    color: var(--color-body);
  }
  .field:focus-visible { outline: calc(1 * var(--u)) solid var(--color-navy); }
  .field::placeholder { color: var(--color-body); opacity: 1; font-style: italic; }
  .select { padding-inline-end: calc(26 * var(--u)); cursor: pointer; }
  .select:invalid { color: var(--color-body); }
  /* Figma: chevron 7 x 4.207 at 13 from the field's end edge, 18 below its top (= centre + 0.5 on the 35 tall field, kept
     relative to the centre when the field grows to the 44px touch height). Logical inset, so it sits on the left in RTL. */
  .chev { position: absolute; inset-inline-end: calc(13 * var(--u)); top: calc(50% + 0.5 * var(--u)); width: calc(7 * var(--u)); height: calc(4.207 * var(--u)); max-width: none; pointer-events: none; }
  .area { height: calc(86 * var(--u)); padding: calc(8.94 * var(--u)) calc(7 * var(--u)); resize: none; }
  .field { min-height: 44px; }  /* touch target (scope 2.8): only bites below ~1346px wide, where 35 Figma px < 44px */
  @media (min-width: 1024px) {
    .field { width: calc(322 * var(--u)); }
    .area { width: calc(410 * var(--u)); }
  }

  /* Error lines (no Figma design: the shared form error style, P2) sit under their field on desktop. */
  .cf-err { margin: 0; }
  /* Consent: the real checkbox is invisible but keeps its 44px hit area; the circle is the Figma SVG, the dot is the checked state. */
  .consent { position: relative; cursor: pointer; }
  .consent-input { position: absolute; margin: 0; opacity: 0; width: 44px; height: 44px; inset-inline-start: calc(130 * var(--u) - 22px); top: calc(462 * var(--u) - 22px); cursor: pointer; z-index: 1; }
  .dot { position: absolute; inset-inline-start: calc(4.867 * var(--u)); top: calc(4.867 * var(--u)); width: calc(5.733 * var(--u)); height: calc(5.733 * var(--u)); border-radius: 50%; background: var(--color-navy); opacity: 0; }
  .consent-input:checked ~ .box .dot { opacity: 1; }
  .consent-input:focus-visible ~ .box { outline: calc(1 * var(--u)) solid var(--color-navy); outline-offset: calc(2 * var(--u)); border-radius: 50%; }
  @media (max-width: 1023.98px) {
    .consent-input { position: absolute; inset-inline-start: 0; top: 0; width: 44px; height: 44px; }
    .consent { min-height: 44px; }
  }

  /* Corner art on the navy panel (Figma 86:821-86:825): clip box 242x435, art masked by the SVG, 30% opacity. Mirrored in RTL (physical offsets inside the mirrored box). */
  .art { overflow: hidden; }
  :global([dir='rtl']) .art { scale: -1 1; }
  .art-fill {
    position: absolute; left: calc(17.395 * var(--u)); top: calc(2 * var(--u));
    width: calc(439.223 * var(--u)); height: calc(422.807 * var(--u)); opacity: 0.3;
    background-repeat: no-repeat; background-size: 100% 100%;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: calc(242 * var(--u)) calc(435 * var(--u)); mask-size: calc(242 * var(--u)) calc(435 * var(--u));
    -webkit-mask-position: calc(-17.395 * var(--u)) calc(-2 * var(--u)); mask-position: calc(-17.395 * var(--u)) calc(-2 * var(--u)); mask-mode: alpha;
  }
</style>
