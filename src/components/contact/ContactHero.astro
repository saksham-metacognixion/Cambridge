---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import { content } from '../../lib/content';
import { img, heroLayers } from '../../lib/images';
import { parsePath } from '../../lib/editions';

// Figma 86:433, page y 119, h 437. Spec y values are page y minus 119.
const { edition } = parsePath(Astro.url.pathname);
const c = content('contact/page', edition.locale).hero;
const banner = img(c.banner.image, edition.region);
const layers = heroLayers(c.banner.image, edition.region); // cursor-follow layers (7 Oct 2026), see PageHero
const imgClass = 'absolute start-0 top-0 h-[114.42%] w-full max-w-none object-cover';
const pic = {
  formats: ['avif'], fallbackFormat: 'webp', width: px(1052), height: px(500), widths: [720, 1052],
  sizes: '(min-width: 1440px) 1440px, 100vw', loading: 'eager', decoding: 'async', pictureAttributes: { class: 'contents' },
} as const;
---

<section class="relative" style="--h: 437" aria-label={c.ariaLabel}>
  <div class="stage">
    <!-- Banner PNG is 1052x500 and drawn 114.42% of the 437 box (top-left anchored), exactly as in Figma. -->
    <!-- The people drift with the cursor like the home hero (scripts/hero-follow.ts); the RTL flip sits on the box, not the image. -->
    <div class="hero-media absolute inset-0 overflow-hidden pointer-events-none rtl:-scale-x-100" data-hero-follow={layers ? true : undefined} aria-hidden="true">
      {layers ? (
        <>
          <Picture src={layers.background} alt="" class={imgClass} {...pic} />
          <Picture src={layers.subject} alt={c.banner.alt} fetchpriority="high" data-hero-subject class={imgClass} {...pic} />
        </>
      ) : (
        <Picture src={banner} alt={c.banner.alt} fetchpriority="high" class={imgClass} {...pic} />
      )}
    </div>

    <div class="hero-copy">
      <!-- Figma: Gotham Medium 39 on 37px lines (box 297..371, 2 lines), button at 384 = 13 under it; the line height is
           the inner-page hero one (Hero / PageHero `leading-37`): without it the font's own line box is ~47px and the
           title ran into the button (bug 015). -->
      <h1 class="hero-title relative m-0 font-gotham font-medium text-f39 leading-37 text-navy not-italic whitespace-normal lg:absolute lg:start-95 lg:top-178 lg:w-374">
        <span class="block">{c.title[0]}</span><span class="block">{c.title[1]}</span>
      </h1>

      <!-- Button (bug 044/050): the shared .ui-btn size instead of Figma's 164 x 30 box with an offset 13px label; anchored at
           the Figma start / top on desktop, growing with its label. -->
      <a href={c.button.href} class="ui-btn hit btn-outline hair-card relative no-underline text-navy lg:absolute lg:start-98 lg:top-265" style="--sw:1;--sc:var(--color-cyan)">{c.button.label}</a>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero-follow';
</script>
