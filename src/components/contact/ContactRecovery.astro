---
import { content } from '../../lib/content';
import { parsePath, urlFor } from '../../lib/editions';
import { pagePath } from '../../lib/paths';
import calendar from '../../assets/contact-page/cta-calendar-clock.svg';
import search from '../../assets/contact-page/cta-search.svg';
import message from '../../assets/contact-page/cta-message-share.svg';
import stethoscope from '../../assets/contact-page/cta-stethoscope.svg';
import cornerMask from '../../assets/contact-page/cta-corner-mask.svg';
import cornerFill from '../../assets/contact-page/cta-corner-fill.svg';

// Figma 86:842, page y 1271, h 268. Spec y values are page y minus 1271.
// Layer order as in Figma: navy box, texts, tile 1, corner art, tiles 2-4, then labels and icons.
// Tile icons as in Figma (contact-page-spec.md): calendar-clock = Book, stethoscope = Find a Doctor, magnifier ("Search / Magnifer")
// = Refer a Patient, message-share = Send an Inquiry. Verified against 86:842 on 7 Oct 2026 (bug 029): the magnifier is correct.
// Below 1024px (no Figma frame) the band stacks: copy, then the four tiles in a 2 x 2 grid. On narrow phones a tile is too narrow
// for the unbreakable word "Appointment" (6.69 em in Gotham Medium = 119px at 13 Figma px; bug 029). Fix, all fluid so nothing
// jumps: the box's side padding, the grid gap and the tile's side padding shrink with the band (percent, capped at their Figma
// values), and each tile is a size container whose label font is capped at (tile content width / 6.9), i.e. the longest label word
// always fits with ~3% slack plus the tile padding. From ~400px up the cap is above 13 Figma px and the label keeps its size.
const { edition } = parsePath(Astro.url.pathname);
// Default content = Contact page; other pages (Find a Doctor) pass their own `content` (same layout, other tile labels).
const c = Astro.props.content ?? content('contact/page', edition.locale).recovery;
// Heading top inside the box: 43 on Contact (86:845); 50 on Patient Hub (59:13956) and the Article layout. Other offsets are equal.
const headTop = Astro.props.headTop ?? 43;
// Heading line height: Figma says 'normal', and its 4 lines fill the 109 box (= 27.25 per line). Set explicitly so a
// fallback font with taller 'normal' lines cannot push the heading into the paragraph below it.
const icons = [
  { src: calendar, size: 24, x: 82, y: 10 },
  { src: stethoscope, size: 26, x: 84, y: 9 },
  { src: search, size: 23, x: 83, y: 9 },
  { src: message, size: 26, x: 84, y: 10 },
];
// Tile boxes (194x68) and label offsets inside the tile, in Figma px. Order = Book, Find a Doctor, Refer, Send.
// Tile target: `page` (key in PAGE_PATHS) or `path` (path inside the edition) wins over the literal `href`.
const tileHref = (t: { href: string; path?: string; page?: string }) =>
  t.page !== undefined ? urlFor(edition, pagePath(t.page)) : t.path !== undefined ? urlFor(edition, t.path) : t.href;
const tiles = [
  { x: 527, y: 51, lx: 23, ly: 43 },
  { x: 742, y: 51, lx: 18, ly: 43 },
  { x: 527, y: 152, lx: 19, ly: 41 },
  { x: 742, y: 152, lx: 23, ly: 41 },
].map((d, i) => ({ ...d, ...c.tiles[i], href: tileHref(c.tiles[i]), icon: icons[i] }));
---

<section class="relative" style="--h: 268" aria-label={c.ariaLabel ?? c.lead}>
  <div class="stage max-lg:px-[calc(16*var(--u))]">
    <div class="box absolute start-57 top-0 w-938 h-268 bg-navy rounded-r15 max-lg:static max-lg:w-full max-lg:h-auto max-lg:flex max-lg:flex-col max-lg:gap-[calc(24*var(--u))] max-lg:p-[calc(32*var(--u))] max-lg:mx-auto max-lg:max-w-[calc(938*var(--u))]">
      <h2 class="m-0 font-gotham text-f28 leading-[calc(27.25*var(--u))] text-white not-italic whitespace-normal [word-break:break-word] lg:absolute lg:start-52 lg:top-(--ht) lg:w-331 lg:h-109" style={`--ht:calc(${headTop} * var(--u))`}>
        <span class="font-normal">{c.lead}</span><span class="font-medium">{c.emphasis[0]}<br />{c.emphasis[1]}</span>
      </h2>
      <p class="m-0 font-gotham font-normal text-f12 leading-14 text-white not-italic whitespace-normal [word-break:break-word] lg:absolute lg:start-53 lg:top-172 lg:w-324 lg:h-44">{c.text}</p>

      <!-- Tile backgrounds (desktop): tile 1 sits under the corner art, the other three above it. -->
      {tiles.map((t, i) => (
        <div class:list={['tbg hidden lg:block hair-card absolute w-194 h-68 bg-white rounded-[calc(10*var(--u))]', `tbg-${i}`, i === 0 ? 'z-0' : 'z-[2]']} style={`inset-inline-start:calc(${t.x - 57} * var(--u));top:calc(${t.y} * var(--u));--sw:.15`} aria-hidden="true"></div>
      ))}
      <div class="art hidden lg:block absolute z-[1] start-505 w-433 h-[calc(265.8*var(--u))] top-[calc(-4*var(--u))]" aria-hidden="true">
        <div class="art-fill" style={`background-image:url('${cornerFill.src}');-webkit-mask-image:url('${cornerMask.src}');mask-image:url('${cornerMask.src}')`}></div>
      </div>

      <div class="tiles max-lg:grid max-lg:grid-cols-2 max-lg:gap-[calc(12*var(--u))] lg:contents">
        {tiles.map((t, i) => (
          <a href={t.href} data-tile={i} class="tile hit hair-card relative z-[3] no-underline max-lg:flex max-lg:min-h-[calc(68*var(--u))] max-lg:flex-col max-lg:items-center max-lg:justify-center max-lg:gap-[calc(6*var(--u))] max-lg:bg-white max-lg:rounded-[calc(10*var(--u))] max-lg:p-[calc(8*var(--u))] lg:absolute lg:w-194 lg:h-68" style={`--sw:.15;--hit-w:0px;--hit-h:0px;--lx:${t.lx};--ly:${t.ly};--ix:${t.icon.x};--iy:${t.icon.y};--iw:${t.icon.size};--tx:${t.x - 57};--ty:${t.y}`}>
            <img class="icon max-w-none" src={t.icon.src.src} width={t.icon.size} height={t.icon.size} alt="" style={`width:calc(${t.icon.size}*var(--u));height:calc(${t.icon.size}*var(--u))`} />
            <span class="lbl block font-gotham font-medium text-f13 text-navy-alt text-center not-italic whitespace-nowrap max-lg:whitespace-normal">{t.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .tile::after { border-radius: calc(10 * var(--u)); }
  @media (max-width: 1023.98px) {
    .box { padding-inline: min(calc(32 * var(--u)), 7%); }     /* 32 Figma px from ~670px up, ~19px at 320 */
    .tiles { gap: min(calc(12 * var(--u)), 4%); }               /* 12 Figma px from ~450px up */
    .tile { container-type: inline-size; padding-inline: min(calc(8 * var(--u)), 6%); } /* 8 Figma px from ~180px-wide tiles up */
    .tile .lbl { font-size: min(calc(13 * var(--u)), calc(100cqw / 6.9)); }
  }
  @media (min-width: 1024px) {
    .tile { inset-inline-start: calc(var(--tx) * var(--u)); top: calc(var(--ty) * var(--u)); background: transparent; }
    .tile .icon { position: absolute; inset-inline-start: calc(var(--ix) * var(--u)); top: calc(var(--iy) * var(--u)); }
    .tile .lbl { position: absolute; inset-inline-start: calc(var(--lx) * var(--u)); top: calc(var(--ly) * var(--u)); width: calc(148 * var(--u)); height: calc(15 * var(--u)); }
    .tile::after { display: none; }
    /* the tile box (border + hit) is drawn by the background div; only icon, label and the link area live here */
  }
  /* Hover, as on the live CTA tiles: white -> #e7e7e7 fill, the live theme's link transition (0.12s cubic-bezier(.455,.03,.515,.955)).
     Desktop draws the tile box on a separate background div (tile 1 sits under the corner art), so the hovered link recolours its div. */
  .tile, .tbg { transition: background-color 0.12s cubic-bezier(0.455, 0.03, 0.515, 0.955); }
  @media (hover: hover) {
    @media (max-width: 1023.98px) { .tile:hover { background-color: var(--color-mist); } }
    .box:has([data-tile='0']:hover) .tbg-0, .box:has([data-tile='1']:hover) .tbg-1,
    .box:has([data-tile='2']:hover) .tbg-2, .box:has([data-tile='3']:hover) .tbg-3 { background-color: var(--color-mist); }
  }
  @media (prefers-reduced-motion: reduce) { .tile, .tbg { transition: none; } }
  .art { overflow: hidden; }
  :global([dir='rtl']) .art { scale: -1 1; }
  .art-fill {
    position: absolute; left: calc(17.395 * var(--u)); top: calc(-127.28 * var(--u));
    width: calc(439.223 * var(--u)); height: calc(445.086 * var(--u)); opacity: 0.3;
    background-repeat: no-repeat; background-size: 100% 100%;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: calc(433 * var(--u)) calc(266.622 * var(--u)); mask-size: calc(433 * var(--u)) calc(266.622 * var(--u));
    -webkit-mask-position: calc(-17.395 * var(--u)) calc(127.28 * var(--u)); mask-position: calc(-17.395 * var(--u)) calc(127.28 * var(--u)); mask-mode: alpha;
  }
</style>
