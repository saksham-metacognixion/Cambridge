---
import { content, t } from '../../lib/content';
import { parsePath } from '../../lib/editions';
import { defaultCountry } from '../../lib/doctor-filters';
import { allDoctors, specialties } from '../../lib/doctors';
import RegionPills from '../shared/RegionPills.astro';
import Combobox from '../shared/Combobox.astro';

/*
 * Filters row, Figma 62:783 (pills) + 62:186 / 62:190 (boxes). Page y 586..621, boxes 311 x 35, radius 10, 0.5px #418ea2.
 * The country pills are buttons (aria-pressed); the name and specialty boxes are the shared custom dropdown (bug 053,
 * Combobox.astro: the browser's datalist / select lists looked different in every browser). Options come from the doctor
 * data; the script offers only those that fit the other filters (bug 052).
 * A hospital filter is NOT shown: it is not in Figma (the logic supports it, see src/lib/doctor-filters.ts).
 * Behaviour: src/scripts/doctor-filters.ts. Without JS the controls do nothing and the default list stays.
 */
const { edition } = parsePath(Astro.url.pathname);
const c = content('doctors/page', edition.locale).filters;
const active = defaultCountry(edition.region);
const names = [...new Set(allDoctors.map((d) => t(d.name, edition.locale, 'doctors')))].map((n) => ({ value: n, label: n }));
const specialtyOpts = specialties.map((s) => ({ value: s.id, label: t(s.name, edition.locale, 'specialties') }));
const empty = content('doctors/page', edition.locale).results.empty;
---

<div class="filters" role="search" aria-label={c.ariaLabel}>
  <RegionPills options={c.countries} active={active} label={c.countryLabel} class="df-pills" />

  <Combobox id="df-name" name="q" label={c.nameLabel} options={names} editable emptyText={empty} clearLabel={c.clearName} />
  <Combobox id="df-specialty" name="specialty" label={c.specialtyLabel} options={specialtyOpts} emptyText={empty} clearable clearLabel={c.clearSpecialty} />
</div>

<style>
  .filters { display: flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: calc(12 * var(--u)); padding-inline: calc(16 * var(--u)); }
  .filters :global(.cb) { width: calc(311 * var(--u)); }
  /* Bug 159 (15 Oct 2026): below 1024 the two 311-unit boxes were centred in the gutter (426px wide at 768 while the card grid
     fills the box). The row is the same cell grid as the cards (1 per row on phones, 2 on tablets), the boxes fill their cells and
     the country pills keep a centred row of their own above them. */
  @media (max-width: 1023.98px) {
    .filters { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, calc(240 * var(--u))), 1fr)); padding-inline: 16px; }
    .filters :global(.df-pills) { grid-column: 1 / -1; justify-self: center; }
    .filters :global(.cb) { width: auto; min-width: 0; }
  }
  @media (min-width: 1024px) {
    .filters { flex-wrap: nowrap; justify-content: flex-start; gap: calc(12 * var(--u)); width: calc(955 * var(--u)); margin-inline: calc(48 * var(--u)) 0; padding-inline: 0; }
    .filters :global(.df-pills) { margin-inline-end: calc(30 * var(--u)); } /* 42 from the pills' right edge to the first box, minus the 12 flex gap */
  }
</style>
