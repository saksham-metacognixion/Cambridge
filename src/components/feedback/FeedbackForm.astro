---
/*
 * Patient Feedback Form — Figma 188:964 (intro text + white card), spec figma-cache/forms-spec.md. Scope form
 * "Contact / Feedback"; posts to `feedback` (inbox FORM_TO_FEEDBACK). Values are Figma px from the card's top-left
 * (card = page x 53, y 599). Every question is a radio group (fieldset + legend); the satisfaction rows are announced
 * as "<statement>, <column>" (the column headers are drawn once, visually). Figma draws all five "recommend" options
 * as selected (a state sample): nothing is preselected; unselected circles use the grey of the matrix circles.
 * Bug 095: the five satisfaction levels are sentiment faces (RatingFace.astro, one shared sprite; provisional, F095) on the
 * real radio inputs. Bug 094: compact desktop layout (one-line rows, horizontal recommend options, shorter textarea, tighter
 * gaps): the form went from ~1491 to ~700 px at 1366 x 768; phones / tablets keep their stacked layout.
 */
import FormShell from '../forms/FormShell.astro';
import RatingFace from './RatingFace.astro';
import DialSelect from '../forms/DialSelect.astro';
import CenteredIntro from '../shared/CenteredIntro.astro';
import { content } from '../../lib/content';
import { commonText, fieldsIn, fieldId, sourceOptions, splitStar } from '../../lib/forms';
import { parsePath } from '../../lib/editions';
import radioOn from '../../assets/forms/feedback-radio-on.svg';
import radioOff from '../../assets/forms/feedback-radio-off.svg';
import chevHospital from '../../assets/forms/feedback-chevron-hospital.svg';
import '../forms/forms.css';

const ID = 'feedback';
const { edition } = parsePath(Astro.url.pathname);
const c = content('forms/feedback', edition.locale);
const common = commonText(edition.locale);
const id = (n: string) => fieldId(ID, n);
const contact = Object.fromEntries(fieldsIn(ID, 'contact').map((f) => [f.name, f]));
const recommend = fieldsIn(ID, 'recommend')[0];
const matrix = fieldsIn(ID, 'matrix');
const message = fieldsIn(ID, 'message')[0];
const hospitals = sourceOptions('hospitals', edition);
const lbl = (name: string) => splitStar(c.fields[name].label);
const cols = matrix[0]?.options ?? [];
// English fallback text on an Arabic page (no Arabic yet, CT31) is tagged lang="en", so it hyphenates as English and screen readers read it as English
const enLang = (s: string) => (edition.locale !== 'en' && !/[؀-ۿ]/.test(s) ? 'en' : undefined);
---

<section class="fb" aria-labelledby="feedback-title">
  <!-- Intro: the client's "We’re Listening" heading + one line (5 Oct 2026) in the shared centred intro block (H2 Medium 28 + Book 12/14), centred on the card. -->
  <div class="intro">
    <CenteredIntro id="feedback-intro" heading={c.intro.heading} text={c.intro.text} cx={530} tx={530} />
  </div>

  <div class="card pf-card">
    <FormShell
      id={ID}
      edition={edition}
      submit={c.submit}
      ariaLabel={c.ariaLabel}
      gaps={{ consent: 10, submit: 12 }}
      class="pf"
    >
      <!-- Name / Hospital / Mobile / Email: rows at 69 and 123, columns at 47 and 512 -->
      <div class="contact">
        {contact.name && (
          <div class="pf-field" data-field="name">
            <div class="pf-row" style="--at:84.55">
              <label for={id('name')} class="pf-label">{lbl('name')[0]}<span aria-hidden="true">{lbl('name')[1]}</span></label>
              <input id={id('name')} name="name" type="text" required={contact.name.required} maxlength={contact.name.max} autocomplete="name" aria-describedby={`${id('name')}-error`} class="pf-box" style="--w:319.889" />
            </div>
            <p id={`${id('name')}-error`} class="f-err" hidden></p>
          </div>
        )}
        {contact.hospital && (
          <div class="pf-field" data-field="hospital">
            <div class="pf-row" style="--at:84.55">
              <label for={id('hospital')} class="pf-label">{lbl('hospital')[0]}<span aria-hidden="true">{lbl('hospital')[1]}</span></label>
              <div class="pf-select" style="--w:319.889">
                <select id={id('hospital')} name="hospital" required={contact.hospital.required} aria-describedby={`${id('hospital')}-error`} class="pf-box">
                  <option value="" selected></option>
                  {hospitals.map((h) => <option value={h.value}>{h.label}</option>)}
                </select>
                <img loading="lazy" src={chevHospital.src} alt="" width="7.24" height="4.207" class="pf-chev" />
              </div>
            </div>
            <p id={`${id('hospital')}-error`} class="f-err" hidden></p>
          </div>
        )}
        {contact.mobile && (
          <div class="pf-field mobile" data-field="mobile">
            <div class="pf-row" style="--at:87.08">
              <label for={id('mobile')} class="pf-label">{lbl('mobile')[0]}<span aria-hidden="true">{lbl('mobile')[1]}</span></label>
              <DialSelect name="mobile" edition={edition} label={common.dialCodeLabel} variant="page" />
              <input id={id('mobile')} name="mobile" type="tel" inputmode="tel" dir="ltr" required={contact.mobile.required} maxlength={contact.mobile.max} autocomplete="tel-national" placeholder={c.fields.mobile.placeholder} aria-describedby={`${id('mobile')}-error`} class="pf-box pf-tel" style="--w:232.587" />
            </div>
            <p id={`${id('mobile')}-error`} class="f-err" hidden></p>
          </div>
        )}
        {contact.email && (
          <div class="pf-field" data-field="email">
            <div class="pf-row" style="--at:87.13">
              <label for={id('email')} class="pf-label">{lbl('email')[0]}<span aria-hidden="true">{lbl('email')[1]}</span></label>
              <input id={id('email')} name="email" type="email" required={contact.email.required} maxlength={contact.email.max} autocomplete="email" aria-describedby={`${id('email')}-error`} class="pf-box" style="--w:316.489" />
            </div>
            <p id={`${id('email')}-error`} class="f-err" hidden></p>
          </div>
        )}
      </div>

      {matrix.length > 0 && (
        <div class="matrix">
          <RatingFace sprite />
          <!-- Question + column names on one line (desktop): the question takes the label column above the row labels -->
          <div class="m-top">
            <p class="pf-q q2">{c.matrix.label}</p>
            <div class="m-head" aria-hidden="true">
              {cols.map((o) => <span class="m-col">{c.matrix.columns[o].map((l: string) => <span class="block">{l}</span>)}</span>)}
            </div>
          </div>
          {matrix.map((f) => (
            <fieldset class="m-row" data-field={f.name} aria-describedby={`${id(f.name)}-error`}>
              <legend class="m-legend">{c.fields[f.name].label.map((l: string) => <span class="block">{l}</span>)}</legend>
              <div class="m-cells">
                {f.options!.map((o) => (
                  <label class="m-cell">
                    <input class="sr-only" type="radio" name={f.name} value={o} required={f.required} />
                    <RatingFace level={o} />
                    <span class="m-name" lang={enLang(c.matrix.columns[o].join(' '))} dir={enLang(c.matrix.columns[o].join(' ')) && 'ltr'}>{c.matrix.columns[o].map((l: string, k: number) => <span class="block">{k > 0 && ' '}{l}</span>)}</span>
                  </label>
                ))}
              </div>
              <p id={`${id(f.name)}-error`} class="f-err" hidden></p>
            </fieldset>
          ))}
        </div>
      )}

      {recommend && (
        <fieldset class="recommend" data-field={recommend.name} aria-describedby={`${id(recommend.name)}-error`}>
          <legend class="pf-q">{c.fields[recommend.name].label}</legend>
          <div class="nps">
            {recommend.options!.map((o) => (
              <label class="nps-opt">
                <input class="sr-only" type="radio" name={recommend.name} value={o} required={recommend.required} />
                <span class="pf-radio" aria-hidden="true"><img loading="lazy" class="off" src={radioOff.src} alt="" width="16.279" height="16.467" /><img loading="lazy" class="on" src={radioOn.src} alt="" width="16.279" height="16.467" /></span>
                <span>{c.fields[recommend.name].options[o]}</span>
              </label>
            ))}
          </div>
          <p id={`${id(recommend.name)}-error`} class="f-err" hidden></p>
        </fieldset>
      )}

      {message && (
        <div class="improve" data-field={message.name}>
          <label for={id(message.name)} class="pf-q q3">{c.fields[message.name].label}</label>
          <textarea id={id(message.name)} name={message.name} required={message.required} maxlength={message.max} placeholder={c.fields[message.name].placeholder} aria-describedby={`${id(message.name)}-error`} class="pf-box pf-area"></textarea>
          <p id={`${id(message.name)}-error`} class="f-err" hidden></p>
        </div>
      )}
    </FormShell>
  </div>
</section>

<style>
  /* Intro: heading + line centred on page x 530, top 502 (61 below the hero); card at 599 (the intro box keeps its 97 height) */
  .fb { box-sizing: border-box; max-inline-size: calc(var(--max-w) * 1px); margin-inline: auto; padding-block-start: calc(61 * var(--u)); }
  .intro { min-block-size: calc(97 * var(--u)); position: relative; inset-inline-start: calc(4 * var(--u)); }
  /* Bug 094: the card hugs the compact form (was the Figma 1179 tall, padding 69 / 49) */
  .card {
    position: relative; inset-inline-start: calc(4 * var(--u)); box-sizing: border-box;
    inline-size: calc(954 * var(--u)); max-inline-size: calc(100% - 32px); margin-inline: auto;
    padding: calc(40 * var(--u)) calc(37.6 * var(--u)) calc(32 * var(--u)) calc(47 * var(--u));
  }
  .card :global(.pf) { color: var(--color-navy); }
  /* SUBMIT: the shared .ui-btn, centred on the content box (bugs 044 / 050) */

  /* Fields: fill rgba(217,217,217,.5), radius --radius-field (bug 049), h 35; labels Gotham Book 15 / 18.82, text 8 below the box top */
  .contact { display: grid; grid-template-columns: calc(465 * var(--u)) minmax(0, 1fr); row-gap: calc(12 * var(--u)); align-items: start; }
  .mobile .pf-row { margin-inline-start: calc(1 * var(--u)); }

  fieldset { margin: 0; padding: 0; border: 0; min-inline-size: 0; }
  /* Order (client's form, 5 Oct 2026): satisfaction matrix first, then the recommend question, then "Tell us more".
     Bug 094 (desktop): blocks 14-16 Figma px apart instead of 22-63; the recommend options on one line. */
  .recommend { margin-block-start: calc(16 * var(--u)); }
  .recommend > legend { float: inline-start; inline-size: 100%; margin-block-end: calc(6 * var(--u)); }
  .nps { clear: both; display: flex; flex-wrap: wrap; column-gap: calc(30 * var(--u)); row-gap: calc(8 * var(--u)); }
  .nps-opt { display: flex; align-items: center; gap: calc(8.19 * var(--u)); inline-size: max-content; min-block-size: calc(22 * var(--u)); cursor: pointer; font-size: calc(15 * var(--u)); line-height: calc(18.82 * var(--u)); }

  /* Satisfaction matrix (bug 094): the question shares a line with the column names; each row is one line (label column =
     the width left of the five 88-wide columns), face rows 26 apart. Legends wrap rather than clip if a label is longer. */
  .matrix { --cell: calc(88 * var(--u)); --face-size: 22; margin-block-start: calc(16 * var(--u)); }
  .m-top { display: flex; align-items: flex-end; }
  .q2 { flex: 1 1 auto; min-inline-size: 0; padding-inline-end: calc(12 * var(--u)); padding-block-end: calc(2 * var(--u)); }
  .m-head { display: flex; flex: none; font-size: calc(13 * var(--u)); line-height: calc(16 * var(--u)); text-align: center; }
  .m-col { inline-size: var(--cell); }
  .m-row { margin-block-start: calc(10 * var(--u)); }
  .m-row + .m-row { margin-block-start: calc(4 * var(--u)); }
  .m-legend { float: inline-start; box-sizing: border-box; inline-size: calc(100% - 5 * var(--cell)); min-block-size: calc(var(--face-size) * var(--u)); padding: calc(2 * var(--u)) 0 0; padding-inline-end: calc(12 * var(--u)); font-size: calc(14 * var(--u)); line-height: calc(18 * var(--u)); }
  .m-cells { display: flex; }
  .m-cell { position: relative; display: flex; justify-content: center; align-items: center; inline-size: var(--cell); min-block-size: calc(var(--face-size) * var(--u)); cursor: pointer; }
  .m-name { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .m-cell::before { content: ''; position: absolute; inset-block-start: 50%; inset-inline-start: 50%; translate: -50% -50%; inline-size: 44px; block-size: 44px; }   /* 44px hit area */
  :global([dir='rtl']) .m-cell::before { translate: 50% -50%; }
  .m-row .f-err { clear: both; }

  /* Sentiment faces (bug 095, RatingFace.astro; colours provisional in src/data/rating-faces.json). Unselected: Deep Teal face on
     a light tint of its level colour; hover: a stronger tint; selected: the full colour + a Deep Teal ring (white gap), so the
     choice shows on every colour; keyboard focus: a dashed Deep Teal outline outside the ring. Forced colours: a system ring. */
  .m-cell :global(.rface) {
    --face-fill: color-mix(in srgb, var(--face) 22%, #fff);
    flex: none; display: block; inline-size: calc(var(--face-size) * var(--u)); block-size: calc(var(--face-size) * var(--u)); border-radius: 50%; color: var(--color-navy);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .m-cell:hover :global(.rface) { --face-fill: color-mix(in srgb, var(--face) 50%, #fff); }
  .m-cell input:checked + :global(.rface) { --face-fill: var(--face); transform: scale(1.12); box-shadow: 0 0 0 calc(1.5 * var(--u)) #fff, 0 0 0 calc(3 * var(--u)) var(--color-navy); }
  .m-cell input:focus-visible + :global(.rface) { outline: calc(1.5 * var(--u)) dashed var(--color-navy); outline-offset: calc(5 * var(--u)); }
  @media (forced-colors: active) {
    .m-cell input:checked + :global(.rface) { outline: 3px solid Highlight; outline-offset: 2px; }
  }
  @media (prefers-reduced-motion: reduce) { .m-cell :global(.rface) { transition: none; } }

  /* Tell us more (bug 094): the box 72 Figma px tall (~5 lines) instead of 194; radius --radius-field (bug 049), placeholder Book 11 */
  .improve { margin-block-start: calc(14 * var(--u)); }
  .q3 { margin-block-end: calc(6 * var(--u)); }
  .pf-area { inline-size: calc(797 * var(--u)); block-size: calc(72 * var(--u)); margin-inline-start: calc(3 * var(--u)); border-radius: var(--radius-field); padding: calc(12 * var(--u)) calc(18 * var(--u)); resize: vertical; font-size: calc(11 * var(--u)); line-height: calc(14 * var(--u)); }
  .card :global(.f-consent) { margin-inline-start: calc(3 * var(--u)); }

  /* Below 1024: one column; the satisfaction rows show each column name under its face */
  @media (max-width: 1023.98px) {
    .card { inline-size: auto; inset-inline-start: 0; padding: 24px 16px; }
    .intro { inset-inline-start: 0; min-block-size: 0; margin-block-end: 24px; }
    .contact { grid-template-columns: minmax(0, 1fr); row-gap: calc(19 * var(--u)); }
    .matrix { margin-block-start: 32px; }
    .m-top { display: block; }
    .m-head { display: none; }
    .q2, .recommend > legend { inline-size: auto; padding: 0; margin-block-end: 12px; }
    .m-row, .m-row + .m-row { margin-block-start: 20px; }
    .m-legend { float: none; inline-size: auto; min-block-size: 0; padding: 0; margin-block-end: 8px; font-size: calc(15 * var(--u)); line-height: calc(18.82 * var(--u)); }
    .m-cells { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; padding: 0; }
    .m-cell { margin: 0; inline-size: auto; flex-direction: column; align-items: center; justify-content: flex-start; gap: 6px; min-block-size: 44px; padding-block-start: 4px; }
    /* Five columns are narrower than "Dissatisfied" up to ~375 px: it breaks at the soft hyphens in feedback.en.json ("Dissatis-fied")
       instead of anywhere ("Dissatisfie/d", mobile QA M1, 13 Oct 2026); each label line is its own block so "Very" never pulls half
       a word up next to it. `hyphens: auto` was not used: Chrome / Firefox did not hyphenate here. */
    .m-name { position: static; inline-size: auto; block-size: auto; clip-path: none; white-space: normal; overflow-wrap: anywhere; text-align: center; font-size: calc(8 * var(--u)); line-height: 1.2; }
    .m-cell input:checked ~ .m-name { font-weight: 500; }
    .m-cell::before { display: none; }
    .recommend { margin-block-start: 32px; }
    /* Recommend options: each row a full-width 44 px tap target (was 18.82u = 26 px, mobile QA M2); stacked on phones / tablets */
    .nps { flex-direction: column; flex-wrap: nowrap; gap: 0; }
    .nps-opt { inline-size: 100%; min-block-size: 44px; }
    .improve { margin-block-start: 28px; }
    .pf-area { block-size: calc(96 * var(--u)); }
    .pf-area, .card :global(.f-consent) { margin-inline-start: 0; inline-size: 100%; }
  }
  @media (max-width: 767.98px) {
    .mobile .pf-row { grid-template-columns: auto minmax(0, 1fr); margin-inline-start: 0; }
  }
</style>
