---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import { content } from '../../lib/content';
import { img, heroLayers } from '../../lib/images';
import { parsePath } from '../../lib/editions';

// Figma 188:964 hero: image "PAR-inside 1" 1052x323 at page y 118 (1 under the header). Values: page y minus 118.
// Title (95,100) Gotham Medium 39 / 37 (the line height the other heroes use), w 385 | button at (98,180): the shared .ui-btn (bug 044/050; Figma 164x30).
// The client's text (5 Oct 2026) adds a paragraph under the title: the shared inner-page hero text style (Book 12/14 #6b6b6b,
// w374 at x97, 13 below the title; button 17 below it, as on the condition pages), flow layout.
// The image in Figma is only 1052x323 (no larger original), and there is no KSA (red ghutra) version yet:
// add one as src/assets/regions/sa/forms/feedback-hero.png and it is used on /sa automatically.
const { edition } = parsePath(Astro.url.pathname);
const c = content('forms/feedback', edition.locale).hero;
const banner = img(c.image, edition.region);
const layers = heroLayers(c.image, edition.region); // cursor-follow layers (7 Oct 2026), see PageHero
const imgClass = 'absolute start-0 top-0 h-full w-full max-w-none object-cover object-[100%_0]';
const pic = {
  formats: ['avif'], fallbackFormat: 'webp', width: px(1052), height: px(323), widths: [720, 1052],
  sizes: '(min-width: 1440px) 1440px, 100vw', loading: 'eager', decoding: 'async', alt: '', pictureAttributes: { class: 'contents' },
} as const;
---

<section class="hero relative" aria-labelledby="feedback-title">
  <!-- The person drifts with the cursor like the home hero (scripts/hero-follow.ts); the RTL flip sits on the box, not the image. -->
  <div class="hero-media absolute inset-0 overflow-hidden pointer-events-none rtl:-scale-x-100" data-hero-follow={layers ? true : undefined} aria-hidden="true">
    {layers ? (
      <>
        <Picture src={layers.background} class={imgClass} {...pic} />
        <Picture src={layers.subject} fetchpriority="high" data-hero-subject class={imgClass} {...pic} />
      </>
    ) : (
      <Picture src={banner} fetchpriority="high" class={imgClass} {...pic} />
    )}
  </div>
  <div class="inner relative">
    <h1 id="feedback-title" class="title hero-title m-0 font-gotham font-medium text-f39 leading-37 text-navy not-italic">{c.title.map((line: string) => <span class="block">{line}</span>)}</h1>
    {c.text && <p class="text m-0 font-gotham font-normal text-f12 leading-14 text-body not-italic">{c.text}</p>}
    <a href={c.button.href} class="btn ui-btn hit btn-outline hair-card relative no-underline text-navy" style="--sw:1;--sc:var(--color-cyan)">{c.button.label}</a>
  </div>
</section>

<script>
  import '../../scripts/hero-follow';
</script>

<style>
  .hero { min-block-size: calc(323 * var(--u)); margin-block-start: calc(-1 * var(--u)); }
  @media (max-width: 1023.98px) { .hero { min-block-size: 0; } }
  .inner { box-sizing: border-box; max-inline-size: calc(var(--target-w) * 1px); margin-inline: auto; padding-block: calc(100 * var(--u)) calc(24 * var(--u)); padding-inline-start: calc(95 * var(--u)); }
  .title { inline-size: calc(385 * var(--u)); max-inline-size: 100%; min-block-size: calc(80 * var(--u)); }
  .text { inline-size: calc(374 * var(--u)); max-inline-size: 100%; margin-block-start: calc(13 * var(--u)); margin-inline-start: calc(2 * var(--u)); overflow-wrap: anywhere; }
  .title + .btn { margin-block-start: 0; }
  .text + .btn { margin-block-start: calc(17 * var(--u)); }
  .btn { margin-inline-start: calc(3 * var(--u)); } /* size, label, corners: the shared .ui-btn (bug 044/050; Figma 164 x 30, label 13) */
  @media (max-width: 1023.98px) {
    .inner { padding-inline: calc(24 * var(--u)); padding-block: calc(28 * var(--u)) calc(40 * var(--u)); }
    .title { inline-size: auto; max-inline-size: 100%; min-block-size: 0; }
    .btn { margin-block-start: 12px; }
  }
</style>
