      </g>
    </symbol>
  </svg>
) : conf && (
  <svg class="rface" viewBox="0 0 20 20" aria-hidden="true" focusable="false" data-level={key} style={`--face:${conf.color}`}><use href={`#rface-${conf.face}`} /></svg>
)}
