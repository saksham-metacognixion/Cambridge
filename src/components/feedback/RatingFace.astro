---
/*
 * Sentiment face of one rating level (bug 095), or with `sprite` the five face drawings once per page (<symbol>s), which
 * every face then <use>s: the 30 matrix cells share one copy of the SVG paths. Face + colour per option value:
 * src/data/rating-faces.json (provisional; its `aliases` map the pop-up's excellent / good / medium / poor onto the same levels).
 * The sprite is rendered once per page by forms/Modals.astro (outside the closed dialogs). Decorative: the radio input next to it carries the accessible name.
 *
 * Drawings (viewBox = the Figma 19.443 face box): Very Satisfied / Satisfied / Neutral = the Figma pop-up faces Excellent /
 * Good / Medium (112:7878, src/assets/forms/opinion-face-*.svg); Very Dissatisfied = Figma Poor (its 21.211 box cropped
 * to the same circle); Dissatisfied = Good with the mouth turned down. Outline + features: currentColor (Deep Teal);
 * the disc behind: --face-fill (set by the page from the level colour and the selected state).
 */
import faces from '../../data/rating-faces.json';

interface Props {
  level?: string;
  sprite?: boolean;
}
const { level, sprite } = Astro.props;
const key = level && ((faces.aliases as Record<string, string>)[level] ?? level);
const conf = key ? (faces.levels as Record<string, { face: string; color: string }>)[key] : undefined;
if (level && !conf) throw new Error(`rating-faces.json has no level "${level}"`);
const disc = 'fill:var(--face-fill, transparent)';
const line = { fill: 'none', stroke: 'currentColor', 'stroke-width': '1.76758', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
const eyes = 'M7.07034 7.07034H7.07917M12.3731 7.07034H12.3819';
const ring = 'M18.5596 9.72171C18.5596 14.6028 14.6028 18.5596 9.72171 18.5596C4.84066 18.5596 0.883792 14.6028 0.883792 9.72171C0.883792 4.84066 4.84066 0.883792 9.72171 0.883792C14.6028 0.883792 18.5596 4.84066 18.5596 9.72171Z';
---

{sprite ? (
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute;overflow:hidden">
    <symbol id="rface-very-satisfied" viewBox="0 0 19.4434 19.4434">
      <circle cx="9.72171" cy="9.72171" r="8.838" style={disc} />
      <path {...line} d={`${eyes}${ring}M15.0245 10.6055C14.8136 11.8538 14.1631 12.9855 13.1905 13.7959C12.218 14.6064 10.9876 15.0422 9.72171 15.0245C8.45586 15.0422 7.22544 14.6064 6.25289 13.7959C5.28034 12.9855 4.62983 11.8538 4.41896 10.6055H15.0245Z`} />
    </symbol>
    <symbol id="rface-satisfied" viewBox="0 0 19.4434 19.4434">
      <circle cx="9.72171" cy="9.72171" r="8.838" style={disc} />
      <path {...line} d={`M6.18654 11.4893C6.18654 11.4893 7.51223 13.2569 9.72171 13.2569C11.9312 13.2569 13.2569 11.4893 13.2569 11.4893${eyes}${ring}`} />
    </symbol>
    <symbol id="rface-neutral" viewBox="0 0 19.4434 19.4434">
      <circle cx="9.72171" cy="9.72171" r="8.838" style={disc} />
      <path {...line} d={`M6.18654 12.3731H13.2569${eyes}${ring}`} />
    </symbol>
    <symbol id="rface-dissatisfied" viewBox="0 0 19.4434 19.4434">
      <circle cx="9.72171" cy="9.72171" r="8.838" style={disc} />
      <path {...line} d={`M6.18654 13.2569C6.18654 13.2569 7.51223 11.4893 9.72171 11.4893C11.9312 11.4893 13.2569 13.2569 13.2569 13.2569${eyes}${ring}`} />
    </symbol>
    <symbol id="rface-very-dissatisfied" viewBox="0.883792 0.883792 19.4434 19.4434">
      <circle cx="10.6055" cy="10.6055" r="8.838" style={disc} />
      <g fill="currentColor">
        <path d="M18.5596 10.6055C18.5596 6.21256 14.9985 2.65138 10.6055 2.65138C6.21256 2.65138 2.65138 6.21256 2.65138 10.6055C2.65138 14.9985 6.21256 18.5596 10.6055 18.5596C14.9985 18.5596 18.5596 14.9985 18.5596 10.6055ZM20.3272 10.6055C20.3272 15.9747 15.9747 20.3272 10.6055 20.3272C5.23635 20.3272 0.883792 15.9747 0.883792 10.6055C0.883792 5.23635 5.23635 0.883792 10.6055 0.883792C15.9747 0.883792 20.3272 5.23635 20.3272 10.6055Z" />
        <path d="M12.0244 9.76832C12.2427 9.33175 12.7737 9.15474 13.2103 9.37303L14.9779 10.2568C15.4144 10.4751 15.5914 11.0061 15.3731 11.4427C15.1549 11.8793 14.6239 12.0563 14.1873 11.838L12.4197 10.9542C11.9831 10.7359 11.8061 10.2049 12.0244 9.76832Z" />
        <path d="M7.55884 9.37303C7.99541 9.15474 8.52642 9.33175 8.74471 9.76832C8.963 10.2049 8.78599 10.7359 8.34942 10.9542L6.58183 11.838C6.14526 12.0563 5.61425 11.8793 5.39597 11.4427C5.17768 11.0061 5.35468 10.4751 5.79125 10.2568L7.55884 9.37303Z" />
