---
/*
 * Your Opinion Matters pop-up — Figma 112:7878, spec figma-cache/forms-spec.md. Scope form "Contact / Feedback";
 * posts to feedback-popup (inbox FORM_TO_FEEDBACK). Opened by every #your-opinion link (header top bar, footer).
 * Panel 586 wide; values are Figma px from the panel's top-left. Each rating row is a radio group (fieldset + legend);
 * Figma shows one selected face per row as a colour sample, so nothing is preselected.
 * Bug 095 (reopened 14 Oct 2026): the faces are the shared sentiment faces of the Patient Feedback page (RatingFace.astro,
 * colours in src/data/rating-faces.json, provisional F095) on the real radio inputs: tinted when unselected, full colour +
 * ring when selected. Bug 094 (reopened): compact desktop spacing, so the whole form + Submit fits a 1366 x 768 laptop
 * (765 -> ~600 px); below 1024 the stacked layout scrolls as before.
 */
import Modal from './Modal.astro';
import FormShell from './FormShell.astro';
import GlassField from './GlassField.astro';
import { content } from '../../lib/content';
import { commonText, fieldsIn, fieldId } from '../../lib/forms';
import type { Edition } from '../../lib/editions';
import RatingFace from '../feedback/RatingFace.astro';

interface Props { edition: Edition }
const { edition } = Astro.props;
const ID = 'feedback-popup';
const c = content('forms/opinion', edition.locale);
const common = commonText(edition.locale);
const shared = { form: ID, edition, dialLabel: common.dialCodeLabel };
---

<Modal id={ID} titleId={`${ID}-title`} closeLabel={common.close} panelClass="p-opinion">
  <h2 id={`${ID}-title`} class="gf-title o-title">{c.title}</h2>
  <FormShell
    id={ID}
    edition={edition}
    submit={c.submit}
    ariaLabelledby={`${ID}-title`}
    gaps={{ consent: 14, submit: 12 }}
  >
    <div class="f-split o-split">
      <div class="o-left">
        <div class="o-choose">
          {fieldsIn(ID, 'choose').map((f) => <GlassField {...shared} field={f} text={c.fields[f.name] ?? {}} />)}
        </div>
        <p class="gf-section o-section">{c.section}</p>
        <div class="o-details">
          {fieldsIn(ID, 'details').map((f) => <GlassField {...shared} field={f} text={c.fields[f.name] ?? {}} />)}
        </div>
      </div>
      <div class="o-card">
        {fieldsIn(ID, 'ratings').map((f) => {
          const err = `${fieldId(ID, f.name)}-error`;
          return (
            <fieldset class="o-rate" data-field={f.name} aria-describedby={err}>
              <legend class="o-legend">{c.fields[f.name].label}</legend>
              <div class="o-opts">
                {f.options!.map((o) => (
                  <label class="o-opt hit">
                    <input class="sr-only" type="radio" name={f.name} value={o} required={f.required} />
                    <RatingFace level={o} />
                    <span class="o-txt">{c.ratingOptions[o]}</span>
                  </label>
                ))}
              </div>
              <p id={err} class="f-err" hidden></p>
            </fieldset>
          );
        })}
      </div>
    </div>
    {fieldsIn(ID, 'message').map((f) => (
      <div class="o-message">
        <GlassField {...shared} field={f} text={c.fields[f.name] ?? {}} area={{ w: 499, h: 64, px: 13.4, py: 10, fs: 10 }} />
      </div>
    ))}
  </FormShell>
</Modal>

<style>
  /* Panel 586 wide (Figma 112:7878). Content box x 32..531 (textarea); left column at 36, card at 326.
     Bug 094 (reopened 14 Oct 2026): vertical spacing compacted from the Figma 564 tall panel (765 px at 1366) so the whole form
     and Submit fit a 1366 x 768 laptop: padding 30 / 24 -> 20 / 18, title box 54 -> 34, field gaps 11.72 -> 7, rating rows
     17 -> 9 apart, textarea 100 -> 64. Widths, type sizes and controls are the Figma ones. */
  :global(.p-opinion) { inline-size: calc(586 * var(--u)); padding: calc(20 * var(--u)) calc(55 * var(--u)) calc(18 * var(--u)) calc(32 * var(--u)); }
  /* Title centred on the panel */
  .o-title { min-block-size: calc(34 * var(--u)); margin-inline: calc(-32 * var(--u)) calc(-55 * var(--u)); }
  .o-split { display: grid; grid-template-columns: calc(270 * var(--u)) calc(205.04 * var(--u)); column-gap: calc(24 * var(--u)); align-items: start; }
  .o-left { padding-inline-start: calc(4 * var(--u)); }
  /* Selects, "Your Details:", then the details rows */
  .o-choose { display: flex; flex-direction: column; gap: calc(7 * var(--u)); }
  .o-section { margin-block-start: calc(11 * var(--u)); min-block-size: calc(21 * var(--u)); }
  .o-details { display: flex; flex-direction: column; gap: calc(7 * var(--u)); }
  .o-details > :global([data-field='visit_date'] .gf-row) { min-block-size: calc(32 * var(--u)); }
  .o-details > :global([data-field='visit_date'] .gf-box) { block-size: calc(32 * var(--u)); }
  .o-message { margin-block-start: calc(11 * var(--u)); }

  /* Rating card: white, the card radius (bug 049), content origin x 27.4; the card is as tall as the left column */
  .o-card { box-sizing: border-box; align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; border-radius: var(--radius-card); background: #fff; padding-block: calc(12 * var(--u)); padding-inline: calc(27.4 * var(--u)) 0; }
  .o-rate { margin: 0; padding: 0; border: 0; min-inline-size: 0; inline-size: calc(151.6 * var(--u)); }
  .o-rate + .o-rate { margin-block-start: calc(9 * var(--u)); }
  /* Title centred on x 72.91; faces 15 below the title's top */
  .o-legend { float: inline-start; box-sizing: border-box; inline-size: 100%; min-block-size: calc(15 * var(--u)); padding: 0; padding-inline-end: calc(5.78 * var(--u)); text-align: center; font-weight: 500; font-size: calc(8.838 * var(--u)); line-height: calc(11.155 * var(--u)); color: var(--color-navy); }
  /* Arabic: the shared RTL rule (forms.css: form legend = plaintext, right) would push the titles off their face row */
  :global([dir='rtl']) .o-legend { text-align: center; }
  .o-opts { clear: both; display: flex; }
  /* Option columns 30.05 wide centred on 15.03 / 54.92 / 94.82 / 136.49 */
  .o-opt { display: flex; flex-direction: column; align-items: center; flex: none; inline-size: calc(30.05 * var(--u)); cursor: pointer; }
  .o-opt:nth-child(2) { margin-inline-start: calc(9.845 * var(--u)); }
  .o-opt:nth-child(3) { margin-inline-start: calc(9.85 * var(--u)); }
  .o-opt:nth-child(4) { margin-inline-start: calc(11.62 * var(--u)); }
  /* Sentiment faces (bug 095): the Patient Feedback page treatment (FeedbackForm.astro): plain Deep Teal outline face, no fill
     (bug 125, Figma); hover: a faint neutral disc; selected: the full colour + a Deep Teal ring (white gap); keyboard focus: a dashed
     Deep Teal outline outside the ring; forced colours: a system ring. */
  .o-opt :global(.rface) {
    --face-fill: transparent;
    flex: none; display: block; inline-size: calc(19.443 * var(--u)); block-size: calc(19.443 * var(--u)); border-radius: 50%; color: var(--color-navy);
  }
  .o-opt:hover input:not(:checked) + :global(.rface) { --face-fill: color-mix(in srgb, var(--color-navy) 8%, #fff); }
  .o-opt input:checked + :global(.rface) { --face-fill: var(--face); transform: scale(1.1); box-shadow: 0 0 0 calc(1.3 * var(--u)) #fff, 0 0 0 calc(2.6 * var(--u)) var(--color-navy); }
  .o-opt input:focus-visible + :global(.rface) { outline: calc(1.3 * var(--u)) dashed var(--color-navy); outline-offset: calc(4.5 * var(--u)); }
  .o-opt input:checked ~ .o-txt { font-weight: 500; }
  @media (forced-colors: active) {
    .o-opt input:checked + :global(.rface) { outline: 3px solid Highlight; outline-offset: 2px; }
  }
  .o-txt { margin-block-start: calc(2.654 * var(--u)); font-weight: 300; font-size: calc(6.187 * var(--u)); line-height: calc(11.155 * var(--u)); color: var(--color-navy); white-space: nowrap; }

  @media (max-width: 1023.98px) {
    .o-left { padding-inline-start: 0; }
    .o-title { margin-inline: 0; }
    .o-card { justify-self: center; inline-size: calc(205.04 * var(--u)); padding-block: calc(18 * var(--u)); }
    .o-rate + .o-rate { margin-block-start: calc(14 * var(--u)); }
  }
</style>
