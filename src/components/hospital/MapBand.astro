---
import { Image } from 'astro:assets';
import { px } from '../../lib/scale';
import type { LocaleId } from '../../lib/editions';
import { t } from '../../lib/content';
import { mapsHref, type Hospital } from '../../lib/hospitals';
import OutlineButton from '../shared/OutlineButton.astro';
import band from '../../assets/hospital-detail/map-band.png';
import pin from '../../assets/hospital-detail/map-pin.svg';

/*
 * "Find Us in Abu Dhabi" band (Figma 112:7721 "Banner 4", page y 1977-2239): 1052 x 262 dark map texture (pre-cropped PNG),
 * heading row centred 88 from the top: "Find Us in" Medium 28 white (w147) | 15 | Material location pin 21.5 x 32.25 (drawn
 * 25.56 x 37.22 with its stroke, 10 above the text top) | 18.5 | city (w161). Outline button 164 x 30 "Open in Google Maps"
 * (Medium 13 #00b8ff, label 145 at 8) 149 from the top, centred (Figma: 9 left of centre, normalised).
 * NOT in Figma, required by scope 2.5 (docs/open-decisions.md HD4): address, phone (tel: link) and opening hours as one centred
 * Book 12/14 white block 14 below the button; each line only when the data exists (hospitals.json).
 */
interface Props { c: { ariaLabel: string; lead: string; button: string; phoneLabel: string; hoursLabel: string; addressLabel: string }; hospital: Hospital; city: string; locale: LocaleId }
const { c, hospital: h, city, locale } = Astro.props;
const address = t(h.address, locale, 'hospitals');
const hours = h.hours ? t(h.hours, locale, 'hospitals') : '';
const phone = h.phone ?? '';
---

<section class="map" aria-label={c.ariaLabel}>
  <Image src={band} width={px(1052)} height={px(262)} widths={[px(1052)]} sizes="100vw" format="webp" alt="" loading="lazy" decoding="async" class="bg" />
  <div class="in">
    <h2 class="h">
      <span class="lead">{c.lead}</span>
      <img loading="lazy" src={pin.src} width={pin.width} height={pin.height} alt="" class="pin" />
      <span class="city">{city}</span>
    </h2>
    <OutlineButton href={mapsHref(h, locale)} label={c.button} class="btn" onDark {...{ target: '_blank', rel: 'noopener' }} />
    {(address || phone || hours) && (
      <address class="info">
        {address && <span class="line"><span class="sr-only">{c.addressLabel}: </span>{address}</span>}
        {phone && <span class="line"><span class="sr-only">{c.phoneLabel}: </span><a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="tel hit">{phone}</a></span>}
        {hours && <span class="line"><span class="sr-only">{c.hoursLabel}: </span>{hours}</span>}
      </address>
    )}
  </div>
</section>

<style>
  .map { position: relative; overflow: hidden; background: var(--color-navy); font-family: var(--font-gotham); font-style: normal; color: #fff; }
  .map :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; max-width: none; }
  .in { position: relative; box-sizing: border-box; max-width: calc(var(--max-w) * 1px); margin-inline: auto; min-height: calc(262 * var(--u)); padding: calc(78 * var(--u)) calc(16 * var(--u)) calc(27 * var(--u)); display: flex; flex-direction: column; align-items: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .h { margin: 0; display: flex; align-items: flex-start; flex-wrap: wrap; justify-content: center; gap: 0 calc(15 * var(--u)); font-weight: 500; font-size: calc(28 * var(--u)); line-height: calc(32 * var(--u)); text-align: center; }
  .lead, .city { display: block; padding-top: calc(10 * var(--u)); overflow-wrap: anywhere; }
  .pin { display: block; width: calc(25.56 * var(--u)); height: calc(37.22 * var(--u)); margin: calc(-2.03 * var(--u)) calc(1.47 * var(--u)) 0 calc(-2.03 * var(--u)); max-width: none; }
  .map :global(.btn) { margin-top: calc(19 * var(--u)); }
  .info { margin-top: calc(14 * var(--u)); display: flex; flex-direction: column; align-items: center; gap: calc(4 * var(--u)); font-style: normal; font-size: calc(12 * var(--u)); line-height: calc(14 * var(--u)); text-align: center; }
  .tel { color: inherit; text-decoration: underline; text-underline-offset: calc(2 * var(--u)); }
  .tel:focus-visible { outline: calc(2 * var(--u)) solid var(--color-cyan); outline-offset: calc(2 * var(--u)); }
  :global([dir='rtl']) .map :global(.bg) { scale: -1 1; }
</style>
