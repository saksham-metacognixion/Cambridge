---
import { Image } from 'astro:assets';
import { px, vwSizes } from '../../lib/scale';
import { img } from '../../lib/images';
import type { RegionId } from '../../lib/editions';

/*
 * Insurer card, Figma 46:7195 (Al Buhaira, first card): white 194.77 x 125.311, radius 14.321 (-> --radius-card, bug 049), shadow 0 0 15.696 -4.296
 * rgba(0,0,0,.25); navy #004059 bar 36.519 high at the bottom (bottom radius 14.321, shadow 5.234 5.234 15.696 -4.296);
 * name Gotham Medium 7.877 / 14.823 #f9f9f9, centred (Figma label tops 10.03 / 10.74 / 12.18 in the bar: centred = 10.85).
 * Logo: per insurer (src/data/insurers.json) box w x h at x, y in the card; crop = the Figma image fill inside the box.
 * The logo is decorative here (alt ""): the insurer's name is the text right under it. The crop stays physical (left):
 * a logo is never mirrored, only its place in the card follows the reading direction.
 */
interface Logo { image: string; w: number; h: number; x: number; y: number; fit?: 'contain'; ratio?: number; crop?: { w: string; h: string; left: string; top: string } }
interface Props { name: string; logo?: Logo; region: RegionId }
const { name, logo, region } = Astro.props;
// No logo yet (src/data/insurers.json, the live site's KSA insurers): the card keeps its size and shows the name bar only.
const src = logo ? img(logo.image, region) : null;
const svg = !!logo && (logo.image.endsWith('.svg') || (src as { format?: string }).format === 'svg');
// Rendered image size in Figma px (crop: the % of the box; contain: fitted into the box keeping the image ratio).
const pct = (v: string) => parseFloat(v) / 100;
let iw = logo?.w ?? 0, ih = logo?.h ?? 0;
if (!logo) { /* name only */ } else if (logo.crop) { iw = logo.w * pct(logo.crop.w); ih = logo.h * pct(logo.crop.h); }
else if (logo.fit === 'contain' && logo.ratio) { const r = logo.ratio; if (r > logo.w / logo.h) ih = logo.w / r; else iw = logo.h * r; }
---

<article class="icard">
  {logo && src && <div class="logo" style={`--w:${logo.w};--h:${logo.h};--x:${logo.x};--y:${logo.y}`}>
    {svg ? (
      <img src={src.src} width={logo.w} height={logo.h} alt="" loading="lazy" decoding="async" class="fill" />
    ) : logo.crop ? (
      <Image src={src} width={px(iw)} height={px(ih)} widths={[px(iw), px(iw) * 2]} sizes={vwSizes(iw)} format="webp" alt="" loading="lazy" decoding="async" class="crop" style={`width:${logo.crop.w};height:${logo.crop.h};left:${logo.crop.left};top:${logo.crop.top}`} />
    ) : (
      <Image src={src} width={px(iw)} height={px(ih)} widths={[px(iw), px(iw) * 2]} sizes={vwSizes(iw)} format="webp" alt="" loading="lazy" decoding="async" class:list={['fill', logo.fit === 'contain' && 'contain']} />
    )}
  </div>}
  <p class="name">{name}</p>
</article>

<style>
  .icard { position: relative; display: flex; flex-direction: column; width: calc(194.77 * var(--u)); min-height: calc(125.311 * var(--u)); border-radius: var(--radius-card); background: #fff; box-shadow: 0 0 calc(15.696 * var(--u)) calc(-4.296 * var(--u)) rgba(0, 0, 0, 0.25); font-family: var(--font-gotham); font-style: normal; }
  .logo { position: absolute; inset-inline-start: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u)); width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u)); overflow: hidden; }
  .fill { display: block; width: 100%; height: 100%; max-width: none; object-fit: cover; }
  .contain { object-fit: contain; }
  .crop { position: absolute; max-width: none; }
  .name { box-sizing: border-box; display: flex; align-items: center; justify-content: center; margin: auto 0 0; min-height: calc(36.519 * var(--u)); padding: calc(4 * var(--u)) calc(8 * var(--u)); border-radius: 0 0 var(--radius-card) var(--radius-card); background: var(--color-navy); box-shadow: calc(5.234 * var(--u)) calc(5.234 * var(--u)) calc(15.696 * var(--u)) calc(-4.296 * var(--u)) rgba(0, 0, 0, 0.25); color: #f9f9f9; font-weight: 500; font-size: calc(7.877 * var(--u)); line-height: calc(14.823 * var(--u)); text-align: center; overflow-wrap: anywhere; }
</style>
