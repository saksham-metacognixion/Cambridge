---
import PostCard from './PostCard.astro';
import { content } from '../../lib/content';
import { parsePath, urlFor } from '../../lib/editions';
import { postsFor } from '../../lib/news';
import { cardData } from '../../lib/news-image';
import dots from '../../assets/media-hub/divider-group620.svg';

// Figma 46:7903 (page y 1236, h 656.769). The first posts are rendered here; the rest are added by the script
// from posts.json when the row is scrolled or a category is chosen (the row can hold all ~259 posts).
const FIRST = 6;
const { edition } = parsePath(Astro.url.pathname);
const c = content('media-hub/page', edition.locale).latest;
const cards = await Promise.all(postsFor(edition).slice(0, FIRST).map((p) => cardData(p, edition)));
const indexUrl = urlFor(edition, 'media-hub/posts.json');
---

<section id="latest" data-latest data-index={indexUrl} class="relative mt-[calc(44.28*var(--u))] bg-[#f2f2f2] pt-65 pb-72" aria-labelledby="latest-title">
  <p class="m-0 mx-auto h-17 max-w-282 text-center font-gotham font-light text-f14p173 leading-17 tracking-[calc(1.4173*var(--u))] text-navy uppercase not-italic">{c.eyebrow}</p>
  <h2 id="latest-title" class="m-0 mx-auto mt-[calc(27.64*var(--u))] max-w-[calc(457.328*var(--u))] text-center font-gotham font-bold text-f29p076 leading-[calc(34.336*var(--u))] text-navy not-italic [word-break:break-word]">{c.title}</h2>

  <!-- Swipe / scroll row (no arrows): padding keeps the card shadows from being clipped, margins cancel it out. -->
  <ul class="hscroll m-0 mt-[calc(1.64*var(--u))] -mb-30 flex list-none gap-[calc(36.6*var(--u))] p-0 py-30 ps-16 pe-16 scroll-ps-16 lg:ps-115 lg:pe-115 lg:scroll-ps-115" data-row aria-label={c.indexLabel}>
    {cards.map((card) => <li class="flex"><PostCard card={card} /></li>)}
    <li class="w-1 shrink-0" data-sentinel aria-hidden="true"></li>
  </ul>
  <template data-card-template><li class="flex"><PostCard /></li></template>

  <img src={dots.src} width={dots.width} height={dots.height} alt="" class="mx-auto mt-[calc(58.83*var(--u))] block w-[calc(40.972*var(--u))] h-[calc(8.716*var(--u))]" />
</section>

<script>
  import '../../scripts/media-hub';
</script>
