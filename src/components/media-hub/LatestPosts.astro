---
import PostCard from './PostCard.astro';
import { content } from '../../lib/content';
import { parsePath, urlFor } from '../../lib/editions';
import { postsFor } from '../../lib/news';
import { cardData } from '../../lib/news-image';
import Pagination from '../shared/Pagination.astro';

// Figma 46:7903 (page y 1236, h 656.769). The first posts are rendered here; the rest are added by the script
// from posts.json when the row is scrolled or a category is chosen (the row can hold all ~259 posts).
const FIRST = 6;
const { edition } = parsePath(Astro.url.pathname);
const c = content('media-hub/page', edition.locale).latest;
const cards = await Promise.all(postsFor(edition).slice(0, FIRST).map((p) => cardData(p, edition)));
const indexUrl = urlFor(edition, 'media-hub/posts.json');
---

<section id="latest" data-latest data-index={indexUrl} class="relative mt-[calc(44.28*var(--u))] bg-mist-50 pt-65 pb-72" aria-labelledby="latest-title">
  <p class="m-0 mx-auto h-17 max-w-282 text-center font-gotham font-light text-f14p173 leading-17 tracking-[calc(1.4173*var(--u))] text-navy uppercase not-italic">{c.eyebrow}</p>
  <h2 id="latest-title" class="m-0 mx-auto max-lg:box-border max-lg:px-[16px] mt-[calc(27.64*var(--u))] max-w-[calc(457.328*var(--u))] text-center font-gotham font-bold text-f29p076 leading-[calc(34.336*var(--u))] text-navy not-italic [word-break:break-word]">{c.title}</h2>

  <!-- Swipe / scroll row (no arrows in Figma), auto-scrolling in a slow seamless loop like Testimonials / Care Support (bug 064,
       src/scripts/autoscroll.ts: scroller [data-autoscroll] > [data-loop-row] > [data-loop-item]; pauses on hover / focus /
       touch, off with prefers-reduced-motion). The script appends more posts to the loop row as it nears its end
       (scripts/media-hub.ts) and rebuilds the copies. Padding keeps the card shadows from being clipped, margins cancel it out. -->
  <div id="latest-posts" class="hscroll mt-[calc(1.64*var(--u))] -mb-30 py-30 scroll-ps-16 lg:scroll-ps-115" data-row data-autoscroll>
    <ul class="m-0 flex w-max list-none gap-[calc(36.6*var(--u))] p-0 ps-16 pe-16 lg:ps-115 lg:pe-115" data-loop-row aria-label={c.indexLabel}>
      {cards.map((card) => <li class="flex" data-loop-item><PostCard card={card} /></li>)}
      <li class="w-1 shrink-0" data-sentinel aria-hidden="true"></li>
    </ul>
  </div>
  <template data-card-template><li class="flex" data-loop-item><PostCard /></li></template>

  <!-- Pagination dots of the post row (Figma's dot divider, 58.83 below the cards): shared component, bug 012; recounted as
       the script appends more posts or a category is chosen. -->
  <Pagination for="latest-posts" class="mt-[calc(58.83*var(--u))]" />
</section>

<script>
  import '../../scripts/media-hub';
  import '../../scripts/pagination';
  import '../../scripts/autoscroll';
</script>
