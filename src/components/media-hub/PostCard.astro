---
// One "Latest Blogs & Posts" card (Figma 46:7912, 248.389 wide). Flow layout: the image box and the badge are fixed, title and
// excerpt grow with their text, the arrow sits at the bottom. Corners: --radius-card (photo) / --radius-btn (date badge), bug 049. The same markup is rendered empty inside a <template>
// and filled by src/scripts/media-hub.ts for posts that are not on the page at build time.
import arrow from '../../assets/news/arrow-icon-group33.svg';
import type { CardData } from '../../lib/news-image';

type Props = { card?: Partial<CardData> };
const { card = {} } = Astro.props;
---

<article class="pc relative flex w-[calc(248.389*var(--u))] shrink-0 snap-start flex-col" data-card data-category={card.category}>
  <div class="relative h-[calc(175.333*var(--u))] rounded-(--radius-card) shadow-post">
    <div class="absolute inset-0 overflow-hidden rounded-(--radius-card)">
      <img
        class="pc-img absolute inset-0 block h-full w-full max-w-none object-cover"
        src={card.src ?? ''}
        srcset={card.srcset || undefined}
        sizes="(min-width: 1440px) 340px, 24vw"
        width="340"
        height="240"
        loading="lazy"
        decoding="async"
        alt={card.alt ?? ''}
        style={card.crop || undefined}
        hidden={card.slug !== undefined && !card.src}
        data-img
      />
    </div>
    <time class="pc-badge absolute top-0 start-[calc(36.53*var(--u))] flex h-[calc(36.528*var(--u))] flex-col items-center gap-[calc(3.653*var(--u))] rounded-b-(--radius-btn) bg-white p-[calc(7.306*var(--u))] text-center not-italic whitespace-nowrap" datetime={card.iso} aria-label={card.dateFull} data-time>
      <span class="pc-day font-medium text-f14p173 text-navy" data-day>{card.day}</span>
      <span class="pc-wd font-normal text-f11p689 leading-[calc(18.994*var(--u))] text-navy" data-weekday>{card.weekday}</span>
    </time>
  </div>
  <h3 class="m-0 mt-[calc(22.9*var(--u))] font-medium text-f18p264 leading-21.75 text-navy not-italic [word-break:break-word]"><a href={card.href} class="pc-link text-inherit no-underline" data-title>{card.title}</a></h3>
  <p class="m-0 mt-9 mb-[calc(16.1*var(--u))] font-normal text-f11p689 leading-[calc(18.994*var(--u))] text-body not-italic [word-break:break-word]" data-excerpt>{card.excerpt}</p>
  <a href={card.href} class="pc-arrow hit mt-auto ms-219 block h-[calc(36.528*var(--u))] w-[calc(36.528*var(--u))]" aria-hidden="true" data-arrow tabindex="-1">
    <img loading="lazy" src={arrow.src} width={arrow.width} height={arrow.height} alt="" class="block h-full w-full rtl:-scale-x-100" /><!-- bug 074: points left in Arabic -->
  </a>
</article>

<style>
  /* Whole card is clickable through the title link (one link per card for keyboard / screen readers; the arrow is hidden from them). */
  .pc-link::after { content: ""; position: absolute; inset: 0; }
  /* Title hover as on the live post cards (dynamic title colorlinksHover, theme a transition .12s): brand AA keeps the Deep Teal
     text and marks the hover with the cyan underline (8 Oct 2026 brand pass) instead of the live cyan text. */
  .pc-link { transition: color var(--ui-ease), text-decoration-color var(--ui-ease); }
  @media (hover: hover) { .pc-link:hover { color: var(--color-navy); text-decoration: underline 2px var(--color-cyan); text-underline-offset: 0.25em; } }
  /* Badge: the number and weekday are trimmed to their cap height like in Figma, and the drop-shadow follows the rounded bottom. */
  .pc-badge { filter: drop-shadow(calc(2.922 * var(--u)) calc(2.922 * var(--u)) calc(5.479 * var(--u)) rgba(0, 0, 0, 0.25)); }
  .pc-day, .pc-wd { font-family: Poppins, var(--font-gotham); text-box: trim-both cap alphabetic; }
  .pc-link:focus-visible { outline: 1px solid var(--color-cyan); outline-offset: 2px; }
  /* Bug 081 (phones): the card keeps the 16px page gutter plus room for the next card's edge (the desktop 340px card filled a
     360 screen) and the arrow sits at the card's end edge (Figma lets it overhang the card by 7px, which put it half off-screen). */
  @media (max-width: 767.98px) {
    .pc { width: min(calc(248.389 * var(--u)), calc(100vw - 48px)); }
    .pc-arrow { margin-inline-start: 0; align-self: flex-end; }
  }
</style>
