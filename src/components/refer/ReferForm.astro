---
/*
 * "Patient Referral Form" block of Refer a Patient (Figma 59:14344), section top = H2 top (page y 591, 35 below the hero).
 * H2 59:14337 Medium 28 #004059 centred on x 521 (w430, box h27) | 10 | text 59:14336 Book 12/14 #6b6b6b centred on
 * x 520.5 (w577) | 23 | pills 59:14338/14339 125 x 25 radius 12 at x 391 and 531 (selected #004059 fill, other 1px
 * #004059 outline; label Medium 10/10) | 34 | card 46:8029 x 42, 968 wide (Figma h 1179), padding top 56 / start 44 /
 * end 43 / bottom 52 below SUBMIT (150 x 50, radius 15, Bold 15, label top 18).
 * The pills switch three forms (ARIA tabs, src/scripts/tabs.ts), the tabs named in the client's Refer a Patient document
 * (5 Oct 2026): For Healthcare Professionals = the Figma form; For You, Family or friends and For Corporate or Organisations =
 * the same form without the referring-doctor block (their field lists are not in the document, docs/open-decisions.md CT11).
 * The third pill sits 15 to the right of the second (Figma pitch); below 1024px the pills wrap. Without JS the first form works.
 */
import FormShell from '../forms/FormShell.astro';
import ReferFields from './ReferFields.astro';
import CenteredIntro from '../shared/CenteredIntro.astro';
import { content } from '../../lib/content';
import { parsePath } from '../../lib/editions';
import '../forms/forms.css';

const { edition } = parsePath(Astro.url.pathname);
const page = content('refer-patient/page', edition.locale);
const c = content('forms/refer', edition.locale);
const tabs = [
  { key: 'doctor', form: 'refer-patient' },
  { key: 'other', form: 'refer-patient-other' },
  { key: 'corporate', form: 'refer-patient-corporate' },
];
---

<section class="refer" aria-labelledby="refer-heading">
  <CenteredIntro id="refer-heading" heading={page.intro.heading} text={page.intro.text} cx={521} tx={520.5} />

  <div class="tabs" data-tabs>
    <div class="tablist" role="tablist" aria-label={c.tabsLabel}>
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`refer-tab-${t.key}`} aria-controls={`refer-panel-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="ui-pill hit pill">{c.tabs[t.key]}</button>
      ))}
    </div>
  </div>

  {tabs.map((t, i) => (
    <div class="card pf-card" role="tabpanel" id={`refer-panel-${t.key}`} aria-labelledby={`refer-tab-${t.key}`} hidden={i !== 0}>
      <FormShell id={t.form} edition={edition} submit={c.submit} ariaLabel={c.ariaLabel[t.key]} gaps={{ consent: 37, submit: 22 }} class="pf rf">
        <ReferFields form={t.form} edition={edition} />
      </FormShell>
    </div>
  ))}
</section>

<script>
  import '../../scripts/tabs';
</script>

<style>
  .refer { max-width: calc(var(--target-w) * 1px); margin-inline: auto; font-family: var(--font-gotham); font-style: normal; color: var(--color-navy); }
  .tablist { display: flex; flex-wrap: wrap; justify-content: center; gap: calc(15 * var(--u)); margin-top: calc(23 * var(--u)); }
  .pill { --pill-w: 160; --pill-on: var(--color-navy-alt); } /* Figma 125: the client's longer labels ("For Corporate or Organisations") need 160 */
  .card { margin: calc(34 * var(--u)) 16px 0; padding: 24px 16px; }
  .card[hidden] { display: none; }

  /* Field layout inside the card (shared pf-* field styles in forms.css; Refer's own sizes as custom properties) */
  .card :global(.rf-section) { margin-block-end: calc(15 * var(--u)); }                     /* label top -> first row: 33 */
  .card :global(.rf-area-label) { margin-block-end: calc(9 * var(--u)); }                   /* label top -> textarea: 27 */
  .card :global(.rf-block + .rf-block) { margin-block-start: calc(37 * var(--u)); }   /* after .rf-grid + .rf-grid: a block gap wins */
  .card :global(.rf-sel-req) { inline-size: 100%; }
  .card :global(.rf-sel-req select) { padding-inline: calc(15.51 * var(--u)) calc(26 * var(--u)); }
  .card :global(.rf-sel-req .pf-chev) { inset-inline-end: calc(11.76 * var(--u)); inset-block-start: calc(18 * var(--u)); inline-size: calc(7.24 * var(--u)); }
  .card :global(.f-consent) { margin-inline-start: 0; }

  @media (min-width: 1024px) {
    .tablist { justify-content: flex-start; margin-inline-start: calc(268 * var(--u)); } /* three 160 pills + 2 gaps = 510, centred on the Figma pill centre 523 */
    .card { width: calc(968 * var(--u)); margin-inline: calc(42 * var(--u)) 0; padding: calc(56 * var(--u)) calc(43 * var(--u)) calc(52 * var(--u)) calc(44 * var(--u)); }
    .card :global(.rf-sel-req) { inline-size: calc(410 * var(--u)); }
  }
</style>
