---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import care from '../../assets/calculators/care.png';

const cards = [
  { x: 532, y: 100, title: 'BMI Calculator', tw: 148, desc: 'Check your weight category instantly.', bx: 30 },
  { x: 768, y: 100, title: 'Stroke Risk Calculator', tw: 148, desc: 'Understand your risk in minutes.', bx: 31 },
  { x: 532, y: 245, title: 'Heart Age Calculator', tw: 148, desc: 'See how healthy and well your heart is.', bx: 30 },
  { x: 768, y: 245, title: 'Lung Health Calculator', tw: 157, desc: 'Assess your lung health quickly.', bx: 31 },
];
const u = (n: number) => `calc(${n} * var(--u))`;
---

<section class="calc relative bg-veil" style="--h: 444" id="calculators">
  <div class="stage">
    <p class="c-sub absolute left-475 top-57 w-577 h-13 m-0 font-gotham font-medium text-f14 leading-14 text-navy text-center not-italic">Quick insights to better understand your health and risks.</p>
    <!-- Duplicate subtitle (Gotham Book 12px, under the photo) intentionally omitted: client decision. -->

    <div class="c-hero">
      <Picture src={care} formats={['avif']} fallbackFormat="webp" width={px(463)} height={px(444)} widths={[px(463), px(463) * 2]} sizes={`${px(463)}px`} loading="lazy" decoding="async" alt="Patient receiving care at Cambridge Hospital"
        class="c-img absolute left-0 top-0 block w-463 h-444 object-cover" />
      <h2 class="c-head absolute left-11 top-37 w-430 h-54 m-0 font-gotham font-medium text-f28 text-navy text-center not-italic"><span class="block">Check Your Health</span><span class="block">in Seconds<span class="text-cyan">.</span></span></h2>
    </div>

    <div class="c-grid">
      {cards.map((c) => (
        <div class="c-card absolute w-218 h-125 bg-white hair-card rounded-r6 box-border" style={`left:${u(c.x)};top:${u(c.y)}`}>
          <h3 class="absolute left-30 top-37 h-15 m-0 font-gotham font-medium text-f13 text-navy not-italic" style={`width:${u(c.tw)}`}>{c.title}</h3>
          <p class="absolute left-30 top-55 w-138 h-19 m-0 font-gotham font-normal text-f9 leading-10 text-body not-italic">{c.desc}</p>
          <a href="#" class="absolute top-85 w-74 h-17 rounded-r3 bg-navy" style={`left:${u(c.bx)}`} aria-label={`Calculate Now: ${c.title}`}>
            <span class="absolute left-8 top-4 w-59 h-10 font-gotham font-medium text-f8 leading-10 text-white not-italic">Calculate Now</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .c-hero, .c-grid { display: contents; }
  .c-card { margin: 0; }
  .c-card a { text-decoration: none; }
  @media (max-width: 1023.98px) {
    .calc { padding: 24px 16px; }
    .stage { display: flex; flex-direction: column; align-items: center; gap: 20px; }
    .c-sub { order: 2; position: static; width: 100%; height: auto; }
    .c-hero { display: block; order: 1; position: relative; width: 100%; max-width: calc(463 * var(--u)); aspect-ratio: 463 / 444; }
    .c-img { width: 100%; height: 100%; }
    .c-head { left: 0; right: 0; top: 8%; width: 100%; height: auto; font-size: min(calc(28 * var(--u)), 7.6vw); }
    .c-grid { order: 3; display: grid; grid-template-columns: repeat(auto-fit, calc(218 * var(--u))); justify-content: center; gap: 16px; width: 100%; }
    .c-card { position: relative; left: auto !important; top: auto !important; }
  }
</style>
