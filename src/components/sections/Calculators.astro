---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import { img } from '../../lib/images';
import { parsePath, urlFor } from '../../lib/editions';
import { pagePath } from '../../lib/paths';
import { content } from '../../lib/content';

const { edition } = parsePath(Astro.url.pathname);
const t = content('home/calculators', edition.locale);
const care = img(t.photo.image, edition.region);

// Design only; zipped by index with the content cards from home/calculators.json
const layout = [
  { x: 532, y: 100, tw: 148, bx: 30 },
  { x: 768, y: 100, tw: 148, bx: 31 },
  { x: 532, y: 245, tw: 148, bx: 30 },
  { x: 768, y: 245, tw: 157, bx: 31 },
];
const cards = layout.map((d, i) => ({ ...d, title: t.cards[i].title, desc: t.cards[i].desc, href: t.cards[i].page ? urlFor(edition, pagePath(t.cards[i].page)) : t.cards[i].href })); // `page` = key in PAGE_PATHS: the calculators have no page of their own (docs/open-decisions.md LA4)
const u = (n: number) => `calc(${n} * var(--u))`;
---

<section class="calc relative bg-veil" style="--h: 444" id="calculators">
  <div class="stage">
    <p class="c-sub absolute start-475 top-57 w-577 h-13 m-0 font-gotham font-medium text-f14 leading-14 text-navy text-center not-italic">{t.subtitle}</p>
    <!-- Duplicate subtitle (Gotham Book 12px, under the photo) intentionally omitted: client decision. -->

    <div class="c-hero">
      <Picture src={care} formats={['avif']} fallbackFormat="webp" width={px(463)} height={px(444)} widths={[px(463), px(463) * 2]} sizes={`${px(463)}px`} loading="lazy" decoding="async" alt={t.photo.alt}
        class="c-img absolute start-0 top-0 block w-463 h-444 object-cover" />
      <h2 class="c-head absolute start-11 top-37 w-430 h-54 m-0 font-gotham font-medium text-f28 text-navy text-center not-italic"><span class="block">{t.heading[0]}</span><span class="block">{t.heading[1]}<span class="text-cyan">{t.headingDot}</span></span></h2>
    </div>

    <div class="c-grid">
      {cards.map((c) => (
        <div class="c-card absolute w-218 h-125 bg-white hair-card rounded-r6 box-border" style={`inset-inline-start:${u(c.x)};top:${u(c.y)}`}>
          <h3 class="absolute start-30 top-37 h-15 m-0 font-gotham font-medium text-f13 text-navy not-italic" style={`width:${u(c.tw)}`}>{c.title}</h3>
          <p class="absolute start-30 top-55 w-138 h-19 m-0 font-gotham font-normal text-f9 leading-10 text-body not-italic">{c.desc}</p>
          <a href={c.href} class="hit absolute top-85 w-74 h-17 rounded-r3 bg-navy" style={`inset-inline-start:${u(c.bx)}`} aria-label={`${t.cardButton}: ${c.title}`}>
            <span class="absolute start-8 top-4 w-59 h-10 font-gotham font-medium text-f8 leading-10 text-white not-italic">{t.cardButton}</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .c-hero, .c-grid { display: contents; }
  .c-card { margin: 0; }
  .c-card a { text-decoration: none; }
  @media (max-width: 1023.98px) {
    .calc { padding: 24px 16px; }
    .stage { display: flex; flex-direction: column; align-items: center; gap: 20px; }
    .c-sub { order: 2; position: static; width: 100%; height: auto; }
    .c-hero { display: block; order: 1; position: relative; width: 100%; max-width: calc(463 * var(--u)); aspect-ratio: 463 / 444; container-type: inline-size; }
    .c-img { width: 100%; height: 100%; }
    .c-head { inset-inline-start: 0; inset-inline-end: 0; top: 8%; width: 100%; height: auto; font-size: 6.05cqw; } /* 28 / 463 of the picture width: the heading keeps its desktop proportions over the photo instead of growing past it */
    .c-grid { order: 3; display: grid; grid-template-columns: repeat(auto-fit, calc(218 * var(--u))); justify-content: center; gap: 16px; width: 100%; }
    .c-card { position: relative; inset-inline-start: auto !important; top: auto !important; }
  }
</style>
