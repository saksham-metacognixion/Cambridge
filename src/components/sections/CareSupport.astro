---
import { px } from '../../lib/scale';
import { content } from '../../lib/content';
import { img } from '../../lib/images';
import { parsePath } from '../../lib/editions';

// Spec is FRAME-relative (frame 1106x356 at page x=-22, y=1698). Row is placed at page x = -22 (frame x 0).
// The ALL / KSA / UAE pills Figma shows under the intro (y 132) were removed on request (6 Oct 2026): they never filtered
// anything here. Tile row position (y 187) unchanged.
const { edition } = parsePath(Astro.url.pathname);
const c = content('home/care-support', edition.locale);
const FRAME_W = 1106;
const FRAME_H = 356;
const ROW_X = -22;
// Tile corners: --radius-card (Figma r5, bug 049). icon inset % = [top, right, bottom, left] of the frame. Design only; label + icon key come from home/care-support JSON, zipped by index.
const design = [
  { x: 0, cx: 37, w: 60, inset: [58.99, 94.81, 29.66, 1.54] },
  { x: 113, cx: 157, w: 60, inset: [59.06, 84.41, 28.88, 12.84] },
  { x: 226, cx: 270.5, w: 121, inset: [58.45, 73.54, 28.84, 22.33] },
  { x: 339, cx: 383, w: 82, inset: [58.87, 63.2, 29.24, 32.82] },
  { x: 452, cx: 496.5, w: 75, inset: [58.45, 53.6, 28.84, 43.14] },
  { x: 565, cx: 609.5, w: 71, inset: [61.25, 43.75, 30.89, 52.98] },
  { x: 678, cx: 722, w: 82, inset: [58.15, 33.54, 29.21, 62.75] },
  { x: 791, cx: 835, w: 60, inset: [58.55, 22.54, 29.78, 73.69] },
  { x: 904, cx: 948, w: 60, inset: [58.15, 12.57, 30.67, 84.09] },
  { x: 1017, cx: 1060, w: 60, inset: [59.27, 2.18, 29.44, 94.58] },
];
const tiles = design.map((d, i) => ({ ...d, label: c.tiles[i].label as string, icon: img(c.tiles[i].icon, edition.region) })).map((t) => {
  const [it, ir, ib, il] = t.inset;
  return {
    ...t,
    ix: (il * FRAME_W) / 100 - t.x,
    iy: (it * FRAME_H) / 100 - 187,
    iw: (FRAME_W * (100 - il - ir)) / 100,
    ih: (FRAME_H * (100 - it - ib)) / 100,
    lx: t.cx - t.w / 2 - t.x,
  };
});
---

<section class="relative bg-veil overflow-x-clip" style="--h: 356">
  <div class="stage max-lg:flex max-lg:flex-col max-lg:items-center max-lg:gap-6 max-lg:py-8">
    <h2 class="dpos font-gotham font-medium text-f28 max-lg:text-f23 leading-none text-navy text-center not-italic whitespace-normal [word-break:break-word] max-lg:px-16" style="--x:201;--y:47;--w:617;--h:27">{c.heading}</h2>
    <!-- Bug 132 (15 Oct 2026): justified with the last line centred (.text-justify-center). The Figma line break between intro[0] and
         intro[1] is gone: a forced break ends a line, which justify leaves unstretched, so the two lines now wrap naturally at the same
         place (the 577 box) with the first line filled edge to edge. -->
    <p class="dpos font-gotham font-normal text-f12 leading-14 text-body text-justify-center not-italic whitespace-normal [word-break:break-word] max-lg:px-16 max-lg:max-w-[calc(577*var(--u))]" style="--x:221;--y:82;--w:577;--h:27">{c.intro.join('')}</p>

    <!-- Live Home page (WordPress export, animation audit 8 Oct 2026): Greenshift Swiper, autoplay delay 0, speed 12000, loop,
         disablepause (no hover pause), autoplayrestore: one 12 s eased slide per tile, one after the other (autoscroll.ts step mode). -->
    <div class="hscroll dpos w-full" style="--x:0;--y:187;--w:1052;--h:110">
      <ul data-loop-row class="row flex gap-[calc(24*var(--u))] px-4 lg:block lg:relative lg:px-0 lg:gap-0 m-0 list-none">
        <li class="w-0 shrink-0 snap-start lg:absolute lg:start-0" aria-hidden="true"></li>
        {tiles.map((t) => (
          <li data-loop-item class="tile relative shrink-0 snap-start" style={`--l:${t.x}`}>
            <div class="pos bg-cyan rounded-(--radius-card) shadow-tile" style="--x:0;--y:0;--w:89;--h:87"></div>
            <img class="pos max-w-none" src={t.icon.src} width={px(t.iw)} height={px(t.ih)} alt="" loading="lazy" decoding="async" style={`--x:${t.ix};--y:${t.iy};--w:${t.iw};--h:${t.ih}`} />
            <p class="pos m-0 font-gotham font-normal text-f10 leading-10 text-navy text-center not-italic whitespace-normal [word-break:break-word]" style={`--x:${t.lx};--y:100;--w:${t.w};--h:10`}>{t.label}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .pos { position: absolute; inset-inline-start: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u)); width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u)); box-sizing: border-box; }
  .tile { width: calc(89 * var(--u)); height: calc(110 * var(--u)); }
  /* Bug 138 (15 Oct 2026, Arabic only): the label is a 10u Figma box at the tile's bottom edge (y 100 of 110) and the scroller clips
     vertical overflow, so with the Arabic 1.65 line height (bug 129: one 16.5u line, two lines for CT Scan / Sensory Rooms /
     Inpatient Gym = 33u) the glyphs ran under the edge. Arabic labels size to their text (10u minimum) and the tile grows to
     --ar-tile-h = 100 + 2 x 16.5 + 7 spare = 140u; the row, the scroller track and the section grow with it below. English keeps
     every Figma value. The label's x / width and the icon are untouched. */
  :global(html:lang(ar)) section { --ar-tile-h: 140; }
  :global(html:lang(ar)) .tile { height: calc(var(--ar-tile-h) * var(--u)); }
  :global(html:lang(ar)) .tile p.pos { height: auto; min-height: calc(var(--h) * var(--u)); }
  @media (max-width: 1023.98px) {
    .row { width: max-content; }
    .hscroll.dpos { position: static; width: auto; height: auto; }
    .hscroll.dpos { width: 100%; }
    .dpos { position: static; }
  }
  @media (min-width: 1024px) {
    /* Bug 129 (15 Oct 2026): the Figma canvas is a grid of tracks instead of absolute boxes, so a heading or intro that needs more
       lines (Arabic line heights) grows its track and pushes what follows; each track's minimum = the Figma box, so English keeps
       every Figma position. */
    /* tracks (Figma y): 47 | heading 47..75 (28 = the font on leading-none) | 7 | text 82..110 (two 14 lines) | 77 | row 187..297 | 59 = 356 */
    .stage { display: grid; grid-template-columns: 100%; grid-template-rows: calc(47 * var(--u)) minmax(calc(28 * var(--u)), auto) calc(7 * var(--u)) minmax(calc(28 * var(--u)), auto) calc(77 * var(--u)) calc(110 * var(--u)) calc(59 * var(--u)); align-content: start; justify-items: start; height: auto; min-height: calc(var(--h) * var(--u)); }
    .dpos { position: relative; align-self: start; margin-inline-start: calc(var(--x) * var(--u)); width: calc(var(--w) * var(--u)); min-height: calc(var(--h) * var(--u)); }
    h2.dpos { grid-row: 2; }
    p.dpos { grid-row: 4; }
    /* Bug 134 (15 Oct 2026, Arabic only): heading -> text spacer = --ar-gap-heading (global.css) instead of Figma's 7; the Arabic
       track list lives in the bug 138 rule below (it also widens the row track). */
    .hscroll.dpos { grid-row: 6; }
    /* Beyond 1440px (responsive audit 9 Oct 2026): the scroller takes the page gutter on both sides (global.css --gutter) so the
       tiles run off the screen edge instead of stopping at the stage edge; the tiles keep their Figma x on the stage. */
    .stage { overflow-x: visible; }
    .hscroll.dpos { margin-inline-start: calc(-1 * var(--gutter)); width: calc(100% + 2 * var(--gutter)); }
    /* Bug 157 (15 Oct 2026, client): Figma draws tile 1 cut at the frame's start edge (row x -22, label "adiology"). The row now
       opens one tile pitch (113) in, so tile 1 sits where Figma's first whole tile is (x 91) and only the far side peeks. */
    .row { margin-inline-start: calc(91 * var(--u) + var(--gutter)); width: calc(1106 * var(--u)); height: calc(110 * var(--u)); }
    /* Bug 138: Arabic tile row (absolute tiles, so the row cannot size from them) and its grid track = --ar-tile-h; the 59u bottom
       track stays, so the Arabic section is 30u taller than Figma's 356. */
    :global(html:lang(ar)) .row { height: calc(var(--ar-tile-h) * var(--u)); }
    :global(html:lang(ar)) .stage { grid-template-rows: calc(47 * var(--u)) minmax(calc(28 * var(--u)), auto) var(--ar-gap-heading) minmax(calc(28 * var(--u)), auto) calc(77 * var(--u)) calc(var(--ar-tile-h) * var(--u)) calc(59 * var(--u)); }
    .tile { position: absolute; inset-inline-start: calc(var(--l) * var(--u)); top: 0; }
  }
</style>
