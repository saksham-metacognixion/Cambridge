---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import { content, t } from '../../lib/content';
import { img } from '../../lib/images';
import { parsePath, urlFor } from '../../lib/editions';
import { DOCTOR_PATHS } from '../../lib/doctors';
import doctorsData from '../../data/doctors.json';
import mask from '../../assets/doctors/mask-group.svg';
import fill1 from '../../assets/doctors/fill-group1.svg';
import fill2 from '../../assets/doctors/fill-group2.svg';
import dots from '../../assets/dots/dots-doctors.svg';

// Section page-y origin = 1241. Card row is placed with the same negative offset as Figma (first card x = -118).
const { edition } = parsePath(Astro.url.pathname);
const c = content('home/doctors', edition.locale);
const ROW_X = -118;
const ROOT_W = 1052; // the inset % of the masked groups are relative to the 1052 wide root frame
const MASK_DX = 6.669;
const MASK_DY = 10.487;

// x = card page x, clipL = "l" inset % of the masked group, photo = [x, y, size(w,h)] in page coords.
// Design only; content (which doctor, button label) comes from home/doctors JSON, zipped by index.
const design = [
  { x: -118, clipL: -11.12, ph: [-99, 1394, 144, 144], btnX: -89, fill: fill1, nameW: 148 },
  { x: 94, clipL: 9.22, ph: [128, 1406, 116, 132], btnX: 123, fill: fill1, nameW: 148 },
  { x: 306, clipL: 29.09, ph: [327, 1394, 144, 144], btnX: 335, fill: fill1, nameW: 148 },
  { x: 520, clipL: 49.52, ph: [542, 1392, 146, 146], btnX: 549, fill: fill1, nameW: 148 },
  { x: 733, clipL: 69.68, ph: [755, 1388, 150, 150], btnX: 762, fill: fill1, nameW: 157 },
  { x: 945, clipL: 90.02, ph: [966, 1388, 150, 150], btnX: 974, fill: fill2, nameW: 148 },
];
const cards = design.map((d, i) => {
  const doc = doctorsData.doctors.find((x) => x.slug === c.doctors[i]);
  if (!doc) throw new Error(`home/doctors: unknown doctor slug "${c.doctors[i]}"`);
  const name = t(doc.name, edition.locale, 'doctors');
  // Button per card (home/doctors JSON): "Book Now" opens the pop-up with the doctor preselected; "See More" = the profile page.
  const b = c.buttons[i] as { label: string; action: 'book' | 'profile' };
  const href = b.action === 'book' ? '#book-appointment' : urlFor(edition, DOCTOR_PATHS.profile(doc.slug));
  return { ...d, name, role: t(doc.home_title ?? doc.title, edition.locale, 'doctors'), img: img(doc.home_photo ?? doc.photo, edition.region), alt: name, btn: b.label, href, slug: doc.slug, book: b.action === 'book' };
}).map((k) => ({
  ...k,
  shapeX: (k.clipL * ROOT_W) / 100 + MASK_DX - k.x, // card-relative
}));

const maskStyle = `mask-image:url("${mask.src}");-webkit-mask-image:url("${mask.src}");mask-mode:alpha;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-size:calc(182.127*var(--u)) calc(161.519*var(--u));-webkit-mask-size:calc(182.127*var(--u)) calc(161.519*var(--u));mask-position:calc(-${MASK_DX}*var(--u)) calc(-${MASK_DY}*var(--u));-webkit-mask-position:calc(-${MASK_DX}*var(--u)) calc(-${MASK_DY}*var(--u));`;
---

<section class="relative overflow-x-clip" style="--h: 457">
  <div class="stage max-lg:flex max-lg:flex-col max-lg:items-center max-lg:gap-6 max-lg:py-6">
    <h2 class="dpos font-gotham font-medium text-f28 max-lg:text-f23 leading-none text-navy text-center not-italic whitespace-normal [word-break:break-word] max-lg:px-4" style="--x:317;--y:0;--w:417;--h:27">{c.heading}</h2>
    <p class="dpos font-gotham font-normal text-f12 leading-14 text-body text-center not-italic whitespace-normal [word-break:break-word] max-lg:px-4 max-lg:max-w-[calc(577*var(--u))]" style="--x:237;--y:35;--w:577;--h:27">{c.intro}</p>

    <div class="dpos flex max-lg:flex-wrap max-lg:justify-center max-lg:gap-[calc(10*var(--u))] max-lg:px-4" role="group" aria-label={c.filterLabel} style="--x:371;--y:79;--w:279;--h:25">
      <button type="button" aria-pressed="true" class="hit pill absolute bg-navy text-white border-0" style="--x:0">{c.filters[0]}</button>
      <button type="button" aria-pressed="false" class="hit pill absolute bg-transparent text-navy hair-100 border-navy" style="--x:99">{c.filters[1]}</button>
      <button type="button" aria-pressed="false" class="hit pill absolute bg-transparent text-navy hair-100 border-navy" style="--x:200">{c.filters[2]}</button>
    </div>

    <div class="hscroll dpos w-full max-lg:self-stretch" style="--x:0;--y:139;--w:1052;--h:231">
      <div class="row flex gap-[calc(27*var(--u))] px-4 lg:block lg:relative lg:px-0 lg:gap-0">
        <span class="w-0 shrink-0 snap-start lg:absolute lg:start-0" aria-hidden="true"></span>
        {cards.map((card) => (
          <article class="card relative shrink-0 snap-start bg-white rounded-r15 hair-card" style={`--l:${card.x - ROW_X}`}>
            <div class="pos rounded-r15 bg-veil" style="--x:3;--y:3;--w:179;--h:155"></div>
            <div class="pos shape" aria-hidden="true" style={`--x:${card.shapeX};--y:${MASK_DY - 4};--w:168.409;--h:170.657;background:url("${(card.fill as any).src}") center/100% 100% no-repeat;${maskStyle}`}></div>
            <Picture class="pos object-cover" src={card.img} formats={['avif']} fallbackFormat="webp" width={px(card.ph[2])} height={px(card.ph[3])} widths={[px(card.ph[2]), px(card.ph[2]) * 2]} sizes={`${px(card.ph[2])}px`} loading="lazy" decoding="async" alt={card.alt} style={`--x:${card.ph[0] - card.x};--y:${card.ph[1] - 1380};--w:${card.ph[2]};--h:${card.ph[3]}`} />
            <h3 class="pos font-gotham font-medium text-f12 leading-15 text-navy-alt not-italic whitespace-normal [word-break:break-word]" style={`--x:15;--y:170;--w:${card.nameW};--h:15`}>{card.name}</h3>
            <p class="pos font-gotham font-normal text-f8 leading-10 text-body not-italic whitespace-normal [word-break:break-word]" style="--x:15;--y:185;--w:148;--h:20">{card.role}</p>
            <a href={card.href} data-doctor={card.book ? card.slug : undefined} class="hit pos bg-cyan rounded-r5" aria-label={`${card.btn} - ${card.name}`} style="--x:15;--y:202;--w:71;--h:13"></a>
            <span class="pos pointer-events-none font-gotham font-medium text-f8 leading-10 text-white text-center not-italic" style={`--x:${card.btnX - card.x};--y:204;--w:45;--h:10`}>{card.btn}</span>
          </article>
        ))}
      </div>
    </div>

    <img class="dpos" src={dots.src} width={px(41)} height={px(9)} alt="" style="--x:506;--y:408.284;--w:41;--h:9" />
  </div>
</section>

<style>
  .pos { position: absolute; inset-inline-start: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u)); width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u)); box-sizing: border-box; }
  .pill { position: absolute; inset-inline-start: calc(var(--x) * var(--u)); top: 0; width: calc(79 * var(--u)); height: calc(25 * var(--u)); border-radius: calc(12 * var(--u)); box-sizing: border-box; padding: 0; display: flex; align-items: center; justify-content: center; font: 500 calc(10 * var(--u)) / calc(10 * var(--u)) var(--font-gotham); text-align: center; cursor: pointer; }
  .card { width: calc(185 * var(--u)); height: calc(231 * var(--u)); }
  .dpos img, img.dpos { max-width: none; }
  @media (max-width: 1023.98px) {
    .pill { position: relative; inset-inline-start: auto; }
    .row { width: max-content; }
    div[role='group'].dpos { position: static; width: auto; height: auto; }
    .hscroll.dpos { position: static; width: 100%; height: auto; }
  }
  @media (min-width: 1024px) {
    .dpos { position: absolute; inset-inline-start: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u)); width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u)); }
    .row { margin-inline-start: calc(-118 * var(--u)); width: calc(1248 * var(--u)); height: calc(231 * var(--u)); }
    .card { position: absolute; inset-inline-start: calc(var(--l) * var(--u)); top: 0; }
  }
  /* RTL: flip the decorative masked shape itself (its box is already mirrored) */
  :global([dir='rtl']) .shape { scale: -1 1; }
</style>
