---
import { Picture } from 'astro:assets';
import { px, vwSizes } from '../../lib/scale';
import mapVector from '../../assets/facilities/map-vector.svg';
import pin4243 from '../../assets/facilities/map-pin.svg';
import pin4342 from '../../assets/facilities/map-pin-43x42.svg';
import pin32 from '../../assets/facilities/map-pin-32.svg';
import { content, t } from '../../lib/content';
import { img } from '../../lib/images';
import { parsePath } from '../../lib/editions';
import hospitalsData from '../../data/hospitals.json';
import { hospitalHref } from '../../lib/hospitals';

/*
 * Home "Bringing Expert Care Closer to You Across the Region" (bug 133, client design 15 Oct 2026; no Figma frame for this
 * version). The Figma section (93:894, page y 2054-2842) had a white hospital list beside the map; the client asked for the
 * list to go, the title centred above the map, the map centred, and the hospitals reachable from their PINS instead:
 * hover / tap / keyboard focus on a pin opens a small card (photo, name, city, Book Appointment, Visit Page). The map rises in
 * when the section scrolls into view and the pins drop in one after the other (scripts/hospital-map.ts + CSS below; nothing
 * moves with prefers-reduced-motion, every pin still works). The navy band, the heading style, the map art, the pin art and
 * the six counters are the Figma ones; the stats row now sits centred under the map.
 */
const { edition } = parsePath(Astro.url.pathname);
const c = content('home/facilities', edition.locale);
// Map group origin in Figma (page 454, 2226); pins and labels below are Figma page px, converted to map px (478 x 382 vector).
const MX = 454;
const MY = 2226;
// Design only; label text comes from home/facilities JSON (mapLabels), zipped by index.
const labelPos = [
  { x: 794, y: 2320, w: 55 },
  { x: 816, y: 2345, w: 69 },
  { x: 858, y: 2432, w: 70 },
  { x: 931, y: 2400, w: 69 },
  { x: 580.18, y: 2471, w: 69 },
];
// UAE pins and labels (location alignment fix, 9 Oct 2026): in Figma the pin labelled "Abu Dhabi" stood about where Dubai is on
// this drawing and Al Ain sat south of the Oman border corner. Moved by the pin tip to the hospitals' positions (hospitals.json
// location, projected on the drawing's coastline): Abu Dhabi tip (433, 193), Al Mudeef (421, 203, fanned like Dhahran / Al
// Khobar), Al Ain (460, 196) at the border. The KSA pins are as in Figma. Same targets on the Our Hospitals hero map
// (components/hospitals/HeroMap.astro).
// Country of each map label / pin (Figma order: Dhahran, Al Khobar, Abu Dhabi, Al Ain, Jeddah | pins: Dhahran, Al Khobar,
// Jeddah, Abu Dhabi, Al Mudeef, Al Ain). UAE / KSA editions show their own country's only (bug 048); the map art stays whole.
const labelRegion = ['sa', 'sa', 'ae', 'ae', 'sa'];
const own = (r: string) => edition.region === 'global' || r === edition.region;
const labels = labelPos.map((d, i) => ({ ...d, t: c.mapLabels[i] as string, r: labelRegion[i] })).filter((l) => own(l.r));
// One pin per hospital (slug = hospitals.json): the card content comes from the hospital record, never duplicated here.
const pinDefs = [
  { slug: 'dhahran', f: pin4243, x: 754, y: 2315.81, w: 42, h: 43 },
  { slug: 'al-khobar', f: pin4243, x: 775, y: 2338.81, w: 42, h: 43 },
  { slug: 'jeddah', f: pin4243, x: 552, y: 2432.81, w: 42, h: 43 },
  { slug: 'abu-dhabi', f: pin4342, x: 865.5, y: 2377, w: 43, h: 42 },
  { slug: 'al-mudeef-abu-dhabi', f: pin4342, x: 853.5, y: 2387, w: 43, h: 42 },
  { slug: 'al-ain', f: pin32, x: 898, y: 2390, w: 32, h: 32 },
];
const pins = pinDefs
  .map((p) => {
    const h = hospitalsData.hospitals.find((x) => x.slug === p.slug);
    if (!h) throw new Error(`home/facilities: unknown hospital slug "${p.slug}"`);
    const brand = t(h.brand, edition.locale, 'hospitals');
    const city = t(h.city, edition.locale, 'hospitals');
    // "Visit Page" -> the hospital's detail page (Figma 112:7721); "Book Appointment" opens the pop-up with the hospital noted.
    return { ...p, region: h.region, img: img(h.photo, edition.region), brand, city, alt: `${brand} ${city}`, visitHref: hospitalHref(p.slug, edition) };
  })
  .filter((p) => own(p.region));

// Number + label come from home/facilities JSON (stats), in the Figma order (3 x 2).
const stats = (c.stats as { number: string; label: string }[]).map((s) => ({ n: s.number, l: s.label }));
---

<section class="hm relative bg-navy-alt overflow-x-clip" data-hospital-map aria-labelledby="hm-title">
  <div class="stage">
    <h2 id="hm-title" class="hm-title m-0 font-gotham font-medium text-f28 max-lg:text-f23 leading-34 text-white not-italic whitespace-normal [word-break:break-word] text-center">{c.heading}<span class="text-cyan">{c.headingAccent}</span></h2>

    <!-- Map (Group 9). dir="ltr" (bug 073): geography is never mirrored, the pins and city labels keep their English
         positions on Arabic pages (Jeddah on the west coast); only the label text is Arabic. -->
    <div class="mapwrap">
      <div class="mapbox">
        <div class="mapin" dir="ltr">
          <img class="pm" src={mapVector.src} width={px(478)} height={px(382.084)} alt={c.mapAlt} loading="lazy" decoding="async" style="--x:0;--y:0;--w:478;--h:382.084" />
          {labels.map((l) => (
            <span class="pm font-gotham font-medium leading-[normal] text-white whitespace-nowrap not-italic" aria-hidden="true" style={`--x:${l.x - MX};--y:${l.y - MY};--w:${l.w}`}>{l.t}</span>
          ))}
          {pins.map((p, i) => (
            <div class="spot pm" style={`--x:${p.x - MX};--y:${p.y - MY};--w:${p.w};--h:${p.h};--i:${i}`} data-spot>
              <button type="button" class="pin hit" aria-expanded="false" aria-controls={`hm-card-${p.slug}`} aria-label={p.alt}>
                <img src={p.f.src} width={px(p.w)} height={px(p.h)} alt="" loading="lazy" decoding="async" />
              </button>
              <div class="hcard" id={`hm-card-${p.slug}`} role="group" aria-label={p.alt} dir={edition.dir}>
                <div class="hc-in bg-white rounded-(--radius-card) text-navy">
                  <div class="imgw [&_picture]:block [&_picture]:h-full"><Picture class="block w-full h-full object-cover" src={p.img} formats={['avif']} fallbackFormat="webp" width={px(176)} height={px(138)} widths={[px(176), px(176) * 2]} sizes={vwSizes(176)} loading="lazy" decoding="async" alt={p.alt} /></div>
                  <p class="m-0 font-gotham font-medium not-italic whitespace-normal [word-break:break-word]">
                    <span class="block text-f12 leading-15 text-navy-alt">{p.brand}</span>
                    <span class="block text-f10 leading-16 text-body">{p.city}</span>
                  </p>
                  <div class="actions">
                    <a href={c.book.href} data-hospital={p.slug} class="ui-btn ui-btn-sm hit btn-fill" aria-label={`${c.book.label}: ${p.alt}`}>{c.book.label}</a>
                    <a href={p.visitHref} aria-label={`${c.visit.label}: ${p.alt}`} class="ui-btn ui-btn-sm hit btn-outline hair-50 border-navy text-navy">{c.visit.label}</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Stats. Count-up = the live Home page's six Greenshift .gs-counter blocks (WordPress export, animation audit 8 Oct 2026):
         each stat on its own, linear, from 0 once it is 30 % in view, data-duration 1 / 1.5 / 2 / 1 / 1.5 / 2 s in this order
         (scripts/countup.ts Greenshift mode, as on Our Hospitals / Why Cambridge). -->
    <div class="stats">
      {stats.map((s, i) => (
        <p class="stat m-0 font-gotham font-medium text-white not-italic leading-[1.147] whitespace-normal [word-break:break-word]">
          <span class="sr-only">{s.n}</span>
          <span data-countup data-countup-duration={[1, 1.5, 2, 1, 1.5, 2][i] ?? 2} aria-hidden="true" class="block text-f28 max-lg:text-[length:min(calc(28*var(--u)),6.6vw)] text-cyan">{s.n}</span>
          <span class="block text-f12">{s.l}</span>
        </p>
      ))}
    </div>
  </div>
</section>

<script>
  import '../../scripts/countup';
  import '../../scripts/hospital-map';
</script>

<style>
  img { max-width: none; }
  /* Flow layout (the Figma absolute canvas is gone with the list): heading, map, stats stacked and centred; Figma spacing kept
     (heading top 58, map 37 under the heading box, stats 54 under the map, rows 86 apart; section at least the Figma 788). */
  .stage { height: auto; min-height: calc(var(--h, 788) * var(--u)); display: flex; flex-direction: column; align-items: center; padding: calc(58 * var(--u)) calc(24 * var(--u)) calc(40 * var(--u)); box-sizing: border-box; }
  .hm-title { max-width: calc(600 * var(--u)); }
  .mapwrap { margin-top: calc(37 * var(--u)); }
  .mapbox { width: min(calc(100vw - 32px), calc(546.176 * var(--u))); aspect-ratio: 546.176 / 382.084; position: relative; --m: calc(min(100vw - 32px, 546.176 * var(--u)) / 546.176); }
  .mapin { position: relative; width: 100%; height: 100%; }
  .pm { position: absolute; inset-inline-start: calc(var(--x) * var(--m)); top: calc(var(--y) * var(--m)); width: calc(var(--w) * var(--m)); height: calc(var(--h) * var(--m)); }
  .pm:is(span) { height: auto; font-size: 10px; }

  /* Pins: the Figma pin art inside a button (44px hit layer, .hit); the card hangs above the pin's tip. */
  .pin { display: block; width: 100%; height: 100%; padding: 0; margin: 0; border: 0; background: none; cursor: pointer; border-radius: 50%; }
  .pin > img { display: block; width: 100%; height: 100%; }
  .pin:focus-visible { outline: 2px solid var(--color-cyan); outline-offset: 2px; }
  /* Mouse / trackpad: the pointer target is the pin's round head, not its square box, so the fanned pairs (Abu Dhabi / Al Mudeef,
     Dhahran / Al Khobar) each stay reachable where they show. Touch keeps the square 44px hit layer (.hit). */
  @media (hover: hover) and (pointer: fine) { .pin { clip-path: circle(48% at 50% 42%); } }
  .spot:hover, .spot:focus-within, .spot[data-open] { z-index: 2; }
  /* Card: 200 Figma px wide, centred on the pin, its bottom just over the pin (the padding is the hover bridge from pin to
     card, so the pointer never crosses a gap). Shown on hover / focus-within (keyboard) / data-open (tap, click). --dx = the
     script's horizontal clamp so the card never leaves the section; [data-flip] puts it under a pin too close to the top. */
  .hcard { position: absolute; left: 50%; bottom: calc(100% - 6px); width: calc(170 * var(--u)); padding-bottom: 10px; translate: calc(-50% + var(--dx, 0px)) 0; visibility: hidden; opacity: 0; transition: opacity 0.18s ease, visibility 0s linear 0.18s; }
  .spot[data-flip] .hcard { bottom: auto; top: calc(100% - 6px); padding-bottom: 0; padding-top: 10px; }
  .spot:hover .hcard, .spot:focus-within .hcard, .spot[data-open] .hcard { visibility: visible; opacity: 1; transition: opacity 0.18s ease; }
  .hc-in { position: relative; padding: calc(10 * var(--u)); box-shadow: var(--shadow-tile); }
  /* pointer under (over, when flipped) the card, on the pin's axis whatever --dx is */
  .hc-in::after { content: ''; position: absolute; left: calc(50% - var(--dx, 0px)); bottom: -7px; width: 14px; height: 14px; background: #fff; translate: -50% 0; rotate: 45deg; box-shadow: 2px 2px 3px rgba(0, 0, 0, 0.08); }
  .spot[data-flip] .hc-in::after { bottom: auto; top: -7px; box-shadow: -2px -2px 3px rgba(0, 0, 0, 0.08); }
  .imgw { width: 100%; aspect-ratio: 464 / 364; overflow: hidden; border-radius: calc(4 * var(--u)); margin-bottom: calc(8 * var(--u)); }
  /* Book + Visit (bug 044/050): the shared .ui-btn-sm pair, stacked full width; each 44px hit layer stops at half the 8px gap. */
  .actions { display: flex; flex-direction: column; gap: 8px; margin-top: calc(8 * var(--u)); }
  .actions > a { --hit-h: calc(100% + 8px); }

  /* Stats: 3 x 2 centred under the map, start-aligned text, the Figma hairline (#418EA2, 38 tall) between columns. */
  .stats { display: grid; grid-template-columns: repeat(3, auto); column-gap: 0; row-gap: calc(40 * var(--u)); margin-top: calc(54 * var(--u)); max-width: 100%; }
  .stat { position: relative; padding-inline: calc(24 * var(--u)); min-width: calc(150 * var(--u)); box-sizing: border-box; }
  .stat:nth-child(3n + 2)::before, .stat:nth-child(3n + 3)::before { content: ''; position: absolute; inset-inline-start: 0; top: 50%; translate: 0 -50%; width: 1px; height: calc(38 * var(--u)); background: #418ea2; }
  @media (max-width: 1023.98px) {
    .hcard { width: 220px; } /* --u is fixed below 1024 (170u = 233px): a phone card stays narrower than the map */
    .stage { padding: 40px 16px; gap: 0; }
    .mapwrap { margin-top: 32px; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 24px; margin-top: 32px; width: 100%; max-width: calc(360 * var(--u)); }
    .stat { min-width: 0; padding-inline: 16px; }
    .stat::before { display: none; }
    .stat:nth-child(2n)::before { display: block; }
  }

  /* Entrance (scripts/hospital-map.ts adds .in when 25 % of the section is in view; html.aos = IntersectionObserver present and
     no prefers-reduced-motion, set in BaseLayout, so without either the section is simply visible): the map fades and rises
     over 0.7 s, then the pins drop in one after the other (0.12 s apart) with a short bounce. */
  :global(html.aos) .hm:not(.in) .mapwrap { opacity: 0; translate: 0 24px; }
  :global(html.aos) .hm .mapwrap { transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), translate 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  :global(html.aos) .hm:not(.in) .spot { opacity: 0; }
  :global(html.aos) .hm.in .spot { animation: pin-drop 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(0.5s + var(--i) * 0.12s); }
  @keyframes pin-drop {
    0% { opacity: 0; translate: 0 -28px; }
    55% { opacity: 1; translate: 0 3px; }
    78% { translate: 0 -3px; }
    100% { opacity: 1; translate: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hm .mapwrap, .hm .spot { opacity: 1 !important; translate: none !important; animation: none !important; transition: none !important; }
    .hcard { transition: none !important; }
  }
</style>
