---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import mapVector from '../../assets/facilities/map-vector.svg';
import pin4243 from '../../assets/facilities/map-pin.svg';
import pin4342 from '../../assets/facilities/map-pin-43x42.svg';
import pin32 from '../../assets/facilities/map-pin-32.svg';
import line8 from '../../assets/facilities/line8.svg';
import line9 from '../../assets/facilities/line9.svg';
import { content, t } from '../../lib/content';
import { img } from '../../lib/images';
import { parsePath } from '../../lib/editions';
import hospitalsData from '../../data/hospitals.json';
import { hospitalHref } from '../../lib/hospitals';

// Section page-y origin = 2054. Map group origin (page) = (454, 2226).
const { edition } = parsePath(Astro.url.pathname);
const c = content('home/facilities', edition.locale);
const MX = 454;
const MY = 2226 - 2054;
// Design only; label text comes from home/facilities JSON (mapLabels), zipped by index.
const labelPos = [
  { x: 794, y: 2320 - 2054, w: 55 },
  { x: 816, y: 2345 - 2054, w: 69 },
  { x: 930.18, y: 2380 - 2054, w: 70 },
  { x: 921, y: 2434 - 2054, w: 69 },
  { x: 580.18, y: 2471 - 2054, w: 69 },
];
// Country of each map label / pin (Figma order: Dhahran, Al Khobar, Abu Dhabi, Al Ain, Jeddah | pins: Dhahran, Al Khobar,
// Jeddah, Abu Dhabi x 2, Al Ain). UAE / KSA editions show their own country's only (bug 048); the map art stays whole.
const labelRegion = ['sa', 'sa', 'ae', 'ae', 'sa'];
const pinRegion = ['sa', 'sa', 'sa', 'ae', 'ae', 'ae'];
const own = (r: string) => edition.region === 'global' || r === edition.region;
const labels = labelPos.map((d, i) => ({ ...d, t: c.mapLabels[i] as string, r: labelRegion[i] })).filter((l) => own(l.r));
const pins = [
  { f: pin4243, x: 754, y: 2315.81 - 2054, w: 42, h: 43 },
  { f: pin4243, x: 775, y: 2338.81 - 2054, w: 42, h: 43 },
  { f: pin4243, x: 552, y: 2432.81 - 2054, w: 42, h: 43 },
  { f: pin4342, x: 860, y: 2383.81 - 2054, w: 43, h: 42 },
  { f: pin4342, x: 887, y: 2370.81 - 2054, w: 43, h: 42 },
  { f: pin32, x: 894, y: 2410 - 2054, w: 32, h: 32 },
].filter((_, i) => own(pinRegion[i]));

// Rows (card top = page y 2124, card x = 64): a flow list since bug 044/050. Figma rows sit at a 113 pitch (photo 116 x 91 at
// card x 13, first at y 15; name 14 under the photo top, buttons at +47; divider 12 under the photo, 350 wide from x 0; 25
// under the last photo); the CSS below reproduces that pitch (photo narrowed under 1440 so the button pair stays on one line
// from 1280), and a row grows where the pair stacks (1024-1279, phones), so the card and the section grow instead of overlapping.
// Hospitals of this edition's country only (bug 048; Global = all six), in the JSON order; the white card ends under the last.
const slugs = (c.hospitals as string[]).filter((slug) => {
  const h = hospitalsData.hospitals.find((x) => x.slug === slug);
  if (!h) throw new Error(`home/facilities: unknown hospital slug "${slug}"`);
  return own(h.region);
});
const rows = slugs.map((slug) => {
  const h = hospitalsData.hospitals.find((x) => x.slug === slug)!;
  const brand = t(h.brand, edition.locale, 'hospitals');
  const city = t(h.city, edition.locale, 'hospitals');
  // "Visit Page" -> the hospital's detail page (Figma 112:7721); "Book Appointment" opens the pop-up with the hospital noted.
  return { img: img(h.photo, edition.region), name: `${brand} `, city, alt: `${brand} ${city}`, slug: h.slug, visitHref: hospitalHref(h.slug, edition) };
});

// Design only; number + label come from home/facilities JSON (stats), zipped by index.
const statPos = [
  { x: 510, y: 2662, w: 152 },
  { x: 694, y: 2662, w: 132 },
  { x: 852, y: 2662, w: 131 },
  { x: 510, y: 2748, w: 152 },
  { x: 701, y: 2748, w: 112 },
  { x: 852, y: 2748, w: 112 },
];
const stats = statPos.map((d, i) => ({ ...d, n: c.stats[i].number as string, l: c.stats[i].label as string }));
---

<section class="relative bg-navy-alt overflow-x-clip" style="--h: 788">
  <div class="stage max-lg:flex max-lg:flex-col max-lg:items-center max-lg:gap-8 max-lg:px-4 max-lg:py-10">
    <h2 class="dpos font-gotham font-medium text-f28 max-lg:text-f23 leading-34 text-white not-italic whitespace-normal [word-break:break-word] max-lg:text-center" style="--x:480;--y:58;--w:494;--h:77">{c.heading}<span class="text-cyan">{c.headingAccent}</span></h2>

    <!-- Map (Group 9) -->
    <div class="mapbox dpos" style={`--x:${MX};--y:${MY};--w:546.176;--h:382.084`}>
      <div class="mapin">
        <img class="pm" src={mapVector.src} width={px(478)} height={px(382.084)} alt={c.mapAlt} loading="lazy" decoding="async" style="--x:0;--y:0;--w:478;--h:382.084" />
        {labels.map((l) => (
          <span class="pm font-gotham font-medium leading-[normal] text-white whitespace-nowrap not-italic" style={`--x:${l.x - MX};--y:${l.y - MY};--w:${l.w}`}>{l.t}</span>
        ))}
        {pins.map((p) => (
          <img class="pm" src={p.f.src} width={px(p.w)} height={px(p.h)} alt="" loading="lazy" decoding="async" style={`--x:${p.x - MX};--y:${p.y - MY};--w:${p.w};--h:${p.h}`} />
        ))}
      </div>
    </div>

    <!-- Hospitals list -->
    <div class="list dpos" style="--x:64;--y:30;--w:358">
      <!-- Tab + card corners: --radius-card (Figma r8, bug 049), same corners as Figma. -->
      <div class="dpos2 bg-cyan rounded-t-(--radius-card) text-navy" style="--x:0;--y:0;--w:149;--h:40">
        <span class="dpos2 font-gotham font-medium text-f13 leading-15 text-center not-italic" style="--x:33;--y:15;--w:78;--h:15">{c.listTab}</span>
      </div>
      <ul class="card m-0 list-none bg-white rounded-b-(--radius-card) rounded-se-(--radius-card)">
        {rows.map((r, i) => (
          <li class="row">
            <div class="imgw [&_picture]:block [&_picture]:h-full"><Picture class="block w-full h-full object-cover" src={r.img} formats={['avif']} fallbackFormat="webp" width={px(116)} height={px(91)} widths={[px(116), px(116) * 2]} sizes={`${px(116)}px`} loading="lazy" decoding="async" alt={r.alt} /></div>
            <div class="info">
              <h3 class="m-0 font-gotham font-medium not-italic whitespace-normal [word-break:break-word]">
                <span class="block text-f12 leading-15 text-navy-alt">{r.name}</span>
                <span class="block text-f10 leading-16 text-body">{r.city}</span>
              </h3>
              <!-- Book Appointment + Visit Page (bug 044/050): the shared .ui-btn-sm pair in one wrapping row, instead of Figma's
                   118 x 25 / 68 x 20 boxes with 10 / 9px labels. -->
              <div class="actions">
                <a href={c.book.href} data-hospital={r.slug} class="ui-btn ui-btn-sm hit btn-fill bg-cyan text-navy" aria-label={`${c.book.label}: ${r.alt}`}>{c.book.label}</a>
                <a href={r.visitHref} aria-label={`${c.visit.label}: ${r.alt}`} class="ui-btn ui-btn-sm hit btn-outline hair-50 border-navy text-navy">{c.visit.label}</a>
              </div>
            </div>
            {i < rows.length - 1 && <img class="divider" src={line9.src} width={px(350)} height={px(1)} alt="" loading="lazy" decoding="async" />}
          </li>
        ))}
      </ul>
    </div>

    <!-- Stats -->
    <!-- Count-up = the live Home page's six Greenshift .gs-counter blocks (WordPress export, animation audit 8 Oct 2026): each
         stat on its own, linear, from 0 once it is 30 % in view, data-duration 1 / 1.5 / 2 / 1 / 1.5 / 2 s in this order
         (scripts/countup.ts Greenshift mode, as on Our Hospitals / Why Cambridge). -->
    <div class="stats grid grid-cols-2 gap-x-6 gap-y-6 w-full max-w-[calc(360*var(--u))] lg:contents">
      {stats.map((s, i) => (
        <p class="dpos m-0 font-gotham font-medium text-white not-italic leading-[1.147] whitespace-normal [word-break:break-word]" style={`--x:${s.x};--y:${s.y - 2054};--w:${s.w}`}>
          <span class="sr-only">{s.n}</span>
          <span data-countup data-countup-duration={[1, 1.5, 2, 1, 1.5, 2][i] ?? 2} aria-hidden="true" class="block text-f28 max-lg:text-[length:min(calc(28*var(--u)),6.6vw)] text-cyan">{s.n}</span>
          <span class="block text-f12">{s.l}</span>
        </p>
      ))}
    </div>
    <span class="vline dpos" aria-hidden="true" style="--x:677;--y:608;--w:0.15;--h:38"><img src={line8.src} width={px(38)} height={px(0.15)} alt="" /></span>
    <span class="vline dpos" aria-hidden="true" style="--x:826;--y:608;--w:0.15;--h:38"><img src={line8.src} width={px(38)} height={px(0.15)} alt="" /></span>
    <span class="vline dpos" aria-hidden="true" style="--x:677;--y:694;--w:0.15;--h:38"><img src={line8.src} width={px(38)} height={px(0.15)} alt="" /></span>
    <span class="vline dpos" aria-hidden="true" style="--x:826;--y:694;--w:0.15;--h:38"><img src={line8.src} width={px(38)} height={px(0.15)} alt="" /></span>
  </div>
</section>

<script>
  import '../../scripts/countup';
</script>

<style>
  img { max-width: none; }
  .mapbox { width: min(calc(100vw - 32px), calc(546.176 * var(--u))); aspect-ratio: 546.176 / 382.084; position: relative; --m: calc(min(100vw - 32px, 546.176 * var(--u)) / 546.176); }
  .mapin { position: relative; width: 100%; height: 100%; }
  .pm:is(span) { font-size: 10px; }
  .pm { position: absolute; inset-inline-start: calc(var(--x) * var(--m)); top: calc(var(--y) * var(--m)); width: calc(var(--w) * var(--m)); height: calc(var(--h) * var(--m)); }
  .pm:is(span) { height: auto; }
  .list { width: 100%; max-width: calc(358 * var(--u)); }
  .card { padding: calc(13 * var(--u)); display: flex; flex-direction: column; gap: calc(10 * var(--u)); }
  /* Photo column = Figma 116 unless the text column would be narrower than its widest button (phones ~360): then the photo
     gives way (min-content), so "Book Appointment" keeps its padding instead of being squeezed. */
  .row { display: grid; grid-template-columns: minmax(0, calc(116 * var(--u))) minmax(min-content, 1fr); column-gap: calc(12 * var(--u)); align-items: start; }
  .row > .imgw { grid-column: 1; grid-row: 1; }
  .row > :global(img.divider) { grid-column: 1 / -1; margin-top: calc(10 * var(--u)); max-width: 100%; height: auto; }
  .info { grid-column: 2; grid-row: 1; }
  /* fit-content: on one line the pair keeps its own widths; once it wraps the box is the full column and both buttons grow to
     it, so stacked buttons are the same width, aligned (1024-1279 and phones). */
  .actions { display: flex; flex-wrap: wrap; gap: calc(6 * var(--u)); margin-top: calc(8 * var(--u)); width: fit-content; max-width: 100%; }
  .actions > a { flex-grow: 1; }
  .imgw { width: 100%; height: calc(91 * var(--u)); }
  .list > .dpos2:first-child { position: relative; }
  .vline, .stats { display: none; }
  .stats { display: grid; }
  @media (min-width: 1024px) {
    .dpos, .dpos2 { position: absolute; inset-inline-start: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u)); width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u)); }
    /* The list is in the stage's flow at its Figma spot (64, 30), so a list grown by wrapped buttons makes the section taller
       (the Figma 788 is the minimum); the tab stays on top of the card (absolute, 40 high). Figma row pitch 113 = photo 91 +
       12 + divider 1 + 9; the name 14 under the photo top, the buttons 2 under the name (Figma +47). */
    .stage { height: auto; min-height: calc(var(--h) * var(--u)); }
    .list.dpos { position: relative; inset-inline-start: auto; top: auto; height: auto; margin: calc(30 * var(--u)) 0 calc(24 * var(--u)); margin-inline-start: calc(64 * var(--u)); padding-top: calc(40 * var(--u)); box-sizing: border-box; }
    .card { padding-block: calc(15 * var(--u)) calc(25 * var(--u)); padding-inline: calc(13 * var(--u)) calc(4 * var(--u)); gap: calc(9 * var(--u)); } /* end padding 4: the button pair fits one line from 1440 */
    .row { column-gap: calc(15 * var(--u)); }
    .row > :global(img.divider) { margin: calc(12 * var(--u)) 0 0; margin-inline-start: calc(-13 * var(--u)); width: calc(100% + 9 * var(--u)); max-width: none; } /* = 350: row 341 (358 - 13 - 4) + 9; a % width so the line does not size the grid columns */
    .info { padding-top: calc(14 * var(--u)); }
    .actions { margin-top: calc(2 * var(--u)); }
    .stats { display: contents; }
    /* Bug 044 regression: under 1440 the Figma photo (116) left ~256px at 1280 / ~273px at 1366 for the ~275px button pair,
       so the pair stacked. Narrower photo (same height, cropped) + tighter gap: the pair stays on one line from 1280 (about
       10px to spare); 1024-1279 may stack (see .actions below). 1440+ keeps the Figma values. */
    @media (max-width: 1439.98px) {
      .row { grid-template-columns: minmax(0, calc(96 * var(--u))) minmax(min-content, 1fr); column-gap: calc(12 * var(--u)); }
    }
    .vline { display: block; }
    .vline img { position: absolute; width: calc(38 * var(--u)); height: calc(0.15 * var(--u)); inset-inline-start: calc((0.15 - 38) / 2 * var(--u)); top: calc((38 - 0.15) / 2 * var(--u)); transform: rotate(90deg); }
    .mapbox { --m: var(--u); }
    .pm:is(span) { font-size: calc(10 * var(--u)); }
  }
  @media (max-width: 1023.98px) {
    .stats { margin-inline: auto; padding-inline: 16px; box-sizing: border-box; }
    .dpos2 { position: static; }
    .mapbox { position: relative; }
    .list > .dpos2:first-child { width: calc(149 * var(--u)); height: calc(40 * var(--u)); display: flex; align-items: center; justify-content: center; }
    .list > .dpos2:first-child > .dpos2 { position: static; width: auto; height: auto; }
    /* the two buttons are stacked 10px apart (6 Figma px = 8px was too tight for 44px targets): grow each hit layer by half the gap only, so they never overlap */
    .actions { gap: 10px; }
    .actions a { --hit-h: calc(100% + 10px); }
  }
</style>
