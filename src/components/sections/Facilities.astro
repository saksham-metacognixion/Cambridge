---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import mapRaw from '../../assets/facilities/map-vector.svg?raw';
import { content, t } from '../../lib/content';
import { img } from '../../lib/images';
import { parsePath } from '../../lib/editions';
import hospitalsData from '../../data/hospitals.json';
import { hospitalHref } from '../../lib/hospitals';

/*
 * Home "Bringing Expert Care Closer to You Across the Region" (bug 133, client design 15 Oct 2026; no Figma frame for this
 * version). The Figma section (93:894, page y 2054-2842) had a white hospital list beside the map; the client asked for the
 * list to go, the title centred above the map, the map centred, and the hospitals reachable from their PINS instead.
 *
 * 15 Oct 2026 (client reference `cambridge-locations-2.html`, then its third version `cambridge-locations-3.html` the same
 * day, reproduced here as closely as possible):
 *  - layout (v3): from 1024px a two-column grid, the map on the inline-start side (1.05fr) and a content column (1fr) beside
 *    it with the title (start-aligned, max 640 px) over the six counters (3 x 2, hairline dividers between the columns of a
 *    row, no divider before the first of a row); below 1024 the content column stacks ABOVE the map (counters centred), and
 *    below 640 the counters are 2 x 3 with wrapping labels. The reference's px are the site's Figma units (x 1 / 1.3688) on
 *    the desktop canvas so the section scales with the page; its literal px below 1024 where the canvas is dropped.
 *  - entrance once 25 % of the section is in view (scripts/hospital-map.ts adds `.in`; never replays): the title fades up
 *    (0.8 s from 0.2 s), the map outline draws itself in (2.2 s, stroke-dashoffset; the Figma ring fades in after 1.7 s so the
 *    map ends as the Figma art), every pin drops from 140 map px above with a two-step bounce (0.95 s, 1.1 s + 0.2 s per
 *    pin), then bobs (2.6 s loop) over a pulse ring at its tip, its city label fades in 0.6 s after the drop starts; the
 *    counters fade up 0.6 s + 0.12 s per counter after the entrance and count 0 -> value over 2 s, ease-out cubic, 0.7 s +
 *    0.12 s per counter after it (the reference's own counter, not the Greenshift one of the other pages).
 *  - a pin = the reference's vector pin (outlined teardrop + dot) in the brand colours (section navy fill, cyan outline and
 *    dot), sized to the Figma pin box so the tips stay where the 9 Oct alignment put them; hover / focus / open = 1.18 scale
 *    from the tip, solid cyan with a white dot.
 *  - hover (mouse), tap (touch), focus / Enter / Space (keyboard) open the hospital card: the removed list item (photo, name,
 *    city, Book Appointment, Visit Page) as the reference's floating card (white, 430 wide max, photo 128 x 112 beside the text,
 *    arrow on the pin's axis), above the pin when there is room, else under it, kept inside the map's width; it fades and slides
 *    in / out over 0.22 s, and a card hovered keeps itself open (260 ms grace from pin to card). The Abu Dhabi pin is ONE pin
 *    whose card lists both Abu Dhabi Hospital and Al Mudeef Centre (the client's point 4; the 9 Oct fanned second pin is gone).
 *  - nothing moves with prefers-reduced-motion (html.aos absent): everything is visible at once, the counters show their values.
 * The navy band, the heading style, the map art (the Figma silhouette, now also outlined like the reference's countries), the
 * pin positions, the city labels and the six counters are the Figma / live ones (brand colours, not the reference's #1b3851 /
 * #43a8f2); cards come from hospitals.json.
 */
const { edition } = parsePath(Astro.url.pathname);
const c = content('home/facilities', edition.locale);
// Map group origin in Figma (page 454, 2226); pins and labels below are Figma page px, converted to map px (478 x 382 vector).
const MX = 454;
const MY = 2226;
// The Figma map silhouette as an inline path so its outline can draw itself in (one path, four sub-paths).
const mapPath = mapRaw.match(/\sd="([^"]+)"/)?.[1];
if (!mapPath) throw new Error('home/facilities: map-vector.svg has no path');
// The reference pin: tip at (0, 0), head centre (0, -27) r 15, 30 wide, 42 tall; scaled per pin to the Figma pin art's width.
const PIN_D = 'M0 0C-4-7-15-15-15-27A15 15 0 1 1 15-27C15-15 4-7 0 0Z';
// Design only; label text comes from home/facilities JSON (mapLabels), zipped by index. `pin` = the pin whose drop delay the
// label follows (reference: a label fades in 0.6 s after its pin starts dropping).
const labelPos = [
  { x: 794, y: 2320, w: 55, pin: 'dhahran' },
  { x: 816, y: 2345, w: 69, pin: 'al-khobar' },
  { x: 858, y: 2432, w: 70, pin: 'abu-dhabi' },
  { x: 931, y: 2400, w: 69, pin: 'al-ain' },
  { x: 580.18, y: 2471, w: 69, pin: 'jeddah' },
];
// UAE pins and labels (location alignment fix, 9 Oct 2026): in Figma the pin labelled "Abu Dhabi" stood about where Dubai is on
// this drawing and Al Ain sat south of the Oman border corner. Moved by the pin tip to the hospitals' positions (hospitals.json
// location, projected on the drawing's coastline): Abu Dhabi tip (433, 193), Al Ain (460, 196) at the border. The KSA pins are
// as in Figma. Same targets on the Our Hospitals hero map (components/hospitals/HeroMap.astro).
// Country of each map label / pin (Figma order: Dhahran, Al Khobar, Abu Dhabi, Al Ain, Jeddah | pins: Dhahran, Al Khobar,
// Jeddah, Abu Dhabi, Al Ain). UAE / KSA editions show their own country's only (bug 048); the map art stays whole.
const labelRegion = ['sa', 'sa', 'ae', 'ae', 'sa'];
const own = (r: string) => edition.region === 'global' || r === edition.region;
// One pin per place; `group` = the hospitals on its card (slugs = hospitals.json; the card content comes from the record, never
// duplicated here). Box = the Figma pin box (x, y, w, h in page px); tip / span = where the tip sits in that box and how wide the
// Figma teardrop is (the 42 x 43 and 43 x 42 arts: tip 39.42 / 38.5 from the top, 28 / 28.67 wide; the 32 art: 29.33, 21.33).
const pinDefs = [
  { slug: 'dhahran', group: ['dhahran'], x: 754, y: 2315.81, w: 42, h: 43, tip: 39.42, span: 28 },
  { slug: 'al-khobar', group: ['al-khobar'], x: 775, y: 2338.81, w: 42, h: 43, tip: 39.42, span: 28 },
  { slug: 'jeddah', group: ['jeddah'], x: 552, y: 2432.81, w: 42, h: 43, tip: 39.42, span: 28 },
  { slug: 'abu-dhabi', group: ['abu-dhabi', 'al-mudeef-abu-dhabi'], x: 865.5, y: 2377, w: 43, h: 42, tip: 38.5, span: 28.67 },
  { slug: 'al-ain', group: ['al-ain'], x: 898, y: 2390, w: 32, h: 32, tip: 29.33, span: 21.33 },
];
const hospital = (slug: string) => {
  const h = hospitalsData.hospitals.find((x) => x.slug === slug);
  if (!h) throw new Error(`home/facilities: unknown hospital slug "${slug}"`);
  const brand = t(h.brand, edition.locale, 'hospitals');
  const city = t(h.city, edition.locale, 'hospitals');
  // "Visit Page" -> the hospital's detail page (Figma 112:7721); "Book Appointment" opens the pop-up with the hospital noted.
  return { slug, region: h.region, img: img(h.photo, edition.region), brand, city, alt: `${brand} ${city}`, visitHref: hospitalHref(slug, edition) };
};
const pins = pinDefs
  .map((p) => ({ ...p, rows: p.group.map(hospital) }))
  .filter((p) => own(p.rows[0].region))
  .map((p, i) => ({ ...p, i, d: 1.1 + i * 0.2, alt: p.rows.map((r) => r.alt).join(', ') }));
const delayOf = (slug: string) => pins.find((p) => p.slug === slug)?.d ?? 1.1;
const labels = labelPos.map((d, i) => ({ ...d, t: c.mapLabels[i] as string, r: labelRegion[i] })).filter((l) => own(l.r));

// Number + label come from home/facilities JSON (stats), in the Figma order (2 x 3 on the map).
const stats = (c.stats as { number: string; label: string }[]).map((s) => ({ n: s.number, l: s.label }));
---

<section class="hm relative bg-navy-alt overflow-x-clip" data-hospital-map aria-labelledby="hm-title">
  <div class="stage">
    <div class="inner">
      <!-- Title + counters (reference .cl-content). First in the DOM so the heading precedes the pin buttons; the desktop grid
           puts this column beside the map (inline-end), the stacked layout keeps it above. Screen readers read the sr-only
           counter value; the animated span is aria-hidden and holds the final text until the entrance zeroes it. -->
      <div class="hcontent">
        <h2 id="hm-title" class="hm-title m-0 font-gotham font-medium text-f28 max-lg:text-f23 leading-34 text-white not-italic whitespace-normal [word-break:break-word]">{c.heading}<span class="text-cyan">{c.headingAccent}</span></h2>
        <div class="stats">
          {stats.map((s, i) => (
            <p class="stat m-0 font-gotham font-medium text-white not-italic whitespace-normal" style={`--i:${i}`}>
              <span class="sr-only">{s.n}</span>
              {/* lang="en": WebKit shapes the Latin digits with the page language and skips Gotham's tabular-figures feature
                  under Arabic (proportional figures 12 % wider: "340,000+" 211 px instead of 188 at 1440, overflowing the
                  column); Chrome / Firefox already render them tabular. Measured 15 Oct 2026. */}
              <span data-hm-count aria-hidden="true" lang="en" class="num block text-cyan">{s.n}</span>
              <span class="lbl-stat block">{s.l}</span>
            </p>
          ))}
        </div>
      </div>

      <!-- Map (Group 9). dir="ltr" (bug 073): geography is never mirrored, the pins and city labels keep their English
           positions on Arabic pages (Jeddah on the west coast); only the label text is Arabic. -->
      <div class="mapbox">
        <div class="mapin" dir="ltr" data-mapin>
          <svg class="pm map" viewBox="0 0 478 382.084" preserveAspectRatio="none" role="img" aria-label={c.mapAlt} style="--x:0;--y:0;--w:478;--h:382.084">
            <path class="country" pathLength="1" d={mapPath} />
          </svg>
          {labels.map((l) => (
            <span class="pm lbl font-gotham font-medium leading-[normal] text-white whitespace-nowrap not-italic" aria-hidden="true" style={`--x:${l.x - MX};--y:${l.y - MY};--w:${l.w};--d:${delayOf(l.pin)}s`}>{l.t}</span>
          ))}
          {pins.map((p) => (
            <div class="spot pm" style={`--x:${p.x - MX};--y:${p.y - MY};--w:${p.w};--h:${p.h};--d:${p.d}s;--tip:${p.tip}`} data-spot>
              <div class="drop">
                <span class="pulse" aria-hidden="true"></span>
                <div class="bob">
                  <button type="button" class="pin hit" aria-expanded="false" aria-controls={`hm-card-${p.slug}`} aria-label={p.alt}>
                    <svg class="shape" viewBox={`${-p.w / 2} ${-p.tip} ${p.w} ${p.h}`} style={`transform-origin:50% ${((p.tip / p.h) * 100).toFixed(2)}%`} aria-hidden="true" focusable="false">
                      <g transform={`scale(${(p.span / 30).toFixed(4)})`}>
                        <path d={PIN_D} />
                        <circle cx="0" cy="-27" r="5" />
                      </g>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="hcard" id={`hm-card-${p.slug}`} role="group" aria-label={p.alt} dir={edition.dir}>
                {p.rows.map((r) => (
                  <div class="hrow">
                    <div class="imgw [&_picture]:block [&_picture]:h-full"><Picture class="block w-full h-full object-cover" src={r.img} formats={['avif']} fallbackFormat="webp" width={256} height={224} widths={[128, 256]} sizes="(max-width: 480px) 96px, 128px" loading="lazy" decoding="async" alt={r.alt} /></div>
                    <div class="hbody">
                      <p class="m-0 font-gotham font-medium not-italic whitespace-normal [word-break:break-word]">
                        <span class="block text-f12 leading-15 text-navy-alt">{r.brand}</span>
                        <span class="block text-f10 leading-16 text-body">{r.city}</span>
                      </p>
                      <div class="actions">
                        <a href={c.book.href} data-hospital={r.slug} class="ui-btn ui-btn-sm hit btn-fill" aria-label={`${c.book.label}: ${r.alt}`}>{c.book.label}</a>
                        <a href={r.visitHref} aria-label={`${c.visit.label}: ${r.alt}`} class="ui-btn ui-btn-sm hit btn-outline hair-50 border-navy text-navy">{c.visit.label}</a>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hospital-map';
</script>

<style>
  /* Layout = the reference's .cl-inner (v3): a 1.05fr | 1fr grid, map on the inline-start side, title + counters beside it,
     vertically centred; its px as Figma units at 1440 (padding 70 / 24 -> 51.14u / 17.54u, gap 48 -> 35.07u) so the section
     scales with the page like the rest of the canvas. .hcontent is first in the DOM (heading before the pin buttons) and the
     explicit grid areas put it in the second column. */
  .stage { padding: calc(51.14 * var(--u)) calc(17.54 * var(--u)); box-sizing: border-box; }
  .inner { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: calc(35.07 * var(--u)); }
  .hcontent { grid-column: 2; grid-row: 1; min-width: 0; }
  .hm-title { max-width: calc(467.56 * var(--u)); margin-bottom: calc(40.91 * var(--u)); text-align: start; } /* 640 / 56 px */
  /* --m = 1 map px on screen. Desktop: the Figma map group (546.176 wide: drawing 478 + the labels beside it) fills the map
     column, which is (1052 - 2 x 17.54 - 35.07) x 1.05 / 2.05 = 502.9u wide -> 0.92077u per map px (drawing 602 px at 1440;
     the reference's countries span about 634 of its 688 px column). Below 1024: the group fits the viewport less the
     gutters, never above 1 Figma unit. NOT a CSS container: --u is defined in cqw and would shrink inside one. */
  .mapbox { grid-column: 1; grid-row: 1; justify-self: center; --m: calc(0.92077 * var(--u)); width: calc(546.176 * var(--m)); max-width: 100%; aspect-ratio: 546.176 / 382.084; position: relative; }
  .mapin { position: relative; width: 100%; height: 100%; }
  .pm { position: absolute; inset-inline-start: calc(var(--x) * var(--m)); top: calc(var(--y) * var(--m)); width: calc(var(--w) * var(--m)); height: calc(var(--h) * var(--m)); }
  .lbl { height: auto; font-size: max(10px, calc(10 * var(--m))); }

  /* Map: the Figma art is an OUTLINE (a stroke outlined into one ring-shaped fill, #E7E7E7 at 45 %), not a silhouette. The
     reference's white 30 % 1.6px stroke draws itself along it (both edges of the ring, 3px apart, read as one line), then, as the
     reference fades its fill in (1.7 s), the Figma ring fades in and the drawing stroke fades out, so the map ends as in Figma. */
  .map { display: block; overflow: visible; }
  .country { fill: #e7e7e7; fill-opacity: 0.45; stroke: rgba(255, 255, 255, 0.3); stroke-opacity: 0; stroke-width: 1.6; stroke-linejoin: round; vector-effect: non-scaling-stroke; }

  /* Pins: box = the Figma pin box (.pm); --tip = the tip's y in it. .drop / .bob are plain wrappers (their entrance and idle bob
     are gone: all animations removed, 16 Oct 2026), .shape = the drawn pin, .pulse = the (now invisible) ring at the tip. */
  .spot { z-index: 1; }
  .spot[data-active], .spot:focus-within { z-index: 10; } /* above the neighbouring pins and the content column */
  .drop, .bob { position: absolute; inset: 0; }
  .pulse { position: absolute; left: 50%; top: calc(var(--tip) * var(--m)); width: calc(12 * var(--m)); height: calc(5 * var(--m)); margin: calc(-2.5 * var(--m)) 0 0 calc(-6 * var(--m)); border: 1.6px solid var(--color-cyan); border-radius: 50%; box-sizing: border-box; opacity: 0; pointer-events: none; }
  .pin { display: block; width: 100%; height: 100%; padding: 0; margin: 0; border: 0; background: none; cursor: pointer; border-radius: 50%; color: var(--color-navy-alt); }
  .pin:focus-visible { outline: 2px solid var(--color-cyan); outline-offset: 2px; }
  .shape { display: block; width: 100%; height: 100%; overflow: visible; }
  .shape path { fill: currentColor; stroke: var(--color-cyan); stroke-width: 3; }
  .shape circle { fill: var(--color-cyan); }
  .spot[data-active] .shape path, .pin:focus-visible .shape path { fill: var(--color-cyan); }
  .spot[data-active] .shape circle, .pin:focus-visible .shape circle { fill: #fff; }
  /* Mouse / trackpad: the pointer target is the drawn pin, not its square box, so the Dhahran / Al Khobar pair each stay reachable
     where they show. Touch keeps the square 44px hit layer (.hit). */
  @media (hover: hover) and (pointer: fine) {
    .pin, .pin > .shape { pointer-events: none; }
    .pin > .shape * { pointer-events: visiblePainted; } /* the teardrop + dot only, not the svg box (which overlaps the neighbour's head) */
  }

  /* Card (the reference's .hcard, styled as the removed list item): absolute in the map, placed by the script (left / top
     relative to its .spot, --ax = the arrow's x), above the pin or [.below] it; shown at once. 464 wide (the
     reference's 430 + 34) so the .ui-btn-sm pair sits on one line beside the 128px photo as in the reference. */
  .hcard { position: absolute; left: 0; top: 0; z-index: 10; display: flex; flex-direction: column; gap: 12px; width: min(464px, calc(100vw - 32px)); padding: 12px; box-sizing: border-box; background: #fff; color: var(--color-navy); border-radius: var(--radius-card); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28); opacity: 0; visibility: hidden; pointer-events: none; }
  .hcard.show { opacity: 1; visibility: visible; pointer-events: auto; }
  .hcard::after { content: ''; position: absolute; left: var(--ax, 50%); bottom: -7px; width: 14px; height: 14px; background: #fff; transform: translateX(-50%) rotate(45deg); border-radius: 2px; }
  .hcard.below::after { top: -7px; bottom: auto; }
  .hrow { display: flex; gap: 14px; align-items: center; }
  .hrow + .hrow { border-top: 1px solid var(--color-mist); padding-top: 12px; }
  .imgw { flex: 0 0 128px; height: 112px; overflow: hidden; border-radius: calc(4 * var(--u)); background: var(--color-mist-50); }
  .hbody { min-width: 0; flex: 1 1 auto; }
  /* Book + Visit (bug 044/050): the shared .ui-btn-sm pair in one row, wrapping when the card is narrow; each 44px hit layer
     stops at half the gap. */
  .actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: calc(8 * var(--u)); }
  .actions > a { --hit-h: calc(100% + 6px); }
  @media (max-width: 480px) {
    .hrow { gap: 10px; }
    .imgw { flex-basis: 96px; height: 96px; }
  }

  /* Counters (reference .cl-stats v3): 3 x 2 under the title, each column of a row separated by a 1px white 20 % hairline
     on its inline-start side (none before the first of a row), rows 56 px apart (40.91u). Number = the reference's
     clamp(30px, 2.9vw, 48px) at 1440 = 30.5u, label = clamp(14px, 1.05vw, 18px) = 11.05u, 10 px between them (7.3u), scaled
     with the canvas like every other size on it (no px floors from 1024 up: with the reference's 30 / 14 px floors the three
     columns were 554 px in a 466 px column at 1024). Padding 20u (27 px at 1440) instead of the reference's 34 px: measured
     15 Oct 2026, the widest texts ("340,000+", "5,000+" / "Improved Inpatients", "30,000+" = 368u, Arabic 357u) plus five
     paddings have to fit the 479u content column, and 34 px (24.84u) overflowed it by 19 px at 1440 (clipped by the stage).
     Tabular figures so the count-up never shifts. */
  .stats { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; row-gap: calc(40.91 * var(--u)); }
  .stat { padding: 0 calc(20 * var(--u)); border-inline-start: 1px solid rgba(255, 255, 255, 0.2); }
  .stat:nth-child(3n + 1) { padding-inline-start: 0; border-inline-start: 0; }
  .num { font-size: calc(30.5 * var(--u)); line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .lbl-stat { margin-top: calc(7.3 * var(--u)); font-size: calc(11.05 * var(--u)); line-height: 1.3; white-space: nowrap; }

  /* Tablet / phones (reference <= 1024 / <= 640, its literal px: the canvas is dropped here): one column, title + counters
     above the map, counters centred, 40 px between the blocks; under 640 two counter columns with wrapping labels. */
  @media (max-width: 1023.98px) {
    .stage { padding: 70px 24px; }
    .inner { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .hcontent, .mapbox { grid-column: auto; grid-row: auto; }
    .mapbox { --m: min(calc((100vw - 48px) / 546.176), var(--u)); }
    .hm-title { max-width: 640px; margin-bottom: 36px; }
    .stats { justify-content: center; row-gap: 56px; }
    .stat { padding: 0 34px; }
    .num { font-size: 30px; }
    .lbl-stat { margin-top: 10px; font-size: 14px; }
  }
  @media (max-width: 640px) {
    .stage { padding: 56px 16px; }
    .mapbox { --m: min(calc((100vw - 32px) / 546.176), var(--u)); }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 32px; justify-content: stretch; }
    .stat { padding: 0; padding-inline-start: 18px; }
    .stat:nth-child(3n + 1) { padding-inline-start: 18px; border-inline-start: 1px solid rgba(255, 255, 255, 0.2); }
    .stat:nth-child(2n + 1) { padding-inline-start: 0; border-inline-start: 0; }
    .lbl-stat { white-space: normal; }
  }

  /* No entrance (all animations removed, 16 Oct 2026): the map, pins, labels and counters are simply in place. */
</style>
