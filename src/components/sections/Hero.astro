---
import { Picture } from 'astro:assets';
import { heroEdgeVars } from '../../lib/hero-edge';
import { px } from '../../lib/scale';
import { img } from '../../lib/images';
import { parsePath, urlFor } from '../../lib/editions';
import { content } from '../../lib/content';
import { pagePath } from '../../lib/paths';
import overlay from '../../assets/hero/rectangle2.png';
import dots from '../../assets/dots/dots-hero.svg';

const { edition } = parsePath(Astro.url.pathname);
const c = content('home/hero', edition.locale);
// Button target: `page` (key in PAGE_PATHS, edition-aware) wins over the literal href ("Learn More" -> About, docs/open-decisions.md LA2).
const target = (b: { href: string; page?: string }) => (b.page ? urlFor(edition, pagePath(b.page)) : b.href);
// Cursor-follow needs the banner split in two: the people (subject, moves) and the background (stays).
// The layers are only used when they belong to the same picture as this region's banner: if a region has its
// own banner but no layers of its own yet, it gets its flat banner, never another region's layers.
// The flat banner itself is not in src/assets (only its Figma copy in figma-cache), so it isn't shipped unused;
// a region-specific flat banner (src/assets/regions/<ae|sa>/hero/banner3.*) is still picked up here.
const find = (key: string, region?: typeof edition.region) => { try { return img(key, region); } catch { return null; } };
const own = (key: string) => { const r = find(key, edition.region); return !!r && r !== find(key); };
const L = c.banner.layers;
const layers = L && (own(c.banner.image) ? own(L.background) && own(L.subject) : true)
  ? { background: img(L.background, edition.region), subject: img(L.subject, edition.region) }
  : null;
// Paragraph: Figma breaks it after "journey with" (374 wide box); `text` may be a string or the lines of that break
// (kept on the canvas layout only; below 1024px it wraps to the viewport).
const textLines: string[] = Array.isArray(c.text) ? c.text : [c.text];
const bannerProps = {
  formats: ['avif'], fallbackFormat: 'webp', width: px(1052), height: px(500), widths: [720, 1080, px(1052)],
  sizes: '100vw', loading: 'eager', decoding: 'async', pictureAttributes: { class: 'contents' },
} as const;
const cover = 'absolute start-0 top-0 h-full w-full object-cover';
// No Figma frame below 1024px (docs/open-decisions.md P1 / P8), so the small-screen hero is our adaptation of the
// Figma composition. The subject layer is the 1052 x 500 banner with the people in its right half (opaque x 497-982,
// y 60-500; the mother's head at the top, the pair cropped by the banner's bottom edge as in Figma).
// < 768px (phones): stacked, text first (64 Figma px under the hero top, the spacing of the layout approved on 5 Oct),
//   then the mother and baby as their own block under it, never covered by the heading. The layer is drawn wider than
//   the viewport and aligned to the end: 162% wide shows banner x 402-1052 at 390px (people 92px from the edge); from
//   640px the whole banner width fits. In LTR the overflowing layer is pulled left so its right edge meets the
//   viewport's; in RTL the block already starts at the right and overflows left (then the box is mirrored, below).
// 768-1023px (tablets): the desktop composition, text beside the people. One grid row: the text column (at least
//   260 Figma px so "Restoring Hope," stays on one line at 768px, then 1fr) and the image column (1.2fr), the hero as
//   tall as the taller of the two. The image column shows only the people's part of the banner (x 480-1052, aspect
//   572:500, object-position right, cover) bottom-aligned like the desktop canvas, so the people scale with the column
//   and nothing is cropped beyond the banner's own edges; the text column centres vertically. At 1023px the hero is
//   ~472px tall, meeting the scaled desktop canvas (487px at 1024px).
// Both: the static background keeps covering the whole hero, anchored to its plain gradient side: the pill art of its
//   right half is decoration the small-screen layouts hide (docs/mobile-review). The text column carries the gap
//   between heading, paragraph and buttons: the <source> elements of the two "contents" pictures are empty flex / grid
//   items of the stage, so a gap on the stage itself would add phantom space above the heading.
// RTL (bug 020): the whole composition is mirrored, as on the other page heroes (PageHero `rtl:-scale-x-100`): the
//   text sits at the right, so background, people and bottom overlay flip and the people end up on the left. The
//   people are flipped on their clipping box, not on the <img>, whose transform belongs to hero-follow.ts (which
//   reverses its drift in RTL so they still follow the cursor).
const subjectMobile = 'max-md:relative max-md:inset-auto max-md:h-auto max-md:max-w-none max-md:w-[162%] max-md:left-[-62%] max-md:rtl:left-0 sm:max-md:w-full sm:max-md:left-0';
const subjectTablet = 'md:max-lg:object-right';
// Bug 086: beyond 1440 px the static background's edge columns continue to the viewport edges (global.css .hero-bleed); here
// two layers: the banner background (full stage height) and the bottom overlay strip (top 341, h 159), both uniform at the edges.
const edgeVars = (await heroEdgeVars(layers ? layers.background : img(c.banner.image, edition.region))) + (await heroEdgeVars(overlay, 'hero-edge-2')); // build-time gradients of their edge columns
---
<!-- Hero: page y 117, --h 500. Spec y values are page y minus 117. -->
<section class="relative hero-bleed" style={`--h: 500;${edgeVars}`} aria-label={c.ariaLabel}>
  <div class="stage max-md:flex max-md:flex-col max-md:px-[calc(24*var(--u))] max-md:pt-[calc(64*var(--u))] md:max-lg:grid md:max-lg:grid-cols-[minmax(calc(260*var(--u)),1fr)_minmax(0,1.2fr)] md:max-lg:ps-[calc(24*var(--u))]">
    {layers ? (
      <>
        <!-- fetchpriority: on phones the people sit below the fold, so this background is the LCP image. -->
        <Picture src={layers.background} alt="" fetchpriority="high" class={`${cover} max-lg:object-left rtl:-scale-x-100`} {...bannerProps} />
        <!-- The mother and baby drift with the cursor (scripts/hero-follow.ts); clipped to the hero box. -->
        <div data-hero-follow class="absolute inset-0 overflow-hidden rtl:-scale-x-100 max-md:relative max-md:inset-auto max-md:order-last max-md:mt-[calc(24*var(--u))] max-md:-mx-[calc(24*var(--u))] md:max-lg:relative md:max-lg:inset-auto md:max-lg:col-start-2 md:max-lg:row-start-1 md:max-lg:w-full md:max-lg:self-end md:max-lg:aspect-[572/500]">
          <Picture src={layers.subject} alt={c.banner.alt} fetchpriority="high" class={`${cover} ${subjectMobile} ${subjectTablet}`} {...bannerProps} />
        </div>
      </>
    ) : (
      <Picture src={img(c.banner.image, edition.region)} alt={c.banner.alt} fetchpriority="high" class={`${cover} max-lg:object-right rtl:-scale-x-100`} {...bannerProps} />
    )}
    <Picture
      src={overlay}
      formats={['avif']}
      fallbackFormat="webp"
      width={px(1052)}
      height={px(159)}
      widths={[720, 1080, px(1052)]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      alt=""
      class="absolute start-0 top-341 h-159 w-full object-cover max-lg:top-auto max-lg:bottom-0 max-lg:h-[calc(100*var(--u))] rtl:-scale-x-100"
      pictureAttributes={{ class: 'contents' }}
    />

    <!-- Text block: one column in flow at every width (bug 065): heading, paragraph, then the buttons --hero-btn-gap (the
         shared hero text -> button gap, src/styles/global.css; Figma: paragraph box 219..246, buttons at 265) under the
         paragraph's real end, so a paragraph that wraps to more lines (Arabic, narrow widths) pushes the buttons down
         instead of running into them. Below 1024px: phones in the stage's flow, tablets in grid column 1, centred; on the
         desktop canvas the column sits at the heading's Figma position (95, 141) with the paragraph / buttons inset as in
         Figma (97 / 98). -->
    <div class="home-copy relative flex flex-col gap-[calc(16*var(--u))] md:max-lg:col-start-1 md:max-lg:row-start-1 md:max-lg:justify-center md:max-lg:py-[calc(32*var(--u))] lg:absolute lg:start-95 lg:top-141 lg:gap-0">
      <!-- Figma: Gotham Medium 39 on 37px lines (box 258..332), paragraph box at 336 = 4px under it. Below 1024px the
           heading steps down to 28/27 (the Figma section-heading size) so it stays on two lines at 360px. -->
      <h1 class="relative m-0 font-gotham font-medium not-italic text-f39 leading-37 max-lg:text-f28 max-lg:leading-27 text-navy lg:w-374 lg:min-h-74 whitespace-normal [word-break:break-word]">{c.title[0]}<br />{c.title[1]}</h1>

      <p class="relative m-0 font-gotham font-normal not-italic text-f12 leading-14 text-body lg:mt-4 lg:ms-2 lg:w-374 max-lg:max-w-[calc(374*var(--u))] whitespace-normal [word-break:break-word]">{textLines.map((line, i) => (<>{i > 0 && <><br class="max-lg:hidden" />{' '}</>}{line}</>))}</p>

      <!-- Buttons (bug 044/050): the shared .ui-btn size instead of Figma's 138 x 30 boxes with 13px labels, so the pair is one
           flow row (gap 14) starting at the first button's Figma x (98). -->
      <div class="home-btns relative flex flex-wrap gap-[calc(14*var(--u))] lg:ms-3">
        <a href={target(c.buttons[0])} style="--sw:1;--sc:var(--color-cyan)" class="ui-btn hit btn-outline hair-card relative text-navy">{c.buttons[0].label}</a>
        <a href={target(c.buttons[1])} style="--sw:1;--sc:var(--color-cyan)" class="ui-btn hit btn-outline hair-card relative text-navy">{c.buttons[1].label}</a>
      </div>
    </div>

    <!-- Static decorative pager dots (78:759), no behaviour -->
  </div>
</section>

<script>
  import '../../scripts/hero-follow';
</script>

<style>
  /* Bug 086: the home banner fills its 500 stage exactly (100 %), and the overlay strip (top 341, h 159) is a second band layer
     on top of it. Same start / end pairing as global.css (the art is mirrored in RTL). */
  @media (min-width: 1441px) {
    .hero-bleed::before, .hero-bleed::after { background-size: 100% calc(159 * var(--u)), 100% 100%; background-position: 0 calc(341 * var(--u)), 0 0; }
    .hero-bleed::before { background-image: var(--hero-edge-2-start), var(--hero-edge-start); }
    .hero-bleed::after { background-image: var(--hero-edge-2-end), var(--hero-edge-end); }
  }
  /* Bug 065: the buttons --hero-btn-gap under the paragraph (global.css, shared with PageHero); below 1024px the column's
     flex gap (16 Figma px) is already between them, so only the rest is added. */
  .home-btns { margin-top: calc(var(--hero-btn-gap) - 16 * var(--u)); }
  @media (min-width: 1024px) { .home-btns { margin-top: var(--hero-btn-gap); } }
</style>
