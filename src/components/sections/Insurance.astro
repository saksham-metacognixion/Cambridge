---
import { Image } from 'astro:assets';
import { px } from '../../lib/scale';
import line13 from '../../assets/insurance/line13.svg';
import { content } from '../../lib/content';
import { img } from '../../lib/images';
import { parsePath, urlFor } from '../../lib/editions';
import { pagePath } from '../../lib/paths';
import insurerData from '../../data/insurers.json';

const { edition } = parsePath(Astro.url.pathname);
const txt = content('home/insurance', edition.locale);
const viewAll = txt.button.page ? urlFor(edition, pagePath(txt.button.page)) : txt.button.href;

// Frame-relative Figma px (frame x = 30 => page x = value + 30)
// Design per logo, zipped by index with the logos (image key + alt) in home/insurance JSON.
const F = 30;
// SAICO (bug 137, 15 Oct 2026): Figma drew a 37 x 62 slot at 793 for SAICO's round emblem; the client's logo (L3 folder, user
// decision 9 Oct 2026) is the wide wordmark lockup (291 x 131), which rendered 48px wide in that slot. Its box is now 99 wide at
// the logo's own ratio (99 x 44.6, about Daman's size) with the two dividers around it re-centred: Almadallah ends at 730,
// divider 744, SAICO 758..857, divider 871, Nextcare 885 as in Figma. The 14-px logo-to-divider gaps are Figma's own (Daman has
// 14 / 12); every other logo, divider, text and the button keep their Figma positions. y 88 puts its centre on the row's
// (the six others sit at 107..113; the Figma emblem's 102 was the band centre).
const SAICO_W = 99;
const design = [
  { w: 120, h: 38, x: 0, y: 94 },
  { w: 99, h: 47, x: 162, y: 86 },
  { w: 97, h: 34, x: 296, y: 94 },
  { w: 98, h: 38, x: 447, y: 90 },
  { w: 141, h: 42, x: 589, y: 86 },
  { w: SAICO_W, h: (SAICO_W * 131) / 291, x: 758, y: 88 },
  { w: 107, h: 33, x: 885, y: 94 },
];
// Logos fit inside their box (object-contain): the Global / UAE logos are the client's L3 files trimmed to their artwork
// (9 Oct 2026), whose ratio differs a little from the Figma boxes; a cover fit would cut their edges.
// Sources (bug 137): Daman, Almadallah and Nextcare come from the larger files of the same marks (Daman = the client's 14 Oct
// 1024px PNG, identical to the Figma export; Almadallah + Nextcare = the Figma exports, 912 / 406 wide) via
// tools/insurance-logos/trim.py, so the 2x candidates are real (Astro never enlarges). Thiqa, ADNIC, Neuron, SAICO stay the
// trimmed L3 tiles (Figma's Thiqa is a different lockup, "Managed by Daman"; Figma's SAICO is the emblem): ADNIC / Neuron /
// SAICO cover 2x of their box, Thiqa (239 px for a 164-px box) does not - a sharper official file is a client dependency (B137).
// Insurers of this edition's country only (bug 048, src/data/insurers.json `regions`, the Insurance Providers page's data).
// Global, and an edition that offers every Figma logo (UAE), keep the Figma strip; otherwise (KSA) the country's insurers
// flagged `homeStrip` (the six the live /sa Home shows; else the first seven with a logo) sit in one centred row at the Figma
// logo band (y 71..133), logos 62 high, the Figma dividers between them. The gap shrinks from Figma's 96 so the row fits the
// strip's 992 (x 30..1022): six 112-wide tiles = 64.
type Ins = { slug: string; name: { en: string; ar: string }; regions: string[]; homeStrip?: boolean; homeLogo?: string; logo?: { image: string; w: number; h: number } };
const insurers = (insurerData.insurers as (Ins & { onLive?: boolean })[]).filter((x) => x.onLive !== false); // live records only (client sheet 13 Oct 2026 row 15)
const regionOf = (image: string) => insurers.find((x) => x.logo?.image === image || x.homeLogo === image)?.regions ?? [];
const figmaFits = edition.region === 'global' || (txt.logos as { image: string }[]).every((l) => regionOf(l.image).includes(edition.region));
const ofRegion = insurers.filter((x) => x.logo && x.regions.includes(edition.region));
const strip = ofRegion.some((x) => x.homeStrip) ? ofRegion.filter((x) => x.homeStrip) : ofRegion.slice(0, 7);
const logos = figmaFits
  ? design.map((d, i) => {
      const l: { image: string; alt: string } = txt.logos[i];
      return { src: img(l.image, edition.region), alt: l.alt, ...d };
    })
  : strip.map((x) => ({ src: img(x.logo!.image, edition.region), alt: x.name[edition.locale] || x.name.en, w: (62 * x.logo!.w) / x.logo!.h, h: 62, x: 0, y: 71 }));
const stripW = logos.reduce((a, l) => a + l.w, 0);
const gap = figmaFits || logos.length < 2 ? 96 : Math.min(96, (992 - stripW) / (logos.length - 1));
const dividers = figmaFits ? [148, 273, 423, 568, 744, 871] : []; // 744 / 871 re-centred around the wider SAICO box (bug 137; Figma 758 / 864)
---

<section id="insurance" class="relative bg-white font-gotham" style="--h: 207">
  <div class="stage max-lg:px-16 max-lg:py-20 max-lg:flex max-lg:flex-col max-lg:items-center">
    <h2 class="m-0 font-medium text-f28 leading-27 text-navy text-center not-italic whitespace-normal [word-break:break-word] max-lg:max-w-430 lg:absolute lg:start-309 lg:top-0 lg:w-430 lg:h-27">{txt.title}</h2>
    <p class="m-0 font-normal text-f12 leading-14 text-body text-center not-italic whitespace-normal [word-break:break-word] max-lg:mt-10 max-lg:max-w-577 lg:absolute lg:start-235 lg:top-37 lg:w-577 lg:h-13">{txt.subtitle}</p>

    <ul class:list={['m-0 list-none p-0 max-lg:mt-30 max-lg:flex max-lg:flex-wrap max-lg:items-center max-lg:justify-center max-lg:gap-x-30 max-lg:gap-y-20', figmaFits ? 'lg:contents' : 'flow']} style={`--gap:${gap}`}>
      {logos.map((l) => (
        <li class:list={['relative shrink-0', figmaFits && 'lg:absolute']} style={`--lw:${l.w}; --lh:${l.h}; --lx:${l.x + F}; --ly:${l.y}`} data-logo>
          <Image src={l.src} format="webp" width={px(l.w)} height={px(l.h)} fit="contain" densities={[1, 2]} loading="lazy" decoding="async" alt={l.alt} class="block h-full w-full object-contain" />
        </li>
      ))}
    </ul>

    {dividers.map((x) => (
      <div class="hidden lg:block absolute top-86 w-48 origin-top-left rotate-90 rtl:origin-top-right rtl:-rotate-90" style={`inset-inline-start:calc(${x + F} * var(--u));height:calc(0.15 * var(--u))`} aria-hidden="true">
        <img loading="lazy" src={line13.src} width={line13.width} height={line13.height} alt="" class="block w-full h-full" />
      </div>
    ))}

    <!-- View All (bug 044/050): the shared .ui-btn, centred at Figma's top 177 (Figma: 118 x 30 at 469, 13px label). -->
    <a href={viewAll} class="ui-btn hit ins-btn btn-fill-navy relative bg-navy-alt text-white lg:absolute lg:top-177">{txt.button.label}</a>
  </div>
</section>

<style>
  [data-logo] { width: calc(var(--lw) * var(--u)); height: calc(var(--lh) * var(--u)); }
  .ins-btn { margin-top: calc(30 * var(--u)); }
  @media (min-width: 1024px) { .ins-btn { inset-inline: 0; width: fit-content; margin: 0 auto; } }
  /* Country strip on phones / tablets: the WordPress logo art carries its own white margin (136 x 75 box), so it is drawn at 74%
     to sit two or three to a row like the Figma logos. */
  @media (max-width: 1023.98px) { .flow [data-logo] { width: calc(var(--lw) * 0.74 * var(--u)); height: calc(var(--lh) * 0.74 * var(--u)); } }
  @media (min-width: 1024px) {
    [data-logo] { inset-inline-start: calc(var(--lx) * var(--u)); top: calc(var(--ly) * var(--u)); }
    /* Country strip (not the Figma seven): one centred row in the logo band, dividers (Figma line 13: 48 long, #418ea2) between. */
    .flow { position: absolute; inset-inline: 0; top: calc(71 * var(--u)); height: calc(62 * var(--u)); display: flex; align-items: center; justify-content: center; }
    .flow [data-logo] { inset: auto; top: auto; }
    .flow [data-logo] + [data-logo] { margin-inline-start: calc(var(--gap) * var(--u)); }
    .flow [data-logo] + [data-logo]::before { content: ''; position: absolute; inset-inline-start: calc(var(--gap) / -2 * var(--u)); top: calc(7 * var(--u)); height: calc(48 * var(--u)); border-inline-start: 1px solid color-mix(in srgb, #418ea2 25%, transparent); } /* a 0.15px Figma hairline drawn as 1px at its coverage, like .hair-card */
  }
</style>
