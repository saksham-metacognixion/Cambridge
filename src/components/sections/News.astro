---
import NewsCard from '../NewsCard.astro';
import Pagination from '../shared/Pagination.astro';
import line from '../../assets/news/line23.svg';
import { content, t } from '../../lib/content';
import { img } from '../../lib/images';
import { parsePath, urlFor } from '../../lib/editions';
import { hasPost, NEWS_PATHS, postFor, postsFor, type Post as NewsPost } from '../../lib/news';
import { PAGE_PATHS } from '../../lib/paths';
import news from '../../data/news.json';

const { edition } = parsePath(Astro.url.pathname);
const txt = content('home/news', edition.locale);
// "Read more" -> the post's article page (media-hub/<slug>); a slug that is in no export record goes to the 404 page (AR5).
// Default cards: the three slugs of home/news JSON with the Figma photos + crops (news.json); their title and excerpt come
// from the post record in the edition's language (src/data/news/posts.json), so the Arabic editions show the Arabic post.
// Tabs: each pill = a category of the export (filterCategories in home/news JSON); pressing it shows that category's three
// latest posts of the edition's language. A post whose image file is not downloaded yet renders an empty image box (NW1).
const articleHref = (slug: string) => (hasPost(slug) ? urlFor(edition, NEWS_PATHS.article(slug)) : urlFor(edition, PAGE_PATHS.notFound));

// crop.ratio = intrinsic height/width of the source file. Hardcoded on purpose: reading c.src.width/height
// makes Astro copy the full-size original into dist.
// Frame-relative Figma px (frame x = 60 => page x = value + 60). Card article origin = its image box.
const F = 60;
const design = [
  {
    slot: { x: 0, w: 289, hx: 0, ex: 0, ax: 238 },
    crop: { h: '100.02%', l: '-12.39%', t: '-0.01%', w: '116.51%', iw: 289 * 1.1651, ratio: 706 / 1080 },
  },
  {
    slot: { x: 313, w: 289, hx: 313, ex: 313, ax: 565 },
    crop: { h: '100.12%', l: '-10.73%', t: '-0.06%', w: '116.61%', iw: 289 * 1.1661, ratio: 832 / 1273 },
  },
  {
    slot: { x: 627, w: 288, hx: 626, ex: 626, ax: 878 },
    crop: { h: '102.73%', l: '-0.04%', t: '-2.73%', w: '100.07%', iw: 288 * 1.0007, ratio: 832 / 1061 },
  },
];
type FigmaPost = (typeof news.posts)[number];
const safeImg = (key: string, slug: string) => {
  try { return img(key, edition.region); } catch { console.warn(`[news] home: image "${key}" of ${slug} not found in src/assets; empty image box`); return null; }
};
// Default view (no tab pressed, as in Figma): the posts listed by slug in home/news JSON, Figma photo + crop, live text.
const cards = design.map((d, i) => {
  const slug: string = txt.posts[i];
  const figma = news.posts.find((n) => n.slug === slug) as FigmaPost | undefined;
  if (!figma) throw new Error(`home/news: unknown post slug "${slug}"`);
  const post = postFor(slug, edition);
  return {
    ...d,
    src: img(figma.image, edition.region),
    alt: post?.image_alt || t(figma.imageAlt, edition.locale, 'news'),
    title: post?.title ?? t(figma.title, edition.locale, 'news'),
    text: post?.excerpt ?? t(figma.excerpt, edition.locale, 'news'),
    readMore: { label: txt.readMore.label, href: articleHref(slug) },
  };
});
const card = (post: NewsPost) => ({
  src: safeImg(post.image, post.slug),
  alt: post.image_alt || post.title,
  title: post.title,
  text: post.excerpt,
  readMore: { label: txt.readMore.label, href: articleHref(post.slug) },
});
// Tabs: filterCategories (home/news JSON) = export categories; each tab's three latest posts (edition language, newest
// first) are rendered into a <template>. A category with no posts gets no template and its tab keeps the default cards.
const all = postsFor(edition);
const pillX = [321, 420, 519];
const pills = pillX.map((x, i) => {
  const key: string = txt.filterCategories[i];
  const posts = all.filter((n) => n.category === key).slice(0, design.length);
  return { label: txt.filters[i] as string, x, key, sets: posts.map((post, j) => ({ slot: design[j].slot, ...card(post) })) };
});
---

<section id="news" data-news class="relative bg-white font-gotham" style="--h: 590">
  <div class="stage max-lg:px-16 max-lg:py-30">
    <h2 class="m-0 font-medium text-f28 leading-27 text-navy text-center not-italic whitespace-normal [word-break:break-word] lg:absolute lg:start-305 lg:top-0 lg:w-430 lg:h-27">{txt.title}</h2>

    <div class="flex flex-wrap justify-center gap-10 max-lg:mt-20 lg:contents">
      {pills.map((p) => (
        <button
          type="button"
          aria-pressed="false"
          aria-controls="news-cards"
          data-news-tab={p.key}
          class="news-tab hit ui-pill lg:absolute lg:top-51"
          style={`--x:${p.x + F}`}
          data-x
        >{p.label}</button>
      ))}
    </div>

    <div id="news-cards" data-news-cards class="max-lg:mt-30 max-lg:flex max-lg:flex-col max-lg:items-center max-lg:gap-40 lg:contents">
      {cards.map((c) => <NewsCard F={F} {...c} />)}
    </div>
    {pills.filter((p) => p.sets.length).map((p) => (
      <template data-news-set={p.key}>
        {p.sets.map((c) => <NewsCard F={F} {...c} />)}
      </template>
    ))}

    <!-- Pagination dots of the cards box (Figma's dot divider at y 544, cyan active dot): shared component (bug 012). Shown
         only when the box overflows sideways; the three cards fit at every width (stacked below 1024), so nothing shows today. -->
    <div class="lg:absolute lg:start-0 lg:top-544 lg:w-full max-lg:mt-30">
      <Pagination for="news-cards" tone="cyan" />
    </div>
    <div class="hidden lg:block absolute start-60 -rotate-[0.31deg]" style="top:calc(587.375 * var(--u));width:calc(915.014 * var(--u));height:calc(0.25 * var(--u))">
      <img src={line.src} width={line.width} height={line.height} alt="" class="block w-full h-full" />
    </div>
  </div>
</section>

<script>
  import '../../scripts/news-tabs';
  import '../../scripts/pagination';
</script>

<style>
  @media (min-width: 1024px) {
    [data-x] { inset-inline-start: calc(var(--x) * var(--u)); }
    [data-news] :global([data-card]) { inset-inline-start: calc(var(--cx) * var(--u)); width: calc(var(--w) * var(--u)); }
    [data-news] :global([data-card] > :not(:first-child)) { inset-inline-start: calc((var(--lx, 0)) * var(--u)); }
  }
  /* Tabs: the shared .ui-pill rule (global.css); selected = the filled navy pill Figma uses in Care Support. */
  /* Tab switch, as on the live site: cards fade out, the set swaps, cards fade back in (script below). */
  @media (prefers-reduced-motion: no-preference) {
    [data-news] :global([data-card]) { transition: opacity 250ms ease; }
    [data-news] :global([data-news-cards].is-fading [data-card]) { opacity: 0.15; }
    [data-news] :global([data-card].is-entering) { opacity: 0; }
  }
</style>
