---
import { parsePath } from '../../lib/editions';
import { content } from '../../lib/content';

const { edition } = parsePath(Astro.url.pathname);
const c = content('home/recovery', edition.locale);
---

<section class="rec relative" style="--h: 186; background:#004059">
  <div class="stage">
    <h2 class="r-title absolute left-321 top-38 w-411 h-27 m-0 font-gotham font-medium text-f30 text-white text-center not-italic">{c.title}</h2>
    <p class="r-sub absolute left-238 top-71 w-577 h-18 m-0 font-gotham font-normal text-f12 leading-14 text-white text-center not-italic">{c.text}</p>
    <a href={c.buttons[0].href} class="r-btn absolute left-350 top-116 w-166 h-30 rounded-r7 bg-white">
      <span class="r-l absolute left-11 top-9 w-145 h-15 font-gotham font-medium text-f13 text-navy text-center not-italic">{c.buttons[0].label}</span>
    </a>
    <a href={c.buttons[1].href} class="r-btn absolute left-535 top-116 w-166 h-30 rounded-r7 bg-white">
      <span class="r-l absolute left-9 top-9 w-145 h-15 font-gotham font-medium text-f13 text-navy text-center not-italic">{c.buttons[1].label}</span>
    </a>
  </div>
</section>

<style>
  .r-btn { text-decoration: none; }
  @media (max-width: 1023.98px) {
    .stage { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px; padding: 32px 16px; box-sizing: border-box; }
    .r-title, .r-sub { position: static; width: 100%; height: auto; }
    .r-sub { margin-bottom: 8px; }
    .r-btn { position: relative; left: auto; top: auto; display: flex; align-items: center; justify-content: center; }
    .r-l { position: static; width: auto; height: auto; }
  }
</style>
