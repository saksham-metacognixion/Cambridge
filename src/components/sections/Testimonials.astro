---
import ellipses from '../../assets/testimonials/bg-ellipses.svg';
import { content, t } from '../../lib/content';
import { parsePath, urlFor } from '../../lib/editions';
import { pagePath } from '../../lib/paths';
import { homeTestimonials } from '../../lib/testimonials';
import TestimonialCard from '../testimonials/TestimonialCard.astro';

/*
 * Stories of Care and Recovery (Figma 2007:342): blue panel + six 185 x 231 cards at a 203 pitch from page x -96 (the first
 * and last cut by the page edge), 117 under the section top. Each card is the Patient Testimonials card (TestimonialCard,
 * Figma 62:2398) at 185 / 257.723 of its size: every Figma value of the home card (quote box 52 = 72.441 s, name 5 below the
 * quote box, pattern box at 116, badge 53 at 137 / 186) is that card's, so the stories come from src/data/testimonials.json
 * (`home` = the slugs in Figma order) and the text is flow layout: a quote of five or more lines (long English, Arabic)
 * pushes the name down instead of running into it (bug 013), while a card with the Figma content keeps the Figma layout
 * (min-height 231). The badge overhangs the card bottom in Figma (186 + 53 > 231): the scroller leaves it that room.
 */
const { edition } = parsePath(Astro.url.pathname);
const txt = content('home/testimonials', edition.locale);
const loc = edition.locale;

const u = (n: number) => `calc(${n} * var(--u))`;
const S = 185 / 257.723;
const GAP = 203 - 185;
const OVERHANG = (259.12 + 73.834 - 321.805) * S;
---

<section class="testi relative" style="--h: 421" id="testimonials">
  <div class="stage">
    <div class="t-head">
      <div class="t-panel absolute start-62 top-0 rounded-r12p6 bg-cyan" style="width:calc(927.828 * var(--u));height:calc(232.906 * var(--u))"></div>
      <img class="t-art absolute start-62 top-4" style="width:calc(927.828 * var(--u));height:calc(232.906 * var(--u))" src={ellipses.src} width="928" height="233" alt="" loading="lazy" decoding="async" />
      <h2 class="t-title absolute start-306 top-34 w-439 m-0 font-gotham font-medium text-f28 text-white capitalize text-center not-italic">{txt.title}</h2>
      <p class="t-sub absolute start-237 top-70 w-578 m-0 font-gotham font-normal text-f12 leading-14 text-white text-center not-italic">{txt.subtitle}</p>
    </div>

    <div data-autoscroll class="hscroll t-scroller absolute start-0 top-117 w-full" style={`padding-block-end:${u(OVERHANG)}`}>
      <div data-loop-row class="t-row flex" style={`gap:${u(GAP)};margin-inline-start:${u(-96)}`}>
        {homeTestimonials.map((s) => (
          <div data-loop-item class="t-item shrink-0" style="scroll-snap-align:start">
            <TestimonialCard name={t(s.name, loc, 'testimonials')} quote={t(s.quote, loc, 'testimonials')} photo={s.photo ? { ...s.photo, alt: t(s.photo.alt, loc, 'testimonials') } : undefined} pattern={s.pattern} layers={s.layers} region={edition.region} s={S} />
          </div>
        ))}
      </div>
    </div>

    <a href={txt.button.page ? urlFor(edition, pagePath(txt.button.page)) : txt.button.href} class="hit t-btn absolute start-443 top-391 w-166 h-30 rounded-r7 bg-cyan">
      <span class="t-btn-l absolute start-10 top-9 w-145 h-15 font-gotham font-medium text-f13 text-white text-center not-italic">{txt.button.label}</span>
    </a>
  </div>
</section>

<script>
  import '../../scripts/autoscroll';
</script>

<style>
  .t-head { display: contents; }
  .t-btn { text-decoration: none; }
  @media (max-width: 1023.98px) {
    .testi { padding: 24px 0; }
    .t-head { display: block; position: relative; overflow: hidden; margin: 0 16px; padding: 28px 16px; background: #00b8ff; border-radius: calc(12.658 * var(--u)); }
    .t-panel { display: none; }
    .t-art { inset: 0; width: 100%; height: 100%; inset-inline-start: 0; top: 0; }
    .t-title, .t-sub { position: relative; inset-inline-start: auto; top: auto; width: auto; }
    .t-sub { margin-top: 8px; }
    .t-scroller { position: static; width: 100%; margin-top: 24px; }
    .t-row { margin-inline-start: 16px !important; }
    /* snap cards 16px in from the edge so the first card keeps its gutter in both directions */
    .t-scroller { scroll-padding-inline: 16px; }
    .t-btn { position: relative; inset-inline-start: auto; top: auto; display: block; margin: 24px auto 0; }
  }
</style>
