---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { px } from '../../lib/scale';

/*
 * One service card (Figma Home "Services" 21:1398 cards, reused by the Our Care hub 36:5631 and the hospital pages 112:7721
 * via CareCards.astro): photo 222 x 244 standing 3 above the white box 222 x 342 r15 (hairline .25 #418ea2); title Medium
 * 19 at (+24, +259), description Book 9/10 #6b6b6b at +281 (box 154 wide), button cyan 74 x 17 r3 at +309 (label Medium 8
 * white, centred), 16 above the bottom. `scale` shrinks everything (hospital pages: 0.9884).
 *
 * Text block in normal flow (bug 011): title | description (any number of lines, English or Arabic) | button pushed to the
 * bottom with margin-top: auto. The card is min-height 342, so a 1-2 line description gives the Figma card exactly
 * (257 + 19 + 5 + 20 + 8 + 17 + 16 = 342) and a longer one makes the card taller instead of running into the button. Put
 * the card in a stretching cell (flex / grid, as both owners do) and every card of a row takes the tallest one's height, so
 * the four buttons stay level. The title is set at line-height 1 from 257 (same baseline as Figma's 15 line from 259) so a
 * wrapping title (Arabic) does not overlap itself.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  title: string;
  desc: string;
  href: string;
  /** button text */
  button: string;
  /** accessible name of the button (the four cards share one label) */
  buttonLabel?: string;
  scale?: number;
  titleTone?: 'cyan' | 'navy';
}
const { src, alt, title, desc, href, button, buttonLabel, scale: K = 1, titleTone = 'cyan' } = Astro.props;
---

<article class="cc hair-card" style={`--k:${K};--sw:${0.25 * K}`}>
  <Picture src={src} formats={['avif']} fallbackFormat="webp" width={px(222 * K)} height={px(244 * K)} widths={[px(222 * K), px(222 * K) * 2]} sizes={`${px(222 * K)}px`} loading="lazy" decoding="async" alt={alt} class="cc-img" pictureAttributes={{ class: 'contents' }} />
  <div class="cc-body">
    <h3 class:list={['cc-title', titleTone === 'navy' ? 'text-navy' : 'text-cyan']}>{title}</h3>
    <p class="cc-desc">{desc}</p>
    <a href={href} class="cc-btn hit" aria-label={buttonLabel}><span>{button}</span></a>
  </div>
</article>

<style>
  .cc { --cu: calc(var(--k) * var(--u)); position: relative; display: flex; flex-direction: column; box-sizing: border-box; width: 100%; min-height: calc(342 * var(--cu)); margin-top: calc(3 * var(--cu)); border-radius: calc(15 * var(--cu)); background: #fff; font-family: var(--font-gotham); font-style: normal; }
  .cc :global(.cc-img) { position: absolute; inset-inline-start: 0; top: calc(-3 * var(--cu)); display: block; width: 100%; height: calc(244 * var(--cu)); object-fit: cover; max-width: none; border-start-start-radius: calc(15 * var(--cu)); border-start-end-radius: calc(15 * var(--cu)); }
  .cc-body { position: relative; display: flex; flex-direction: column; flex: 1; box-sizing: border-box; padding: calc(257 * var(--cu)) calc(24 * var(--cu)) calc(16 * var(--cu)); }
  .cc-title { margin: 0; font-weight: 500; font-size: calc(19 * var(--cu)); line-height: 1; overflow-wrap: anywhere; }
  .cc-desc { margin: calc(5 * var(--cu)) 0 calc(8 * var(--cu)); max-width: calc(154 * var(--cu)); font-weight: 400; font-size: calc(9 * var(--cu)); line-height: calc(10 * var(--cu)); color: var(--color-body); overflow-wrap: anywhere; }
  .cc-btn { margin-top: auto; flex: none; display: flex; align-items: center; justify-content: center; width: calc(74 * var(--cu)); height: calc(17 * var(--cu)); border-radius: calc(3 * var(--cu)); background: var(--color-cyan); text-decoration: none; }
  .cc-btn span { font-weight: 500; font-size: calc(8 * var(--cu)); line-height: 1; color: #fff; white-space: nowrap; text-box: trim-both cap alphabetic; } /* caps centred, see forms.css .f-submit */
  .cc-btn:focus-visible { outline: calc(2 * var(--u)) solid var(--color-navy); outline-offset: calc(2 * var(--u)); }
</style>
