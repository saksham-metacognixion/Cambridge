---
/*
 * Outline button used on every inner-page hero, on Careers, the calculators, the hospital map band and the 404 page:
 * 1px cyan outline, cyan label (Figma 108:6678 / 108:6679: 164 x 30, radius 7, label Medium 13). Size, label and corners
 * = the shared .ui-btn (bugs 044 / 050: the button grows with its label from its padding; bug 049: --radius-btn), so
 * the Figma 164 x 30 box and the label offsets (labelX / labelW) no longer apply. Touch target 44px via .hit.
 * Layout (margins) is the caller's: pass `class`. Hover / focus: the shared .btn-outline / .btn-fill rules in global.css.
 */
/* `fill`: the filled variant (Our Hospitals hero 81:1444): #00b8ff background, white label, no outline. */
/* Any other attribute (data-hospital, target, rel ...) goes onto the <a>. labelX / labelW: accepted for old callers, unused. */
interface Props { href: string; label: string; labelX?: number; labelW?: number; class?: string; fill?: boolean; [k: string]: unknown }
const { href, label, labelX: _lx, labelW: _lw, class: cls, fill = false, ...rest } = Astro.props;
---

<a href={href} class:list={['btn ui-btn hit no-underline', fill ? 'bg-cyan btn-fill' : 'hair-card btn-outline', cls]} style="--sw:1;--sc:var(--color-cyan)" {...rest}>
  <span class:list={['label', fill ? 'text-white' : 'text-cyan']}>{label}</span>
</a>
