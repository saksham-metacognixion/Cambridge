---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import { img } from '../../lib/images';
import { parsePath } from '../../lib/editions';

/*
 * Inner-page hero (one component for every inner page; was DoctorsHero). Stage = page y 119 (under the header) to 119 + h.
 * Two image layouts from Figma:
 *   'banner' (Find a Doctor 62:180, Patient Hub, Conditions, Refer, Insurance, International, Testimonials, FAQ): the
 *     1052x500 PNG drawn at 114.42% of the 437 box, top-left anchored.
 *   'cover' (condition / service detail, 41:1732 "PAR-inside"): a 1052x323 PNG, object-cover, starting 1px above the stage
 *     (Figma top 118; the header covers that row).
 * Text is FLOW layout (title -> text -> button) so longer / Arabic copy pushes the next line down instead of overlapping.
 * Desktop positions in Figma px, relative to the stage: title top `titleTop` at x95 (w titleW), text `textGap` below the
 * title at x97 (w textW), button `buttonGap` below the text (or the title when there is no text) at x98, 164 x 30.
 * Button label: Gotham Medium 13 cyan, box `labelW` wide at `labelX` inside the button (Figma: 145 at 8; 153 at 5).
 */
interface Pos { titleTop: number; titleW: number; textGap?: number; textW?: number; buttonGap: number; labelX?: number; labelW?: number }
interface Props {
  content: { ariaLabel: string; banner: { image: string; alt: string }; title: string[]; text?: string; button: { label: string; href: string } };
  pos: Pos;
  /** stage height in Figma px: 437 (banner) or 322 (cover) */
  h?: number;
  variant?: 'banner' | 'cover';
}
const { content: c, pos, h = 437, variant = 'banner' } = Astro.props;
const { edition } = parsePath(Astro.url.pathname);
const banner = img(c.banner.image, edition.region);
const p = { textGap: 0, textW: 374, labelX: 8, labelW: 145, ...pos };
const imgH = variant === 'banner' ? 500 : 323;
---

<section class="relative" style={`--h: ${h}`} aria-label={c.ariaLabel}>
  <div class="stage hero" style={`--mh:${h}`}>
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <Picture
        src={banner}
        formats={['avif']}
        fallbackFormat="webp"
        width={px(1052)}
        height={px(imgH)}
        widths={[720, 1052]}
        sizes="(min-width: 1440px) 1440px, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        alt={c.banner.alt}
        class:list={['absolute start-0 w-full max-w-none object-cover rtl:-scale-x-100', variant === 'banner' ? 'top-0 h-[114.42%]' : 'cover']}
        pictureAttributes={{ class: 'contents' }}
      />
    </div>

    <div class="copy" style={`--tt:${p.titleTop};--tw:${p.titleW};--xg:${p.textGap};--xw:${p.textW};--bg:${p.buttonGap};--lx:${p.labelX};--lw:${p.labelW}`}>
      <h1 class="title m-0 font-gotham font-medium text-f39 leading-37 text-navy not-italic">
        {c.title.map((line: string) => <span class="block">{line}</span>)}
      </h1>
      {c.text && <p class="text m-0 font-gotham font-normal text-f12 leading-14 text-body not-italic">{c.text}</p>}
      <a href={c.button.href} class="btn hit hair-card relative block rounded-r7 no-underline" style="--sw:1;--sc:var(--color-cyan)">
        <span class="label absolute block h-15 font-gotham font-medium text-f13 text-cyan text-center not-italic whitespace-nowrap">{c.button.label}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cover { top: calc(-1 * var(--u)); height: calc(323 * var(--u)); }
  .copy { position: relative; display: flex; flex-direction: column; align-items: flex-start; }
  .title, .text { overflow-wrap: anywhere; }
  .btn { width: calc(164 * var(--u)); height: calc(30 * var(--u)); flex: none; }
  .label { top: calc(9 * var(--u)); inset-inline-start: calc(var(--lx) * var(--u)); width: calc(var(--lw) * var(--u)); }
  @media (min-width: 1024px) {
    .copy { position: absolute; inset-inline-start: calc(95 * var(--u)); top: calc(var(--tt) * var(--u)); }
    .title { width: calc(var(--tw) * var(--u)); }
    .text { width: calc(var(--xw) * var(--u)); margin-top: calc(var(--xg) * var(--u)); margin-inline-start: calc(2 * var(--u)); }
    .btn { margin-top: calc(var(--bg) * var(--u)); margin-inline-start: calc(3 * var(--u)); }
  }
  @media (max-width: 1023.98px) {
    .hero { display: flex; min-height: calc(var(--mh) * var(--u)); flex-direction: column; align-items: flex-start; justify-content: center; padding: calc(48 * var(--u)) calc(24 * var(--u)); box-sizing: border-box; }
    .copy { gap: calc(16 * var(--u)); }
    .text { max-width: calc(var(--xw) * var(--u)); }
  }
</style>
