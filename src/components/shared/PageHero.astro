---
import { Picture } from 'astro:assets';
import { heroEdge } from '../../lib/hero-edge';
import { heroSubjectStrip, heroSmallCrop } from '../../lib/hero-strip';
import { px } from '../../lib/scale';
import { img, heroLayers } from '../../lib/images';
import { parsePath } from '../../lib/editions';
import OutlineButton from './OutlineButton.astro';

/*
 * Inner-page hero (one component for every inner page; was DoctorsHero). Stage = page y 119 (under the header) to 119 + h.
 * Two image layouts from Figma:
 *   'banner' (Find a Doctor 62:180, Patient Hub, Conditions, Refer, Insurance, International, Testimonials, FAQ): the
 *     1052x500 PNG drawn at 114.42% of the 437 box, top-left anchored.
 *   'cover' (condition / service detail, 41:1732 "PAR-inside"): a 1052x323 PNG, object-cover, starting 1px above the stage
 *     (Figma top 118; the header covers that row).
 * Text is FLOW layout (title -> text -> button) so longer / Arabic copy pushes the next line down instead of overlapping.
 * Desktop positions in Figma px, relative to the stage: title top `titleTop` at x95 (w titleW), text `textGap` below the
 * title at x97 (w textW), button at x98 (Figma 164 x 30) below the text.
 * Text -> button gap (bug 055, client request 8 Oct 2026): ONE gap for every hero with a paragraph, --hero-btn-gap (global.css) below
 *   (18 Figma px = the Find a Doctor / Conditions / Refer heroes, 24.6px at 1440, kept within 24-32px at every width). The
 *   per-page Figma gaps (0 on Accreditations, 4 on Insurance ... 24 on Our Hospitals) put the button against the text.
 *   `buttonGap` now applies only to a hero WITHOUT text (title -> button, the FAQ page).
 * `titleMinH` (optional): the Figma title box height, so a title with fewer lines than in Figma keeps the text in place.
 * Button: OutlineButton = the shared .ui-btn (bugs 044 / 050): its top-left keeps the Figma anchor, it grows with its label.
 * `labelX` / `labelW` (Figma label offsets) are no longer used.
 */
/** titleSize: desktop title size in Figma px (default 39, line height 37/39 of it); bug 071 (Why Cambridge 4-line client title). */
interface Pos { titleSize?: number; titleTop: number; titleW: number; titleMinH?: number; textGap?: number; textW?: number; textX?: number; buttonGap: number; labelX?: number; labelW?: number }
interface Props {
  /** button: absent = a hero without one (the calculator pages, as on the live site) */
  content: { ariaLabel: string; banner: { image: string; alt: string }; title: string[]; text?: string; button?: { label: string; href: string } };
  pos: Pos;
  /** stage height in Figma px: 437 (banner) or 322 (cover) */
  h?: number;
  variant?: 'banner' | 'cover';
  /** Our Hospitals (101:6247): white text on the dark banner (desktop only: below 1024px the text sits on white under the photo) and a filled cyan button (white label) */
  tone?: 'navy' | 'white';
  button?: 'outline' | 'fill';
  /** RTL: Figma hero art is mirrored with the layout (default). false = a photo with real content (news post image) is never flipped. */
  mirror?: boolean;
  /** RTL (bug 021): the hero art holds readable or directional content (a phone screen, a logo, a map), so it is never
   *  flipped and its composition stays as in English: on desktop the copy block sits in the art's clear area (the same 95px
   *  from the left edge as the English copy, its lines aligned right). Below 1024px the photo is its own block, so only
   *  the flip is dropped there. Implies mirror = false. */
  keepComposition?: boolean;
  /** extra attributes for the button link, e.g. { 'data-hospital': slug } so the Book pop-up knows the hospital */
  buttonAttrs?: Record<string, string>;
  /** cursor-follow mode (scripts/hero-follow.ts, the live site's mouse parallax): 'people' (default) = the subject layer moves;
   *  'map' (Our Hospitals) = the subject layer AND every `[data-hero-subject]` in the section (HeroMap's vector overlay) move together. */
  follow?: 'people' | 'map';
  /** Phones / tablets (< 1024px, where the photo is its own block above the copy; styles/global.css .hero-media): the strip of
   *  the 1052x500 banner that must stay in view, in Figma px from its left edge (`x` = strip start, `w` = strip width). The photo
   *  box takes the strip's aspect ratio (the whole strip is visible, nobody is cut), capped at `maxH` CSS px on wide tablets
   *  (the top of the art is cropped first, never the feet). Default: a 72vw box showing the art at 80% 30%. Bug 027 (About:
   *  the five staff stand at the right edge of the art, x 470-1052). */
  small?: { x: number; w: number; maxH?: number };
  /** Bug 069 (news posts): on desktop the photo fills only the inline-end 55% of the stage (Figma Health Article Layout
   *  170:839: photo on the right, the title on a light plain area), its leading edge fading into the light surface. A post
   *  image is any shape or pattern (the live "Emblem" pill artwork, busy photos), so it never runs under the title. */
  side?: boolean;
  /** Bug 086 (screens wider than 1440): how the background reaches the viewport edges (styles/global.css .hero-bleed).
   *  'edges' = each side continues the background layer's own edge column (gradient + pills; the default with layers);
   *  'start' = both sides continue the banner's START column (the plain gradient side; the default for a flat banner,
   *  whose end edge is a photo that must not be smeared); 'none' = no bands (`side` posts: the plain surface continues). */
  bleed?: 'edges' | 'start' | 'none';
}
const { content: c, pos, h = 437, variant = 'banner', tone = 'navy', button = 'outline', mirror = true, keepComposition = false, buttonAttrs = {}, follow = 'people', side = false } = Astro.props;
const { edition } = parsePath(Astro.url.pathname);
const banner = img(c.banner.image, edition.region);
// Cursor-follow (live-site mouse parallax, scripts/hero-follow.ts): the people (subject layer) move over the static background layer; a banner
// without layers (Our Hospitals, news photos) is one static picture.
const layers = heroLayers(c.banner.image, edition.region);
const p = { titleSize: 39, titleMinH: 0, textGap: 0, textW: 374, textX: 97, labelX: 8, labelW: 145, ...pos };
const imgH = variant === 'banner' ? 500 : 323;
// No `small` given: the strip that holds the people of the cut-out layer (lib/hero-strip.ts, 10 Oct 2026), capped like About.
// A flat banner (news photos) and the Our Hospitals map (follow="map", HeroMap's pins are laid over the whole art) keep the generic crop.
const auto = !Astro.props.small && layers && follow === 'people' ? await heroSubjectStrip(layers.subject) : null;
const small = Astro.props.small ?? auto ?? undefined;
const imgClass = ['absolute start-0 w-full max-w-none object-cover', variant === 'banner' ? 'top-0 h-[114.42%]' : 'cover'];
// Small-screen crop (see `small`, lib/hero-strip.ts heroSmallCrop): object-position X% = the strip's start as a share of the slack
// (art width - strip width), the box's aspect = strip width / the variant's banner height (500 banner, 323 cover: condition pages,
// bug 042), so 100% = a strip that ends at the right edge; 100% vertically keeps the bottom (feet) when the box is capped (640px).
const crop = small ? heroSmallCrop(small, imgH, side ? '55vw' : '100vw') : null;
const smallStyle = crop?.style;
// Image audit 10 Oct 2026: the hero fills the viewport at every width since the 1440 cap went (scale.ts MAX_W = 0), and a
// `side` post photo fills the inline-end 55% on desktop. The 1440 / 2104 candidates exist only where the source is that wide
// (Astro never upscales): the 1400 px news photos were capped at 1052 and shown upscaled at 1440; the 1052 Figma banners are unchanged.
const pic = {
  formats: ['avif'], fallbackFormat: 'webp', width: px(1052), height: px(imgH), widths: [720, 1052, 1440, 2104],
  sizes: crop ? crop.sizes : side ? '(min-width: 1024px) 55vw, 100vw' : '100vw', loading: 'eager', decoding: 'async', pictureAttributes: { class: 'contents' },
} as const;
// Bug 086: the background's edge columns continue to the viewport edges beyond 1440 px (global.css .hero-bleed). The band
// image = the static layer; a flat banner continues its start column on both sides (its end edge is a photo), unless told otherwise.
const bleed = Astro.props.bleed ?? (side ? 'none' : layers ? 'edges' : 'start');
const g = bleed === 'none' ? null : await heroEdge(layers ? layers.background : banner); // build-time gradients of its edge columns
const edgeVars = g
  ? `--hero-edge-start:${g.start};--hero-edge-end:${bleed === 'start' ? g.start : g.end};` + (variant === 'cover' ? `--hero-edge-h:calc(323 * var(--u));--hero-edge-y:calc(-1 * var(--u));` : '')
  : '';
const unflipped = !(mirror && !keepComposition);
---

<section class:list={['relative', keepComposition && 'keep', side && 'side', g && 'hero-bleed', g && unflipped && 'unflipped']} style={`--h: ${h};${edgeVars}`} aria-label={c.ariaLabel}>
  <div class="stage hero" style={`--mh:${h}`}>
    <!-- The people drift with the cursor like the home hero (scripts/hero-follow.ts); the RTL flip sits on this box so the
         script's transform on the subject image never overrides it. -->
    <div class:list={['hero-media absolute inset-0 overflow-hidden pointer-events-none', mirror && !keepComposition && 'rtl:-scale-x-100']} data-hero-follow={layers ? follow : undefined} style={smallStyle} aria-hidden="true">
      {layers ? (
        <>
          <Picture src={layers.background} alt="" class:list={imgClass} {...pic} />
          <Picture src={layers.subject} alt={c.banner.alt} fetchpriority="high" data-hero-subject class:list={imgClass} {...pic} />
        </>
      ) : (
        <Picture src={banner} alt={c.banner.alt} fetchpriority="high" class:list={imgClass} {...pic} />
      )}
    </div>

    <div class="copy" style={`--ts:${p.titleSize};--tt:${p.titleTop};--tw:${p.titleW};--th:${p.titleMinH};--xg:${p.textGap};--xw:${p.textW};--xx:${p.textX - 95};--bg:${p.buttonGap}`}>
      <h1 class:list={["title hero-title m-0 font-gotham font-medium text-f39 leading-37 not-italic", tone === "white" ? "text-navy lg:text-white" : "text-navy"]}>
        {c.title.map((line: string) => <span class="block">{line}</span>)}
      </h1>
      {c.text && <p class:list={["text m-0 font-gotham font-normal text-f12 leading-14 not-italic", tone === "white" ? "text-body lg:text-white" : "text-body"]}>{c.text}</p>}
      {c.button && <OutlineButton href={c.button.href} label={c.button.label} class="btn" fill={button === "fill"} {...buttonAttrs} />}
    </div>
    <slot name="art" />
  </div>
</section>

<script>
  import '../../scripts/hero-follow';
</script>

<style>
  .cover { top: calc(-1 * var(--u)); height: calc(323 * var(--u)); }
  .copy { --copy-gap: 0px; position: relative; display: flex; flex-direction: column; align-items: flex-start; }
  .text { overflow-wrap: anywhere; }
  /* Bug 055: in flow right after the paragraph, so a longer / wrapped (Arabic) text pushes the button down with it.
     --copy-gap = the flex gap the stacked layout (< 1024px) already puts between the items. */
  .copy .text + :global(.btn) { margin-top: calc(var(--hero-btn-gap) - var(--copy-gap)); }
  @media (min-width: 1024px) {
    .copy { position: absolute; inset-inline-start: calc(95 * var(--u)); top: calc(var(--tt) * var(--u)); }
    .title { width: calc(var(--tw) * var(--u)); min-height: calc(var(--th) * var(--u)); font-size: calc(var(--ts) * var(--u)); line-height: calc(var(--ts) * 37 / 39 * var(--u)); }
    .text { width: calc(var(--xw) * var(--u)); margin-top: calc(var(--xg) * var(--u)); margin-inline-start: calc(var(--xx) * var(--u)); }
    .copy :global(.btn) { margin-top: calc(var(--bg) * var(--u)); margin-inline-start: calc(3 * var(--u)); }
    .copy .text + :global(.btn) { margin-top: var(--hero-btn-gap); }
    /* RTL inset-inline-end = the left edge: the copy keeps the English side, mirrored inside its own box. The lines are
       right-aligned, so the box is only as wide as the English paragraph (the area that is clear of the art). */
    :global([dir='rtl']) .keep .copy { inset-inline-start: auto; inset-inline-end: calc(95 * var(--u)); }
    :global([dir='rtl']) .keep .title { width: calc((var(--xx) + var(--xw)) * var(--u)); }
  }
  @media (min-width: 1024px) {
    .side { background: var(--color-mist-50); } /* bug 086: the post's plain surface reaches the viewport edges too */
    .side .stage { background: var(--color-mist-50); }
    .side .hero-media { inset-inline-start: 45%; }
    .side .hero-media::after { content: ""; position: absolute; inset-block: 0; inset-inline-start: 0; width: 30%; background: linear-gradient(to right, var(--color-mist-50), transparent); }
    :global([dir='rtl']) .side .hero-media::after { background: linear-gradient(to left, var(--color-mist-50), transparent); }
  }
  @media (max-width: 1023.98px) {
    .cover { top: 0; height: 100%; }
    .copy { --copy-gap: calc(16 * var(--u)); gap: var(--copy-gap); padding: calc(28 * var(--u)) calc(24 * var(--u)) calc(40 * var(--u)); }
    .text { max-width: calc(var(--xw) * var(--u)); }
  }
</style>
