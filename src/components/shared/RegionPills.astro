---
/*
 * ALL / KSA / UAE pills (Find a Doctor 62:783, Insurance Providers 46:7186, Patient Testimonials): 79 x 25 at x 0 / 99 / 200
 * inside a 279 box (Figma's gaps 20 / 22 kept), label Gotham Medium 10/10. Pressed = navy fill, others 1px navy outline
 * (.ui-pill). Corners: fully round (--radius-pill, bug 049; Figma had 12 on Find a Doctor, 10 on Insurance: `radius` is
 * accepted for old callers, unused). Buttons carry data-country and aria-pressed; the page's filter script does the rest
 * (state in the URL ?country=).
 */
interface Props { options: { value: string; label: string }[]; active: string; label: string; radius?: number; class?: string }
const { options, active, label, class: cls } = Astro.props;
const pillX: Record<string, number> = { all: 0, sa: 99, ae: 200 };
---

<div class:list={['pills', cls]} role="group" aria-label={label}>
  {options.map((p) => (
    <button type="button" data-country={p.value} aria-pressed={p.value === active ? 'true' : 'false'} class="pill ui-pill hit" style={`--x:${pillX[p.value]}`}>{p.label}</button>
  ))}
</div>

<style>
  .pills { position: relative; flex: none; width: calc(279 * var(--u)); height: calc(25 * var(--u)); }
  .pill { position: absolute; inset-inline-start: calc(var(--x) * var(--u)); top: 0; border-radius: var(--radius-pill); } /* bug 049 */
  /* Phones: the Figma group is 279 Figma px = 382px (--u is fixed below 1024), wider than a 360-390 screen, so ALL and UAE were cut
     off at the edges. A centred flex row instead: each pill keeps its Figma 79 width where it fits and shrinks evenly where not. */
  @media (max-width: 1023.98px) {
    .pills { display: flex; justify-content: center; gap: 10px; width: 100%; max-width: calc(279 * var(--u)); height: auto; }
    .pill { position: relative; inset: auto; flex: 0 1 calc(79 * var(--u)); min-width: 0; }
  }
</style>
