---
import { Picture } from 'astro:assets';
import { px } from '../../lib/scale';
import { img } from '../../lib/images';
import type { RegionId } from '../../lib/editions';
import cornerVector from '../../assets/testimonials/corner-vector.svg';
import quoteIcon from '../../assets/testimonials/quote-icon.svg';
import patFill from '../../assets/testimonials/pattern-fill.svg';
import patMask from '../../assets/testimonials/pattern-mask.svg';

/*
 * Testimonial card, Figma 62:2398 (Patient Testimonials, first card). Same design as the landing page cards (81:...), which
 * are this card at 185/257.723: `s` scales everything (page = 1). Figma px at s = 1, card-relative:
 *   card 257.723 x 321.805 white, 0.348px #418ea2 stroke, radius 20.896 (-> --radius-card, bug 049) | quote icon 16.717 at 18.11 / 12.54 |
 *   quote Gotham Book 12.538 / 18.11 #00415a at 18.11 / 43.19, w221.502, box 72.441 | name Gotham BOLD 12.538 / 18.11
 *   #00b8ff 6.96 below the quote box (122.59) | pattern box 149.061 x 160.206 at 0 / 161.6 (radius bottom-start 22.29):
 *   masked bar pieces A-D (pattern-mask 188.618 x 164.285 at -6.909 / -10.666) | photo: per story (data) |
 *   corner badge 73.834 at 190.85 / 259.12, mirrored (Figma rotate 180 + flip Y), overhangs the card as in Figma.
 * Text is flow layout (a longer quote pushes the name down); photo, pattern and badge are decoration (absolute).
 * Layer order per story = Figma's (data `layers`). Alt text: the photo shows the person named in the card.
 */
interface Photo { image: string; alt: string; w: number; h: number; x: number; y: number; r?: number; ratio?: number; crop?: { w: string; h: string; left: string; top: string } }
interface Props { name: string; quote: string; photo?: Photo; pattern: string[]; layers: string[]; region: RegionId; s?: number; eager?: boolean }
const { name, quote, photo, pattern, layers, region, s = 1 } = Astro.props;
// Stories without a photo yet (six of the client's twelve, 5 Oct 2026): the card renders without the photo layer (CT12).
const src = photo ? img(photo.image, region) : null;
const INSET: Record<string, string> = {
  A: '4.11% 3.42% -12.46% -20.43%',
  B: '4.11% -186.3% -12.46% 169.29%',
  C: '4.11% -376.02% -12.46% 359.01%',
  D: '4.11% -185.36% -12.46% 168.36%',
};
const logical = (v: string) => { const [t, r, b, l] = v.split(' '); return `inset-block:${t} ${b};inset-inline:${l} ${r}`; };
const z = (k: string) => layers.indexOf(k) + 1;
const pct = (v: string) => parseFloat(v) / 100;
// Rendered photo size (Figma px at s = 1): the crop's share of the box, or the box itself.
const iw = photo ? (photo.crop ? photo.w * pct(photo.crop.w) : photo.w) : 0;
const ih = photo ? (photo.crop ? photo.w * pct(photo.crop.w) / (photo.ratio ?? 1) : photo.h) : 0;
---

<article class="tcard hair-card" style={`--s:${s};--sw:${0.348 * s}`}>
  <div class="pat" aria-hidden="true" style={`z-index:${z('pat')}`}>
    {pattern.map((p) => (
      <div class="pm" style={`${logical(INSET[p])};--m:url(${patMask.src})`}>
        <img src={patFill.src} alt="" width="125" height="125" loading="lazy" decoding="async" />
      </div>
    ))}
  </div>
  <img class="qi" src={quoteIcon.src} width="12" height="12" alt="" loading="lazy" decoding="async" style={`z-index:${z('qi')}`} />
  <div class="txt">
    <p class="quote" style={`z-index:${z('quote')}`}>{quote}</p>
    <p class="name" style={`z-index:${z('name')}`}>{name}</p>
  </div>
  {photo && src && (
    <div class="photo" style={`--w:${photo.w};--h:${photo.h};--x:${photo.x};--y:${photo.y};--r:${photo.r ?? 0};z-index:${z('photo')}`}>
      <Picture src={src} formats={['avif']} fallbackFormat="webp" width={px(iw * s)} height={px(ih * s)} widths={[px(iw * s), px(iw * s) * 2]} sizes={`${px(iw * s)}px`} loading="lazy" decoding="async" alt={photo.alt}
        class:list={[photo.crop ? 'crop' : 'cover']} style={photo.crop ? `width:${photo.crop.w};height:${photo.crop.h};inset-inline-start:${photo.crop.left};top:${photo.crop.top}` : undefined} />
    </div>
  )}
  <img class="badge" src={cornerVector.src} width="53" height="53" alt="" loading="lazy" decoding="async" style={`z-index:${z('badge')}`} />
</article>

<style>
  .tcard { --k: calc(var(--s) * var(--u)); position: relative; isolation: isolate; box-sizing: border-box; width: calc(257.723 * var(--k)); min-height: calc(321.805 * var(--k)); border-radius: var(--radius-card); background: #fff; font-family: var(--font-gotham); font-style: normal; }
  .pat { position: absolute; inset-inline-start: 0; top: calc(161.6 * var(--k)); width: calc(149.061 * var(--k)); height: calc(160.206 * var(--k)); overflow: hidden; border-end-start-radius: var(--radius-card); }
  .pm { position: absolute; -webkit-mask-image: var(--m); mask-image: var(--m); mask-mode: alpha; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: calc(188.618 * var(--k)) calc(164.285 * var(--k)); mask-size: calc(188.618 * var(--k)) calc(164.285 * var(--k)); -webkit-mask-position: calc(-6.909 * var(--k)) calc(-10.666 * var(--k)); mask-position: calc(-6.909 * var(--k)) calc(-10.666 * var(--k)); }
  .pm img { display: block; width: 100%; height: 100%; }
  :global([dir='rtl']) .pm { scale: -1 1; }
  .qi { position: absolute; inset-inline-start: calc(18.11 * var(--k)); top: calc(12.54 * var(--k)); width: calc(16.717 * var(--k)); height: calc(16.717 * var(--k)); }
  .txt { position: relative; padding: calc(43.19 * var(--k)) calc(18.111 * var(--k)) 0; }
  .txt > p { position: relative; margin: 0; width: calc(221.502 * var(--k)); max-width: 100%; font-size: calc(12.538 * var(--k)); line-height: calc(18.11 * var(--k)); overflow-wrap: anywhere; }
  .quote { min-height: calc(72.441 * var(--k)); color: var(--color-navy-alt); font-weight: 400; }
  .name { margin-top: calc(6.959 * var(--k)) !important; color: var(--color-cyan); font-weight: 700; }
  .photo { position: absolute; inset-inline-start: calc(var(--x) * var(--k)); top: calc(var(--y) * var(--k)); width: calc(var(--w) * var(--k)); height: calc(var(--h) * var(--k)); overflow: hidden; border-end-end-radius: calc(min(var(--r), 1) * var(--radius-card)); } /* photo in the card corner: card radius (bug 049) */
  .photo :global(img) { display: block; max-width: none; }
  .photo :global(img.cover) { width: 100%; height: 100%; object-fit: cover; }
  .photo :global(img.crop) { position: absolute; }
  .badge { position: absolute; inset-inline-start: calc(190.85 * var(--k)); top: calc(259.12 * var(--k)); width: calc(73.834 * var(--k)); height: calc(73.834 * var(--k)); transform: scaleX(-1); max-width: none; }
  :global([dir='rtl']) .badge { transform: none; }
</style>
