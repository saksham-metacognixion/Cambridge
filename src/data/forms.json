      "subject": "Refer a Patient",
      "inbox": "refer-patient",
      "fields": [
        { "name": "name", "label": "Name", "type": "text", "required": true, "max": 120 },
        { "name": "email", "label": "E-mail", "type": "email", "required": true, "max": 200 },
        { "name": "message", "label": "Message", "type": "textarea", "required": false, "max": 4000 }
      ]
