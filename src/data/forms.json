        { "name": "information", "label": "Information provided for diagnosis and treatment", "type": "rating", "options": ["very-dissatisfied", "dissatisfied", "neutral", "satisfied", "very-satisfied"], "required": false, "ui": { "group": "matrix" } },
        { "name": "admission", "label": "Efficiency of admission & discharge process", "type": "rating", "options": ["very-dissatisfied", "dissatisfied", "neutral", "satisfied", "very-satisfied"], "required": false, "ui": { "group": "matrix" } },
        { "name": "message", "label": "How we can improve", "type": "textarea", "required": false, "max": 4000, "ui": { "group": "message" } }
