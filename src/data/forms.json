        { "name": "name", "label": "Full name", "type": "text", "required": true, "max": 120 },
        { "name": "email", "label": "E-mail", "type": "email", "required": true, "max": 200 },
        { "name": "hospital", "label": "Hospital", "type": "select", "source": "hospitals", "required": true, "max": 120 },
        { "name": "subject", "label": "Subject", "type": "text", "required": true, "max": 200 },
        { "name": "message", "label": "Message", "type": "textarea", "required": true, "max": 4000 }
