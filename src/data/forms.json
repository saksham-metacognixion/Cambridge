        { "name": "staff", "label": "Staff Friendliness", "type": "rating", "options": ["excellent", "good", "medium", "poor"], "required": false, "ui": { "group": "ratings" } },
        { "name": "wait", "label": "Wait Time", "type": "rating", "options": ["excellent", "good", "medium", "poor"], "required": false, "ui": { "group": "ratings" } },
