        { "name": "message", "label": "Opinion", "type": "textarea", "required": false, "max": 4000, "ui": { "group": "message" } }
      ]
    },
    "feedback": {
      "subject": "Patient Feedback",
      "inbox": "feedback",
      "fields": [
        { "name": "name", "label": "Name", "type": "text", "required": true, "max": 120, "autocomplete": "name", "ui": { "group": "contact" } },
        { "name": "hospital", "label": "Hospital", "type": "select", "source": "hospitals", "required": false, "ui": { "group": "contact" } },
        { "name": "mobile", "label": "Mobile", "type": "tel", "required": true, "max": 20, "autocomplete": "tel-national", "ui": { "group": "contact" } },
        { "name": "email", "label": "Email", "type": "email", "required": false, "max": 200, "autocomplete": "email", "ui": { "group": "contact" } },
