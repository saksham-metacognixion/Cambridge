        { "name": "email", "label": "E-mail", "type": "email", "required": true, "max": 200, "autocomplete": "email", "ui": { "group": "details", "inputAt": 56.8 } },
        { "name": "message", "label": "Message", "type": "textarea", "required": false, "max": 4000, "ui": { "group": "details" } }
