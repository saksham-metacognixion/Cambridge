---
import '../styles/global.css';
import fs from 'node:fs';
import { DESIGN_W, TARGET_W } from '../lib/scale';
import { urlFor, type Edition } from '../lib/editions';
import { absolute, alternates, ogLocale, INDEXABLE } from '../lib/seo';
import CountryPopupLogic from '../components/CountryPopupLogic.astro';

interface Props {
  edition: Edition;
  /** page path inside the edition ("" = home); used for canonical + hreflang */
  path: string;
  title: string;
  description: string;
  ogImage?: string;
}

const { edition, path, title, description, ogImage } = Astro.props;
const canonical = absolute(urlFor(edition, path));
const ogImageUrl = ogImage ? absolute(ogImage) : undefined;

// Preload the main font only when the file has actually been added (avoids a 404 preload while Gotham is pending).
const hasMainFont = fs.existsSync('public/fonts/Gotham-Book.woff2');
---

<!doctype html>
<html lang={edition.lang} dir={edition.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates(path).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(edition)} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    {hasMainFont && <link rel="preload" href="/fonts/Gotham-Book.woff2" as="font" type="font/woff2" crossorigin />}
    <style is:inline set:html={`:root{--design-w:${DESIGN_W};--target-w:${TARGET_W}}`}></style>
    <slot name="head" />
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
    <CountryPopupLogic />
  </body>
</html>
