---
import { editionFromBase, editionPaths } from '../../../lib/editions';
import { content } from '../../../lib/content';
import { PAGE_PATHS } from '../../../lib/paths';
import { INDEXABLE } from '../../../lib/seo';
import { showPendingNote } from '../../../lib/conditions';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/shared/PageHero.astro';
import Standards from '../../../components/accreditations/Standards.astro';
import ContactRecovery from '../../../components/contact/ContactRecovery.astro';

export const getStaticPaths = editionPaths;

const edition = editionFromBase(Astro.params.base);
const c = content('accreditations/page', edition.locale);
const pending = showPendingNote(INDEXABLE) ? c.pendingTab : null;
const shared = content('contact/page', edition.locale).recovery;
const recovery = { ...shared, tiles: c.recovery.tiles };

/*
 * Accreditations & Partnerships template (Figma 55:12215, file LJIRtzU...). Gaps (Figma px):
 * Hero 119-556 -> heading 592: 36 | tabs end 1363 -> "Your recovery matters" 1423: 60 | box ends 1691 -> footer 1732: 41.
 * Hero = shared PageHero: title top 244 - 119 = 125 (w434), text 326 (8 below the 2 title lines, w392), button 367 (right under the 41 text box).
 */
const sections = [
  { id: 'standards', C: Standards, props: { edition, c: c.intro, tabs: c.tabs, pending }, mt: 36 },
  { id: 'recovery', C: ContactRecovery, props: { content: recovery }, mt: 60 },
];
---

<BaseLayout edition={edition} path={PAGE_PATHS.accreditations} title={c.meta.title} description={c.meta.description}>
  <div class="relative" style="z-index:14">
    <Header />
  </div>
  <main>
    <div id="hero" class="relative">
      <!-- Paragraph box 315, not the Figma 392 (text-over-art check, 9 Oct 2026): the client text's two lines ran 54-57px into the art. -->
      <PageHero content={c.hero} pos={{ titleTop: 125, titleW: 434, textGap: 8, textW: 315, textX: 97, buttonGap: 0 }} keepComposition />
    </div>
    {
      sections.map(({ id, C, props, mt }) => (
        <div id={id} class="relative max-lg:mt-10 lg:mt-(--gap)" style={`--gap:calc(${mt} * var(--u))`}>
          <C {...props} />
        </div>
      ))
    }
  </main>
  <div class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(41 * var(--u))">
    <Footer />
  </div>
</BaseLayout>
