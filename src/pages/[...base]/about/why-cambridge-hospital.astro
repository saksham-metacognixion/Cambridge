---
import { editionFromBase, editionPaths } from '../../../lib/editions';
import { content } from '../../../lib/content';
import { PAGE_PATHS, pagePath } from '../../../lib/paths';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/shared/PageHero.astro';
import Specialized from '../../../components/why/Specialized.astro';
import Team from '../../../components/why/Team.astro';
import Features from '../../../components/why/Features.astro';
import Trusted from '../../../components/why/Trusted.astro';
import ContactRecovery from '../../../components/contact/ContactRecovery.astro';

export const getStaticPaths = editionPaths;

const edition = editionFromBase(Astro.params.base);
const c = content('why/page', edition.locale);
// "Your recovery matters" block = the shared Contact one (same text); only the third tile reads "Search Conditions" here.
const shared = content('contact/page', edition.locale).recovery;
const recovery = { ...shared, tiles: c.recovery.tiles };

/*
 * Why Cambridge template (Figma 116:311, file LJIRtzU...). Gaps (Figma px) between blocks:
 * Hero 119-556 -> grey band 559: 3 | band 559-1252 -> navy box (visible part) 1252: 0 | navy ends 1926 -> block 1 card 1994: 68 (in Features) |
 * block 3 ends 2941 -> grey "Trusted" box 2985: 44 | box ends 3728 -> "Your recovery matters" 3790: 62 | box ends 4058 -> footer 4121: 63.
 * Hero = shared PageHero: title top 244 - 119 = 125 (w434), text 326 (8 below the 2 title lines, w392), button 378 (11 below the text).
 * Bugs 071 / 078: the client's title has 4 lines (Figma: 2) and ran into the people (who also drift with the cursor): title 36
 * (Figma 39), 15 higher (top 110), text column 330 (Figma 392) so the paragraph wraps before the photo (R069).
 */
const sections = [
  { id: 'provider', C: Specialized, props: { edition, c: c.specialized }, mt: 3 },
  { id: 'team', C: Team, props: { edition, c: c.team }, mt: 0 },
  { id: 'why', C: Features, props: { edition, c: c.features }, mt: 0 },
  { id: 'trusted', C: Trusted, props: { edition, c: c.trusted }, mt: 44 },
  { id: 'recovery', C: ContactRecovery, props: { content: recovery }, mt: 62 },
];
---

<BaseLayout edition={edition} path={PAGE_PATHS.whyCambridge} title={c.meta.title} description={c.meta.description}>
  <div class="relative" style="z-index:14">
    <Header />
  </div>
  <main>
    <div id="hero" class="relative">
      <PageHero content={c.hero} pos={{ titleSize: 36, titleTop: 110, titleW: 434, textGap: 8, textW: 330, textX: 97, buttonGap: 11 }} />
    </div>
    {
      sections.map(({ id, C, props, mt }) => (
        <div id={id} class="relative max-lg:mt-10 lg:mt-(--gap)" style={`--gap:calc(${mt} * var(--u))`}>
          <C {...props} />
        </div>
      ))
    }
  </main>
  <div class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(63 * var(--u))">
    <Footer />
  </div>
</BaseLayout>
