---
import { editionFromBase, editionPaths } from '../../lib/editions';
import { content } from '../../lib/content';
import { PAGE_PATHS } from '../../lib/paths';
import { careersLink } from '../../lib/careers';
import { INDEXABLE } from '../../lib/seo';
import { showPendingNote } from '../../lib/conditions';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/shared/PageHero.astro';
import Intro from '../../components/careers/Intro.astro';
import Life from '../../components/careers/Life.astro';
import TabsSection from '../../components/careers/TabsSection.astro';
import Talent from '../../components/careers/Talent.astro';
import CtaBand from '../../components/careers/CtaBand.astro';

export const getStaticPaths = editionPaths;

const edition = editionFromBase(Astro.params.base);
const c = content('careers/page', edition.locale);
const join = careersLink(edition, 'joinUrl');
const openRoles = careersLink(edition, 'openRolesUrl');
const apply = careersLink(edition, 'applyUrl');
// "Content pending" in empty tab panels: staging only (PUBLIC_SHOW_PENDING_NOTE=true), never on an indexable build.
const pending = showPendingNote(INDEXABLE) ? c.pendingTab : null;

/*
 * Careers template (Figma 112:7295, file LJIRtzU...). Sections stack with no gaps (page y, Figma px): hero 119-556 (title 260,
 * text 383 at x98, button 420) | Be Part of a Purpose 556-969 | Life at Cambridge 969-1305 | A Multidisciplinary Environment
 * 1305-1835 | National Talent Development 1835-2303 | Start Your Career Journey 2303-2518 | Why Cambridge Hospital? 2518-2970 |
 * footer 2970. Not in the Figma file (flagged in docs/open-decisions.md): job list, filters, detail page, apply form.
 */
---

<BaseLayout edition={edition} path={PAGE_PATHS.careers} title={c.meta.title} description={c.meta.description}>
  <div class="relative" style="z-index:14">
    <Header />
  </div>
  <main>
    <div id="hero" class="relative"><PageHero content={{ ...c.hero, button: { ...c.hero.button, href: join } }} pos={{ titleTop: 141, titleW: 374, textGap: 12, textW: 374, textX: 98, buttonGap: 9 }} /></div>
    <Intro edition={edition} c={c.intro} />
    <div id="life"><Life c={c.life} joinHref={join} openRolesHref={openRoles} /></div>
    <div id="teams">
      <TabsSection edition={edition} id="teams" heading={c.multi.heading} sub={c.multi.sub} tabsLabel={c.multi.tabsLabel} tabs={c.multi.tabs} active={c.multi.active} pending={pending} panelWidth={529} padTop={56} padBottom={51} tabsGap={28} patternTop={42.17} />
    </div>
    <div id="talent"><Talent edition={edition} c={c.talent} /></div>
    <div id="start"><CtaBand c={c.cta} openRolesHref={openRoles} applyHref={apply} /></div>
    <div id="why">
      <TabsSection edition={edition} id="why" heading={c.why.heading} tabsLabel={c.why.tabsLabel} tabs={c.why.tabs} active={c.why.active} pending={pending} panelWidth={441} padTop={52} padBottom={86.83} tabsGap={23.17} patternTop={52} />
    </div>
  </main>
  <Footer />
</BaseLayout>
