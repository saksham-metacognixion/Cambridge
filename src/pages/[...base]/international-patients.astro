---
import { editionFromBase, editionPaths } from '../../lib/editions';
import { content } from '../../lib/content';
import { PAGE_PATHS } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/shared/PageHero.astro';
import CenteredIntro from '../../components/shared/CenteredIntro.astro';
import InternationalForm from '../../components/international/InternationalForm.astro';

export const getStaticPaths = editionPaths;

const edition = editionFromBase(Astro.params.base);
const c = content('international-patients/page', edition.locale);

/*
 * International Patients template (Figma 54:9239, file LJIRtzU...). Gaps (Figma px): hero 119-556 (title 3 lines at 260,
 * text 383 at x98, button 437) | 42 | H2 598 (CenteredIntro wide: box w651 line 33, text w937 12 below, centred 525.5) |
 * text (7 lines) ends 741 | 31 | "Submit Your Inquiry" 772 | ... card ends 1449 | 39 | footer 1488.
 */
---

<BaseLayout edition={edition} path={PAGE_PATHS.internationalPatients} title={c.meta.title} description={c.meta.description}>
  <div class="relative" style="z-index:14">
    <Header />
  </div>
  <main>
    <div id="hero" class="relative"><PageHero content={c.hero} pos={{ titleTop: 141, titleW: 374, textGap: 12, textW: 374, textX: 98, buttonGap: 12 }} /></div>
    <div id="about" class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(42 * var(--u))">
      <CenteredIntro id="intl-heading" heading={c.intro.heading} text={c.intro.text} cx={525.5} tx={525.5} hw={651} tw={937} lh={33} gap={12} alt />
    </div>
    <div id="inquiry" class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(31 * var(--u))"><InternationalForm /></div>
  </main>
  <div class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(39 * var(--u))">
    <Footer />
  </div>
</BaseLayout>
