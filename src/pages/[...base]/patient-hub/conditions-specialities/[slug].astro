---
import { editions, urlFor } from '../../../../lib/editions';
import { content, t } from '../../../../lib/content';
import { conditions, allDetailSlugs, detailSlugs, CONDITION_PATHS, showPendingNote } from '../../../../lib/conditions';
import { INDEXABLE } from '../../../../lib/seo';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PageHero from '../../../../components/shared/PageHero.astro';
import DetailBody from '../../../../components/condition-detail/DetailBody.astro';
import ContactRecovery from '../../../../components/contact/ContactRecovery.astro';
import DoctorsRow from '../../../../components/shared/DoctorsRow.astro';
import { profileDoctors, doctorsForEdition } from '../../../../lib/doctors';

/*
 * Condition / service detail template (Figma 41:2373 Accidents Rehabilitation = reference, 67:3070 Stroke Rehabilitation).
 * One page per slug in every edition. Content: src/data/content/conditions/<slug>.<locale>.json; conditions without that
 * file are generated from their card (title -> hero, summary -> overview, no topics) and carry a staging-only note.
 * Gaps (Figma px): hero 119-441 | 34 | Overview H2 (DetailBody) | 34 | navy band (heading top 50 in the box) | 59 |
 * doctors H2 | ... cards end | 33.54 | footer. Band and doctors row = the Patient Hub components.
 */
export function getStaticPaths() {
  return editions.flatMap((e) => allDetailSlugs.map((slug) => ({ params: { base: e.base || undefined, slug }, props: { edition: e } })));
}

const { edition } = Astro.props;
const { slug } = Astro.params as { slug: string };
const loc = edition.locale;
const shared = content('condition-detail/shared', loc);
const full = detailSlugs.has(slug) ? content(`conditions/${slug}`, loc) : null;
const card = conditions.find((c) => c.slug === slug);
if (!full && !card) throw new Error(`Detail page "${slug}": no content file and no condition card`);

const pending = !full && showPendingNote(INDEXABLE);
const page = full ?? {
  meta: { title: shared.generated.metaTitle.replace('{title}', t(card!.title, loc, 'conditions')), description: t(card!.summary, loc, 'conditions') },
  hero: { ariaLabel: t(card!.title, loc, 'conditions'), banner: shared.generated.banner, title: [t(card!.title, loc, 'conditions')], button: shared.generated.button },
  heroLayout: { titleTop: 99, titleW: 385, buttonGap: 16 },
  overview: [t(card!.summary, loc, 'conditions')],
};
const pendingTab = showPendingNote(INDEXABLE) ? shared.pending.tab : null;
// Doctors linked from this condition on the live site (conditions.json `doctors`, bug 041), this edition's country first;
// the shared Figma sample list only when a condition has none.
const linked = (card?.doctors ?? []).map((s) => profileDoctors.find((d) => d.slug === s)).filter((d) => d !== undefined);
const doctors = { ...shared.doctors, slugs: linked.length ? doctorsForEdition(linked, edition).map((d) => d.slug) : shared.doctors.slugs };
---

<BaseLayout edition={edition} path={CONDITION_PATHS.detail(slug)} title={page.meta.title} description={page.meta.description}>
  <div class="relative" style="z-index:14">
    <Header />
  </div>
  <main>
    <div id="hero" class="relative"><PageHero content={page.hero} pos={page.heroLayout} h={322} variant="cover" /></div>
    {pending && <p class="pending-note" role="note">{shared.pending.note}</p>}
    <div id="overview" class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(34 * var(--u))">
      <DetailBody edition={edition} heading={page.overviewHeading ?? shared.overviewHeading} overview={page.overview} tabs={page.tabs} tabsLabel={shared.tabsLabel} pendingTab={pendingTab} />
    </div>
    <div id="recovery" class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(34 * var(--u))">
      <ContactRecovery content={shared.recovery} headTop={50} />
    </div>
    <div id="doctors" class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(59 * var(--u))">
      <DoctorsRow content={doctors} />
    </div>
  </main>
  <div class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(33.54 * var(--u))">
    <Footer />
  </div>
  <script>
    import '../../../../scripts/tabs';
  </script>
</BaseLayout>

<style>
  /* Staging-only marker (PUBLIC_SHOW_PENDING_NOTE): not part of the design, never rendered in production. */
  .pending-note { margin: calc(8 * var(--u)) auto 0; max-width: calc(937 * var(--u)); padding: calc(6 * var(--u)) calc(10 * var(--u)); border: 1px dashed var(--color-teal-border); border-radius: var(--radius-btn); font: italic 400 calc(11 * var(--u)) / calc(14 * var(--u)) var(--font-gotham); color: var(--color-body); }
</style>
