---
import { editions, editionFromBase, urlFor } from '../../../../lib/editions';
import { content, t } from '../../../../lib/content';
import { profileDoctors, doctorEditions, DOCTOR_PATHS } from '../../../../lib/doctors';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import DoctorProfile from '../../../../components/doctors/DoctorProfile.astro';

/* One static page per doctor on Global and in the doctor's own country (doctorEditions): /find-a-doctor/<slug>, /ae/find-a-doctor/<slug>,
   /ae/ar/..., see DOCTOR_PATHS. A UAE doctor has no /sa page (no UAE / KSA mixing); links from /sa go to the /ae page (doctorHref). */
export function getStaticPaths() {
  return editions.flatMap((e) =>
    profileDoctors.filter((d) => doctorEditions(d).includes(e.id)).map((d) => ({ params: { base: e.base || undefined, slug: d.slug }, props: { doctor: d } })),
  );
}

const { doctor } = Astro.props;
const edition = editionFromBase(Astro.params.base);
const c = content('doctors/page', edition.locale).profile;
const name = t(doctor.name, edition.locale, 'doctors');
const fill = (s: string) => s.replace('{name}', name).replace('{title}', t(doctor.title, edition.locale, 'doctors'));
---

<BaseLayout edition={edition} path={DOCTOR_PATHS.profile(doctor.slug)} title={fill(c.metaTitle)} description={fill(c.metaDescription)}>
  <div class="relative" style="z-index:14">
    <Header />
  </div>
  <main>
    <DoctorProfile doctor={doctor} />
  </main>
  <div class="relative max-lg:mt-10 lg:mt-(--gap)" style="--gap:calc(35 * var(--u))">
    <Footer />
  </div>
</BaseLayout>
